@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/MoonstoneTargets.cmake")
foreach(component IN LISTS Moonstone_FIND_COMPONENTS)
  if(TARGET Moonstone::${component})
    set(Moonstone_${component}_FOUND TRUE)
  else()
    set(Moonstone_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Moonstone)
