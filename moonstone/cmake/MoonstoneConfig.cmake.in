@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@MOONSTONE_BUILD_PLAID@)
  find_dependency(Threads)
endif()
if(@MOONSTONE_BUILD_EXOML@)
  find_dependency(MoonstoneExoML CONFIG)
  if("@MOONSTONE_EXOML_EXTRACT@" STREQUAL "ON")
    find_dependency(MoonstoneExoMLExtract CONFIG)
  endif()
endif()
if(@MOONSTONE_BUILD_EXOTRACT@)
  find_dependency(MoonstoneExotract CONFIG)
endif()
if(@MOONSTONE_BUILD_NEROTYPICAL@)
  include("${CMAKE_CURRENT_LIST_DIR}/../Nerotypical/NerotypicalTargets.cmake")
endif()
if(@moonstone_extras@)
  include("${CMAKE_CURRENT_LIST_DIR}/MoonstoneTargets.cmake")
endif()
foreach(component IN LISTS Moonstone_FIND_COMPONENTS)
  if(TARGET Moonstone::${component})
    set(Moonstone_${component}_FOUND TRUE)
  endif()
endforeach()
check_required_components(Moonstone)
