-- SPARC v8 subset. F3 in sparc-opc.c fixes op/op3/i; register forms also
-- fix reserved ASI bits. Suffix .r/.i is our encoding selector, not GNU syntax.
-- Branch/call disp is a signed byte offset relative to the instruction PC.
local w = require("archweave")
local function f(name, shift, bits, signed, scale)
  return { name=name, shift=shift, bits=bits, signed=signed, scale=scale }
end
local function alu(name, op3, immediate, op)
  return { name=name, match=((op or 2) << 30) | (op3 << 19) | (immediate and 0x2000 or 0),
    mask=immediate and 0xc1f82000 or 0xc1f83fe0,
    operands={ f("rd",25,5), f("rs1",14,5),
      immediate and f("simm13",0,13,true) or f("rs2",0,5) } }
end
return w.arch {
  name="SPARC32", arch="sparc", machine=1, word_bits=32, address_bits=32, endian="big",
  source=".info/binutils/opcodes/sparc-opc.c; include/opcode/sparc.h; bfd/cpu-sparc.c; bfd/archures.c",
  instructions={
    alu("add.r",0,false), alu("add.i",0,true),
    alu("sub.r",4,false), alu("sub.i",4,true),
    alu("or.r",2,false), alu("or.i",2,true),
    alu("ld.i",0,true,3), alu("st.i",4,true,3),
    alu("jmpl.i",0x38,true),
    { name="sethi", match=0x01000000, mask=0xc1c00000,
      operands={ f("rd",25,5), f("imm22",0,22) } },
    { name="call", match=0x40000000, mask=0xc0000000, operands={ f("disp",0,30,true,4) } },
    { name="ba", match=0x10800000, mask=0xffc00000, operands={ f("disp",0,22,true,4) } },
  },
}
