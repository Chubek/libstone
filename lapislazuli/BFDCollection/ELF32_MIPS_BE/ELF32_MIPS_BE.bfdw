-- Structural ELF profile; does not interpret MIPS ABI flags or relocations.
return require("bfdweave").elf {
  name="ELF32_MIPS_BE", target="elf32-bigmips", arch="mips", class=32, endian="big", machine=8,
  source=".info/binutils/bfd/elf32-mips.c; include/elf/common.h (EM_MIPS); include/elf/external.h",
}
