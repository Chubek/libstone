c{ 515
cell closure = vm_pop(); cell argument = vm_pop();
if(vm->vw_error) return;
if(!CAM_vw_is_closure(closure)) { vm_fail(-4); return; }
{
  uintmax_t index = CAM_vw_index(closure);
  cell binding;
  if(index >= vm->clo_top) { vm_fail(-4); return; }
  if(vm->env_mark_top >= 128u) { vm_fail(-3); return; }
  binding = CAM_vw_cons(vm, argument, (cell)vm->clo_env[index]);
  if(vm->vw_error) return;
  vm->env_mark[vm->env_mark_top++] = vm->env;
  vm->env = (int64_t)binding;
  (void)vm_call((cell)vm->clo_code[index]);
}
}c ;
