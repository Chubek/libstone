subsystem "token" c{ 2497
static int PROL_vw_reg(PROL_vm *vm, int64_t r) {
  if(r < 0 || r >= 16) { PROL_vw_fail(vm,-4); return 0; } return 1;
}
static int64_t PROL_vw_term(PROL_vm *vm, uint8_t kind, int64_t a, int64_t b) {
  size_t i;
  if(vm->heap_top >= 1024u) { PROL_vw_fail(vm,-3); return 0; }
  i = vm->heap_top++; vm->kind[i] = kind; vm->a[i] = a; vm->b[i] = b; return (int64_t)i + 1;
}
static int64_t PROL_vw_deref(PROL_vm *vm, int64_t term) {
  size_t steps = 0;
  for(;;) {
    size_t i;
    if(term <= 0 || (uint64_t)term > vm->heap_top) { PROL_vw_fail(vm,-4); return 0; }
    i = (size_t)term - 1u;
    if(vm->kind[i] != 0 || !vm->a[i]) return term;
    if(++steps > 1024u) { PROL_vw_fail(vm,-4); return 0; }
    term = vm->a[i];
  }
}
static void PROL_vw_backtrack(PROL_vm *vm) {
  size_t c, i;
  if(!vm->choice_top) { PROL_vw_fail(vm,-11); return; }
  c = vm->choice_top - 1u;
  while(vm->trail_top > vm->choice_trail[c]) {
    size_t var = vm->trail[--vm->trail_top]; vm->a[var] = 0;
  }
  vm->heap_top = vm->choice_heap[c]; memcpy(vm->x,&vm->choice_x[c * 16u],sizeof(vm->x));
  vm->vw_frame_count = vm->choice_frames[c];
  for(i = 0; i < vm->vw_frame_count; ++i) {
    vm->vw_frames[i].return_address = vm->choice_returns[c * 64u + i];
    vm->vw_frames[i].stack_base = 0;
  }
  PROL_vw_jump(vm,vm->choice_pc[c]);
}
/* Worklist unification; all bindings since the last choice are trailed. */
static void PROL_vw_unify(PROL_vm *vm, int64_t left, int64_t right) {
  int64_t ls[1024], rs[1024]; size_t top = 1, steps = 0;
  ls[0] = left; rs[0] = right;
  while(top && !vm->vw_error) {
    int64_t l, r; size_t li, ri;
    if(++steps > 4096u) { PROL_vw_fail(vm,-4); return; }
    --top; l = PROL_vw_deref(vm,ls[top]); r = PROL_vw_deref(vm,rs[top]);
    if(vm->vw_error) return;
    if(l == r) continue;
    li = (size_t)l - 1u; ri = (size_t)r - 1u;
    if(vm->kind[li] == 0 || vm->kind[ri] == 0) {
      size_t var = vm->kind[li] == 0 ? li : ri;
      int64_t value = vm->kind[li] == 0 ? r : l;
      if(vm->choice_top) {
        if(vm->trail_top >= 2048u) { PROL_vw_fail(vm,-3); return; }
        vm->trail[vm->trail_top++] = var;
      }
      vm->a[var] = value;
    } else if(vm->kind[li] != vm->kind[ri]
      || (vm->kind[li] == 1 && vm->a[li] != vm->a[ri])) {
      PROL_vw_backtrack(vm); return;
    } else if(vm->kind[li] == 2) {
      if(top + 2u > 1024u) { PROL_vw_fail(vm,-3); return; }
      ls[top] = vm->a[li]; rs[top++] = vm->a[ri];
      ls[top] = vm->b[li]; rs[top++] = vm->b[ri];
    }
  }
}

