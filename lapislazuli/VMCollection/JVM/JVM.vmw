-- JVM integer execution profile (JVMS, sections 2.6 and 6).
-- Symbolic VMWeave tape, not class-file bytes. Only category-1 integers,
-- 16 locals per activation, static calls of arity 0/1, no objects or verifier.
-- All i32 operations wrap; division MIN/-1 returns MIN as required by Java.
local v = require("vmweave")
local vm = v.vm {
  name = "JVM", execution = "switch",
  stack = { cell = "int64_t", capacity = 256 }, frame_capacity = 64,
  components = { "token", "opcode", "insncode", "dispatch", "tape", "compile", "frame" },
  fields = { { name = "locals", type = "i64", count = 1040 },
    { name = "depth", type = "u64" }, { name = "out", type = "i64" } },
  subsystems = { token = [[
static int64_t JVM_vw_i32(uint32_t x) {
  return x <= INT32_MAX ? (int64_t)x : -1 - (int64_t)(UINT32_MAX - x);
}
]] },
  instructions = {
    { name = "ICONST", operands = { "cell" }, stack_effect = "( -- i )",
      semantics = "vm_push(JVM_vw_i32((uint32_t)operand0));" },
    { name = "ILOAD", operands = { "cell" }, stack_effect = "( -- i )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm_push(vm->locals[vm->depth * 16u + (size_t)operand0]);]] },
    { name = "ISTORE", operands = { "cell" }, stack_effect = "( i -- )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm->locals[vm->depth * 16u + (size_t)operand0] = JVM_vw_i32((uint32_t)vm_pop());]] },
    { name = "IINC", operands = { "cell", "cell" }, semantics = [[
size_t i;
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
i = vm->depth * 16u + (size_t)operand0;
vm->locals[i] = JVM_vw_i32((uint32_t)vm->locals[i] + (uint32_t)operand1);]] },
    { name = "DUP", stack_effect = "( a -- a a )",
      semantics = "cell a = vm_pop(); vm_push(a); vm_push(a);" },
    { name = "POP", stack_effect = "( a -- )", semantics = "(void)vm_pop();" },
    { name = "SWAP", stack_effect = "( a b -- b a )",
      semantics = "cell b = vm_pop(), a = vm_pop(); vm_push(b); vm_push(a);" },
    { name = "INEG", stack_effect = "( a -- b )",
      semantics = "vm_push(JVM_vw_i32(0u - (uint32_t)vm_pop()));" },
    { name = "IDIV", stack_effect = "( a b -- c )", semantics = [[
int64_t b = JVM_vw_i32((uint32_t)vm_pop()), a = JVM_vw_i32((uint32_t)vm_pop());
if(!b) { vm_fail(-10); return; }
vm_push(JVM_vw_i32((uint32_t)(a / b)));]] },
    { name = "IREM", stack_effect = "( a b -- c )", semantics = [[
int64_t b = JVM_vw_i32((uint32_t)vm_pop()), a = JVM_vw_i32((uint32_t)vm_pop());
if(!b) { vm_fail(-10); return; }
vm_push(a % b);]] },
    { name = "GOTO", operands = { "label" }, flow = "jump", semantics = "vm_jump(operand0);" },
    { name = "IFEQ", operands = { "label" }, flow = "branch", stack_effect = "( i -- )",
      semantics = "if(!vm_pop()) vm_jump(operand0);" },
    { name = "IF_ICMPLT", operands = { "label" }, flow = "branch", stack_effect = "( a b -- )",
      semantics = "cell b = vm_pop(), a = vm_pop(); if(a < b) vm_jump(operand0);" },
    { name = "INVOKESTATIC", operands = { "label" }, flow = "call", semantics = [[
if(vm->depth >= 64u) { vm_fail(-3); return; }
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->locals[vm->depth * 16u], 0, 16u * sizeof(int64_t));]] },
    { name = "INVOKESTATIC1", operands = { "label" }, flow = "call", stack_effect = "( a -- )", semantics = [[
cell a = vm_pop();
if(vm->depth >= 64u) { vm_fail(-3); return; }
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->locals[vm->depth * 16u], 0, 16u * sizeof(int64_t));
vm->locals[vm->depth * 16u] = JVM_vw_i32((uint32_t)a);]] },
    { name = "IRETURN", flow = "return", stack_effect = "( i -- i )", semantics = [[
cell result;
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
result = vm_pop(); --vm->depth; (void)vm_return(); vm_push(result);]] },
    { name = "RETURN", flow = "return", semantics = [[
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
--vm->depth; (void)vm_return();]] },
    { name = "PRINT", stack_effect = "( i -- )", semantics = "vm->out = vm_pop();" },
    { name = "HALT", flow = "halt", semantics = "vm_halt();" },
  },
}
for _, op in ipairs { { "IADD", "+" }, { "ISUB", "-" }, { "IMUL", "*" },
    { "IAND", "&" }, { "IOR", "|" }, { "IXOR", "^" } } do
  vm:instruction(op[1], { stack_effect = "( a b -- c )", semantics =
    "uint32_t b = (uint32_t)vm_pop(), a = (uint32_t)vm_pop(); vm_push(JVM_vw_i32(a " .. op[2] .. " b));" })
end
return vm
