stk-00 1
vm "FUL"
configuration "switch" "int64_t" 256 64 64 "custom" 0
source "VMCollection/FUL/FUL.vmw" 7
component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "binding_top" "u64" 0
field "bindings" "i64" 512
field "closure_code" "i64" 128
field "closure_env" "u64" 128
field "closure_top" "u64" 0
field "env" "u64" 0
field "out" "i64" 0
field "parents" "u64" 512
field "saved_env" "u64" 64
subsystem "token" c{ 297
static int64_t FUL_vw_bits(uint64_t x) {
  return x <= INT64_MAX ? (int64_t)x : -1 - (int64_t)(UINT64_MAX - x);
}
static int64_t FUL_vw_int(uint64_t n) { return FUL_vw_bits((n << 3) | 1u); }
static int64_t FUL_vw_value(int64_t n) {
  return n >= 0 ? n / 8 : -1 - (int64_t)((~(uint64_t)n) >> 3);
}

}c
: "ACCESS" opcode 0 operands 1 "cell" effect "( -- value )" flow "next" source "VMCollection/FUL/FUL.vmw" 7
c{ 198
uint64_t env = vm->env; cell n = operand0;
if(n < 0) { vm_fail(-4); return; }
while(n && env) { env = vm->parents[env - 1u]; --n; }
if(!env) { vm_fail(-4); return; }
vm_push(vm->bindings[env - 1u]);
}c ;
: "ADD" opcode 1 operands 0 effect "( a b -- c )" flow "next" source "VMCollection/FUL/FUL.vmw" 76
c{ 190
cell b = vm_pop(), a = vm_pop();
if(((uint64_t)a & 7u) != 1u || ((uint64_t)b & 7u) != 1u) { vm_fail(-4); return; }
vm_push(FUL_vw_int((uint64_t)FUL_vw_value(a) + (uint64_t)FUL_vw_value(b)));
}c ;
: "APPLY" opcode 2 operands 0 effect "( closure arg -- )" flow "call" source "VMCollection/FUL/FUL.vmw" 7
c{ 462
cell arg = vm_pop(), closure = vm_pop(); uint64_t i = (uint64_t)closure >> 3; size_t b, depth;
if(((uint64_t)closure & 7u) != 3u || i >= vm->closure_top) { vm_fail(-4); return; }
if(vm->binding_top >= 512u || vm->vw_frame_count >= 64u) { vm_fail(-3); return; }
depth = vm->vw_frame_count; if(vm_call(vm->closure_code[i])) return;
vm->saved_env[depth] = vm->env;
b = vm->binding_top++; vm->bindings[b] = arg; vm->parents[b] = vm->closure_env[i]; vm->env = b + 1u;
}c ;
: "BIND" opcode 3 operands 0 effect "( value -- )" flow "next" source "VMCollection/FUL/FUL.vmw" 7
c{ 157
size_t i;
if(vm->binding_top >= 512u) { vm_fail(-3); return; }
i = vm->binding_top++; vm->bindings[i] = vm_pop(); vm->parents[i] = vm->env; vm->env = i + 1u;
}c ;
: "CLOSURE" opcode 4 operands 1 "label" effect "( -- closure )" flow "next" source "VMCollection/FUL/FUL.vmw" 7
c{ 179
size_t i;
if(vm->closure_top >= 128u) { vm_fail(-3); return; }
i = vm->closure_top++; vm->closure_code[i] = operand0; vm->closure_env[i] = vm->env;
vm_push((cell)((i << 3) | 3u));
}c ;
