saved_ep = (uint64_t)vm->vw_stack[frame + 2u];
vm->vw_stack[frame] = result;
vm->vw_sp = (size_t)(frame + 1u);
vm->fp = saved_fp;
vm->ep = saved_ep;
(void)vm_return();
}c ;
