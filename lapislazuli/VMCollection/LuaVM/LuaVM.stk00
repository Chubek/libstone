: "NEWTABLE" opcode 14 operands 1 "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 158
if(!LuaVM_vw_reg(vm,operand0)) return;
if(vm->table_top >= 64u) { vm_fail(-3); return; }
vm->regs[vm->depth * 16u + (size_t)operand0] = (cell)++vm->table_top;
}c ;
: "PRINT" opcode 15 operands 1 "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 94
if(!LuaVM_vw_reg(vm,operand0)) return;
vm->out = vm->regs[vm->depth * 16u + (size_t)operand0];
