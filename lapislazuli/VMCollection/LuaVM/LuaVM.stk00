: "BXOR" opcode 3 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 90
c{ 305
uint64_t a, b;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1) || !LuaVM_vw_reg(vm,operand2)) return;
a = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand1]; b = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand2];
vm->regs[vm->depth * 16u + (size_t)operand0] = LuaVM_vw_integer(a ^ b);
}c ;
: "CALL1" opcode 4 operands 3 "cell" "cell" "cell" effect "( -- )" flow "call" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 430
cell target, a;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1) || !LuaVM_vw_reg(vm,operand2)) return;
if(vm->depth >= 64u) { vm_fail(-3); return; }
target = vm->regs[vm->depth * 16u + (size_t)operand1]; a = vm->regs[vm->depth * 16u + (size_t)operand2];
if(vm_call(target)) return;
vm->dest[vm->depth++] = (uint64_t)operand0;
memset(&vm->regs[vm->depth * 16u], 0, 16u * sizeof(int64_t)); vm->regs[vm->depth * 16u] = a;
}c ;
: "EQ" opcode 5 operands 3 "cell" "cell" "label" effect "( -- )" flow "branch" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 184
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1)) return;
if(vm->regs[vm->depth * 16u + (size_t)operand0] == vm->regs[vm->depth * 16u + (size_t)operand1]) vm_jump(operand2);
}c ;
: "GETTABLE" opcode 6 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 469
cell table; size_t index;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1)) return;
table = vm->regs[vm->depth * 16u + (size_t)operand1];
if(table <= 0 || (uint64_t)table > vm->table_top || operand2 < 0 || operand2 >= 16) { vm_fail(-4); return; }
index = ((size_t)table - 1u) * 16u + (size_t)operand2;
if(!vm->present[index]) { vm_fail(-4); return; } /* nil is outside this integer profile */
vm->regs[vm->depth * 16u + (size_t)operand0] = vm->tables[index];
}c ;
: "HALT" opcode 7 operands 0 effect "( -- )" flow "halt" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 10
vm_halt();
}c ;
: "IDIV" opcode 8 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 416
cell a, b, q, r;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1) || !LuaVM_vw_reg(vm,operand2)) return;
a = vm->regs[vm->depth * 16u + (size_t)operand1]; b = vm->regs[vm->depth * 16u + (size_t)operand2];
if(!b) { vm_fail(-10); return; }
if(b == -1) q = LuaVM_vw_integer(0u - (uint64_t)a);
else { q = a / b; r = a % b; if(r && ((r < 0) != (b < 0))) --q; }
vm->regs[vm->depth * 16u + (size_t)operand0] = q;
}c ;
: "JMP" opcode 9 operands 1 "label" effect "( -- )" flow "jump" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 18
vm_jump(operand0);
}c ;
