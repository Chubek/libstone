: "RETURN1" opcode 16 operands 1 "cell" effect "( -- )" flow "return" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 285
cell result; size_t dest;
if(!LuaVM_vw_reg(vm,operand0)) return;
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
result = vm->regs[vm->depth * 16u + (size_t)operand0];
--vm->depth; (void)vm_return(); dest = vm->depth * 16u + vm->dest[vm->depth]; vm->regs[dest] = result;
}c ;
: "SETTABLE" opcode 17 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 6
c{ 402
cell table; size_t index;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand2)) return;
table = vm->regs[vm->depth * 16u + (size_t)operand0];
if(table <= 0 || (uint64_t)table > vm->table_top || operand1 < 0 || operand1 >= 16) { vm_fail(-4); return; }
index = ((size_t)table - 1u) * 16u + (size_t)operand1;
vm->tables[index] = vm->regs[vm->depth * 16u + (size_t)operand2]; vm->present[index] = 1;
}c ;
