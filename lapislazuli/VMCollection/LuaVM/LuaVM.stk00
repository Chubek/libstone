stk-00 1
vm "LuaVM"
configuration "switch" "int64_t" 16 64 64 "custom" 0
source "VMCollection/LuaVM/LuaVM.vmw" 6
component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "depth" "u64" 0
field "dest" "u64" 64
field "out" "i64" 0
field "present" "u8" 1024
field "regs" "i64" 1040
field "table_top" "u64" 0
field "tables" "i64" 1024
subsystem "token" c{ 244
static int64_t LuaVM_vw_integer(uint64_t x) {
  return x <= INT64_MAX ? (int64_t)x : -1 - (int64_t)(UINT64_MAX - x);
}
static int LuaVM_vw_reg(LuaVM_vm *vm, LuaVM_cell r) {
  if(r < 0 || r >= 16) { LuaVM_vw_fail(vm,-4); return 0; } return 1;
}

}c
: "ADD" opcode 0 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 90
c{ 305
uint64_t a, b;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1) || !LuaVM_vw_reg(vm,operand2)) return;
a = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand1]; b = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand2];
vm->regs[vm->depth * 16u + (size_t)operand0] = LuaVM_vw_integer(a + b);
}c ;
: "BAND" opcode 1 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 90
c{ 305
uint64_t a, b;
if(!LuaVM_vw_reg(vm,operand0) || !LuaVM_vw_reg(vm,operand1) || !LuaVM_vw_reg(vm,operand2)) return;
a = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand1]; b = (uint64_t)vm->regs[vm->depth * 16u + (size_t)operand2];
vm->regs[vm->depth * 16u + (size_t)operand0] = LuaVM_vw_integer(a & b);
}c ;
: "BOR" opcode 2 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/LuaVM/LuaVM.vmw" 90
c{ 305
uint64_t a, b;
