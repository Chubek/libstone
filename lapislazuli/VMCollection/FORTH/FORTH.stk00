stk-00 1
vm "FORTH"
configuration "switch" "intptr_t" 256 128 64 "custom" 0
source "=[C]" 0
component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "out" "i64" 0
field "rsp" "u64" 0
field "rstack" "i64" 128
field "vars" "i64" 64
: "ADD" opcode 0 operands 0 effect "( a b -- c )" flow "next" source "=[C]" 0
c{ 61
cell b = vm_pop(); cell a = vm_pop(); vm_push((cell)(a + b));
}c ;
: "AND" opcode 1 operands 0 effect "( a b -- c )" flow "next" source "=[C]" 0
c{ 61
