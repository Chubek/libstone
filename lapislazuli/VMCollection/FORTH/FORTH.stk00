if(!b || (a == INTPTR_MIN && b == -1)) { vm_fail(-10); return; }
vm_push((cell)(a / b));
}c ;
: "DO" opcode 6 operands 0 effect "( limit start -- )" flow "next" source "=[C]" 0
c{ 184
if(vm->rsp + 2u > 128u) { vm_fail(-3); return; }
{
  cell start = vm_pop(); cell limit = vm_pop();
  vm->rstack[vm->rsp++] = (int64_t)limit;
  vm->rstack[vm->rsp++] = (int64_t)start;
}
}c ;
: "DROP" opcode 7 operands 0 effect "( a -- )" flow "next" source "=[C]" 0
c{ 15
(void)vm_pop();
}c ;
: "DUP" opcode 8 operands 0 effect "( a -- a a )" flow "next" source "=[C]" 0
c{ 42
