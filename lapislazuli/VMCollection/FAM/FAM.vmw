-- FAM: Cardelli's Functional Abstract Machine, the machine underneath the
-- ZINC compiler.
--
-- Reference: Luca Cardelli, "Compiling a Functional Language", ACM Symposium
-- on LISP and Functional Programming, 1984, 208-217; also Simon L. Peyton
-- Jones, "The Implementation of Functional Programming Languages"
-- (Prentice-Hall, 1987), chapter 12, where it is called the ZINC abstract
-- machine.
--
-- The five registers of the machine map onto generated state:
--
--   P  the program pointer -- the instruction tape (vw_pc)
--   A  the accumulator     -- `acc`
--   E  the environment     -- `env`, a flat block of fields, `env_top`
--   S  the argument stack  -- the generated value stack
--   R  the return stack    -- the frame component, with `mark` holding the
--                             environment heights the frames must restore
--
-- The machine's one distinctive device is used here exactly as Cardelli
-- defines it: a *block* is a code pointer paired with some number of fields,
-- and the same block represents a closure (fields captured from the enclosing
-- environment) and a data structure (fields written by the program).  `CLOSURE`
-- builds a block by copying the newest fields of E, `GETFIELD` / `SETFIELD`
-- read and write them, and applying a block copies its fields in front of the
-- arguments, so E is rebuilt from the block on every entry.
--
-- Values on S are tagged, because one word must carry either an integer or a
-- block reference:
--
--   tag 1   small integer; the payload is the cell shifted right by three bits
--   tag 2   block; the payload is an index into the block tables
--
-- Three deviations from the 1984 description are stated rather than hidden:
--
--   * Application names its arity: `APPLY1`..`APPLY3` are the non-tail
--     applies and `APPTERM1`..`APPTERM3` the tail applies, where `APPTERM n`
--     with an explicit n is precisely the machine's own instruction.  The
--     arity is still checked against the closure's field count at run time.
--   * `Prim p` is replaced by named primitives (`ADD`..`GE`), because the
--     generated dispatcher checks a static stack effect and one `PRIM` word
--     cannot carry the effect of every p.
--   * `BRANCHIF` tests the value popped from S, not the accumulator, so that
--     the branch and the test it follows are separate static effects.
--
-- A `GETFIELD` beyond a block's field count, a mistyped value, or an
-- environment that would overwrite the block tables fails the machine with -4
-- instead of reading whatever the previous word left behind.
local v = require("vmweave")
return v.vm {
  name = "FAM",
  execution = "switch",
  stack = { cell = "intptr_t", capacity = 512 },
  frame_capacity = 128,
  components = { "token", "opcode", "insncode", "dispatch", "tape", "compile", "frame" },
  subsystems = {
    token = [[
#define FAM_vw_tag(x) ((uintptr_t)(x) & (uintptr_t)7u)
#define FAM_vw_int(n) ((FAM_cell)(((uintptr_t)(intptr_t)(n) << 3) | (uintptr_t)1u))
#define FAM_vw_block(i) ((FAM_cell)(((uintptr_t)(i) << 3) | (uintptr_t)2u))
#define FAM_vw_is_int(x) (FAM_vw_tag(x) == (uintptr_t)1u)
#define FAM_vw_is_block(x) (FAM_vw_tag(x) == (uintptr_t)2u)
#define FAM_vw_value(x) ((FAM_cell)(intptr_t)((uintptr_t)(x) >> 3))
#define FAM_vw_index(x) ((uintmax_t)((uintptr_t)(x) >> 3))
]],
  },
  fields = {
    { name = "acc", type = "i64" },
    { name = "env", type = "i64", count = 256 },
    { name = "env_top", type = "u64" },
    { name = "mark", type = "u64", count = 128 },
    { name = "mark_top", type = "u64" },
    { name = "blk_code", type = "u64", count = 64 },
    { name = "blk_size", type = "u64", count = 64 },
    { name = "blk_fields", type = "i64", count = 512 },
    { name = "blk_top", type = "u64" },
    { name = "out", type = "i64" },
  },
  instructions = {
    { name = "INT", operands = { "cell" }, stack_effect = "( -- n )",
      semantics = "vm_push(FAM_vw_int(operand0));" },
    { name = "PUSHACC", stack_effect = "( -- v )",
      semantics = "vm_push((cell)vm->acc);" },
    { name = "POPACC", stack_effect = "( v -- )",
      semantics = "vm->acc = (int64_t)vm_pop();" },
    { name = "ACCESS", operands = { "cell" }, stack_effect = "( -- v )", semantics = [[
if(operand0 < 0 || (uintmax_t)operand0 >= vm->env_top) { vm_fail(-4); return; }
vm_push((cell)vm->env[vm->env_top - 1u - (uintmax_t)operand0]);]] },
    { name = "ALLOC", operands = { "cell" }, stack_effect = "( -- )", semantics = [[
uintmax_t index;
if(operand0 < 0 || vm->env_top + (uintmax_t)operand0 > 256u) { vm_fail(-3); return; }
for(index = 0u; index < (uintmax_t)operand0; ++index) vm->env[vm->env_top++] = 0;]] },
    { name = "CLOSURE", operands = { "label", "cell" }, stack_effect = "( -- block )", semantics = [[
uintmax_t index, field;
if(operand1 < 0 || (uintmax_t)operand1 > 8u) { vm_fail(-4); return; }
if((uintmax_t)operand1 > vm->env_top) { vm_fail(-4); return; }
if(vm->blk_top >= 64u) { vm_fail(-3); return; }
index = vm->blk_top++;
vm->blk_code[index] = (uint64_t)operand0;
vm->blk_size[index] = (uint64_t)operand1;
for(field = 0u; field < (uintmax_t)operand1; ++field)
  vm->blk_fields[index * 8u + field] = vm->env[vm->env_top - (uintmax_t)operand1 + field];
vm_push(FAM_vw_block(index));]] },
    { name = "GETFIELD", operands = { "cell" }, stack_effect = "( block -- v )", semantics = [[
cell value = vm_pop(); uintmax_t index;
if(vm->vw_error) return;
if(!FAM_vw_is_block(value)) { vm_fail(-4); return; }
index = FAM_vw_index(value);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(operand0 < 0 || (uintmax_t)operand0 >= vm->blk_size[index]) { vm_fail(-4); return; }
vm_push((cell)vm->blk_fields[index * 8u + (uintmax_t)operand0]);]] },
    { name = "SETFIELD", operands = { "cell" }, stack_effect = "( v block -- )", semantics = [[
cell value = vm_pop(); cell block = vm_pop(); uintmax_t index;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(operand0 < 0 || (uintmax_t)operand0 >= vm->blk_size[index]) { vm_fail(-4); return; }
vm->blk_fields[index * 8u + (uintmax_t)operand0] = (int64_t)value;]] },
    { name = "BRANCH", operands = { "label" }, flow = "jump", stack_effect = "( -- )",
      semantics = "vm_jump(operand0);" },
    { name = "BRANCHIF", operands = { "label" }, flow = "branch", stack_effect = "( flag -- )", semantics = [[
cell flag = vm_pop();
if(vm->vw_error) return;
if(flag) vm_jump(operand0);]] },
    { name = "APPLY1", operands = { "label" }, flow = "call", stack_effect = "( a block -- )", semantics = [[
cell block = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] + 1u > 8u || vm->mark_top >= 128u) { vm_fail(-3); return; }
if(vm->blk_size[index] + 1u > 256u) { vm_fail(-3); return; }
vm->mark[vm->mark_top++] = vm->env_top;
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
(void)vm_call((cell)vm->blk_code[index]);]] },
    { name = "APPLY2", operands = { "label" }, flow = "call", stack_effect = "( a b block -- )", semantics = [[
cell block = vm_pop(); cell a1 = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] > 6u || vm->mark_top >= 128u) { vm_fail(-3); return; }
if(vm->blk_size[index] + 2u > 256u) { vm_fail(-3); return; }
vm->mark[vm->mark_top++] = vm->env_top;
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
vm->env[vm->env_top++] = (int64_t)a1;
(void)vm_call((cell)vm->blk_code[index]);]] },
    { name = "APPLY3", operands = { "label" }, flow = "call", stack_effect = "( a b c block -- )", semantics = [[
cell block = vm_pop(); cell a2 = vm_pop(); cell a1 = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] > 5u || vm->mark_top >= 128u) { vm_fail(-3); return; }
if(vm->blk_size[index] + 3u > 256u) { vm_fail(-3); return; }
vm->mark[vm->mark_top++] = vm->env_top;
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
vm->env[vm->env_top++] = (int64_t)a1;
vm->env[vm->env_top++] = (int64_t)a2;
(void)vm_call((cell)vm->blk_code[index]);]] },
    { name = "APPTERM1", operands = { "label" }, flow = "jump", stack_effect = "( a block -- )", semantics = [[
cell block = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] + 1u > 8u) { vm_fail(-3); return; }
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
vm_jump((cell)vm->blk_code[index]);]] },
    { name = "APPTERM2", operands = { "label" }, flow = "jump", stack_effect = "( a b block -- )", semantics = [[
cell block = vm_pop(); cell a1 = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] > 6u) { vm_fail(-3); return; }
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
vm->env[vm->env_top++] = (int64_t)a1;
vm_jump((cell)vm->blk_code[index]);]] },
    { name = "APPTERM3", operands = { "label" }, flow = "jump", stack_effect = "( a b c block -- )", semantics = [[
cell block = vm_pop(); cell a2 = vm_pop(); cell a1 = vm_pop(); cell a0 = vm_pop(); uintmax_t index, field;
if(vm->vw_error) return;
if(!FAM_vw_is_block(block)) { vm_fail(-4); return; }
index = FAM_vw_index(block);
if(index >= vm->blk_top) { vm_fail(-4); return; }
if(vm->blk_size[index] > 5u) { vm_fail(-3); return; }
vm->env_top = 0u;
for(field = 0u; field < vm->blk_size[index]; ++field)
  vm->env[vm->env_top++] = vm->blk_fields[index * 8u + field];
vm->env[vm->env_top++] = (int64_t)a0;
vm->env[vm->env_top++] = (int64_t)a1;
vm->env[vm->env_top++] = (int64_t)a2;
vm_jump((cell)vm->blk_code[index]);]] },
    { name = "RETURN", flow = "return", stack_effect = "( v -- v )", semantics = [[
cell result;
if(!vm->vw_frame_count) { vm_fail(-2); return; }
result = vm_pop();
if(vm->vw_error) return;
vm->vw_sp = vm->vw_frames[vm->vw_frame_count - 1u].stack_base;
vm_push(result);
vm->acc = (int64_t)result;
if(vm->mark_top) vm->env_top = vm->mark[--vm->mark_top];
(void)vm_return();]] },
    { name = "ADD", stack_effect = "( a b -- c )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) + FAM_vw_value(pb)));]] },
    { name = "SUB", stack_effect = "( a b -- c )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) - FAM_vw_value(pb)));]] },
    { name = "MUL", stack_effect = "( a b -- c )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) * FAM_vw_value(pb)));]] },
    { name = "DIV", stack_effect = "( a b -- c )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
if(!FAM_vw_value(pb)) { vm_fail(-10); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) / FAM_vw_value(pb)));]] },
    { name = "NEG", stack_effect = "( a -- b )", semantics = [[
cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(-FAM_vw_value(pa)));]] },
    { name = "EQ", stack_effect = "( a b -- flag )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) == FAM_vw_value(pb) ? 1 : 0));]] },
    { name = "LT", stack_effect = "( a b -- flag )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) < FAM_vw_value(pb) ? 1 : 0));]] },
    { name = "LE", stack_effect = "( a b -- flag )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) <= FAM_vw_value(pb) ? 1 : 0));]] },
    { name = "GT", stack_effect = "( a b -- flag )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) > FAM_vw_value(pb) ? 1 : 0));]] },
    { name = "GE", stack_effect = "( a b -- flag )", semantics = [[
cell pb = vm_pop(); cell pa = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(pa) || !FAM_vw_is_int(pb)) { vm_fail(-4); return; }
vm_push(FAM_vw_int(FAM_vw_value(pa) >= FAM_vw_value(pb) ? 1 : 0));]] },
    { name = "PRINT", stack_effect = "( v -- )", semantics = [[
cell value = vm_pop();
if(vm->vw_error) return;
if(!FAM_vw_is_int(value)) { vm_fail(-4); return; }
vm->out = (int64_t)FAM_vw_value(value);]] },
    { name = "STOP", flow = "halt", stack_effect = "( -- )",
      semantics = "vm_halt();" },
  },
}
