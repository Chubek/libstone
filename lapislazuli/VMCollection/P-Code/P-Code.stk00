component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "lbase" "u64" 0
field "locals" "i64" 512
field "ltop" "u64" 0
field "mark" "u64" 64
field "mark_top" "u64" 0
field "out" "i64" 0
: "ABSI" opcode 0 operands 0 effect "( a -- b )" flow "next" source "=[C]" 0
c{ 54
cell a = vm_pop(); vm_push(a < 0 ? (cell)(0 - a) : a);
}c ;
