}c ;
: "RETV" opcode 23 operands 0 effect "( v -- )" flow "return" source "=[C]" 0
c{ 285
cell result;
if(!vm->vw_frame_count) { vm_fail(-2); return; }
result = vm_pop();
if(vm->vw_error) return;
vm->vw_sp = vm->vw_frames[vm->vw_frame_count - 1u].stack_base;
vm_push(result);
if(vm->mark_top) { vm->ltop = vm->lbase; vm->lbase = vm->mark[--vm->mark_top]; }
(void)vm_return();
}c ;
