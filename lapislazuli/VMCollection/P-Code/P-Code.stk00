}c ;
: "CALL" opcode 2 operands 1 "label" effect "( -- )" flow "call" source "=[C]" 0
c{ 175
if(vm->mark_top >= 64u || vm->ltop + 16u > 512u) { vm_fail(-3); return; }
vm->mark[vm->mark_top++] = vm->lbase;
vm->lbase = vm->ltop; vm->ltop += 16u;
(void)vm_call(operand0);
}c ;
