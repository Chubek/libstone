static int64_t SOM_vw_bits(uint64_t x) {
  return x <= INT64_MAX ? (int64_t)x : -1 - (int64_t)(UINT64_MAX - x);
}
static int64_t SOM_vw_int(uint64_t n) { return SOM_vw_bits((n << 3) | 1u); }
static int64_t SOM_vw_value(int64_t n) {
  return n >= 0 ? n / 8 : -1 - (int64_t)((~(uint64_t)n) >> 3);
}
static int SOM_vw_object(SOM_vm *vm, int64_t ref) {
  uint64_t index = (uint64_t)ref >> 3;
  if(((uint64_t)ref & 7u) != 2u || index >= vm->object_top) { SOM_vw_fail(vm,-4); return 0; }
  return 1;
}

