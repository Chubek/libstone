: "MUL" opcode 9 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/BEAM/BEAM.vmw" 85
c{ 342
cell a, b;
if(!BEAM_vw_reg(vm,operand0) || !BEAM_vw_reg(vm,operand1) || !BEAM_vw_reg(vm,operand2)) return;
a = vm->x[(size_t)operand1]; b = vm->x[(size_t)operand2];
