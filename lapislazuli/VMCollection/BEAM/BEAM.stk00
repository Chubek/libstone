: "SUB" opcode 17 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/BEAM/BEAM.vmw" 85
c{ 342
cell a, b;
if(!BEAM_vw_reg(vm,operand0) || !BEAM_vw_reg(vm,operand1) || !BEAM_vw_reg(vm,operand2)) return;
a = vm->x[(size_t)operand1]; b = vm->x[(size_t)operand2];
if(((uint64_t)a & 7u) != 1u || ((uint64_t)b & 7u) != 1u) { vm_fail(-4); return; }
vm->x[(size_t)operand0] = BEAM_vw_int((uint64_t)BEAM_vw_value(a) - (uint64_t)BEAM_vw_value(b));
}c ;
