if(vm->x[(size_t)operand0] != vm->x[(size_t)operand1]) vm_jump(operand2);
}c ;
: "JUMP" opcode 5 operands 1 "label" effect "( -- )" flow "jump" source "VMCollection/BEAM/BEAM.vmw" 6
