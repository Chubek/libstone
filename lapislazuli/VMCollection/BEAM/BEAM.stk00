: "PUT_LIST" opcode 11 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/BEAM/BEAM.vmw" 6
c{ 367
size_t index; cell head, tail;
if(!BEAM_vw_reg(vm,operand0) || !BEAM_vw_reg(vm,operand1) || !BEAM_vw_reg(vm,operand2)) return;
if(vm->heap_top >= 512u) { vm_fail(-3); return; }
head = vm->x[(size_t)operand1]; tail = vm->x[(size_t)operand2]; index = vm->heap_top++;
vm->heads[index] = head; vm->tails[index] = tail;
vm->x[(size_t)operand0] = (cell)((index << 3) | 2u);
}c ;
