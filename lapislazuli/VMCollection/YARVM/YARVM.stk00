stk-00 1
vm "YARVM"
configuration "switch" "int64_t" 256 64 64 "custom" 0
source "VMCollection/YARVM/YARVM.vmw" 6
component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "array_top" "u64" 0
field "arrays" "i64" 128
field "depth" "u64" 0
field "locals" "i64" 1040
field "out" "i64" 0
field "self" "i64" 65
subsystem "token" c{ 305
static int64_t YARVM_vw_bits(uint64_t x) {
  return x <= INT64_MAX ? (int64_t)x : -1 - (int64_t)(UINT64_MAX - x);
}
static int64_t YARVM_vw_int(uint64_t n) { return YARVM_vw_bits((n << 3) | 1u); }
static int64_t YARVM_vw_value(int64_t n) {
  return n >= 0 ? n / 8 : -1 - (int64_t)((~(uint64_t)n) >> 3);
}

}c
