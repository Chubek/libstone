-- ART/Dalvik dex integer-register profile (Android dex bytecode reference).
-- Symbolic tape, not a dex loader: 16 v-registers per activation, static calls
-- of arity 0/1, a separate result register. No Java objects, wide values or GC.
local v = require("vmweave")
local vm = v.vm {
  name = "ART", execution = "switch", stack = { cell = "int64_t", capacity = 16 },
  frame_capacity = 64,
  components = { "token", "opcode", "insncode", "dispatch", "tape", "compile", "frame" },
  fields = { { name = "regs", type = "i64", count = 1040 },
    { name = "depth", type = "u64" }, { name = "result", type = "i64" },
    { name = "out", type = "i64" } },
  subsystems = { token = [[
static int64_t ART_vw_i32(uint32_t x) {
  return x <= INT32_MAX ? (int64_t)x : -1 - (int64_t)(UINT32_MAX - x);
}
static int ART_vw_reg(ART_vm *vm, ART_cell r) {
  if(r < 0 || r >= 16) { ART_vw_fail(vm,-4); return 0; }
  return 1;
}
]] },
  instructions = {
    { name = "CONST", operands = { "cell", "cell" }, semantics = [[
if(!ART_vw_reg(vm,operand0)) return;
vm->regs[vm->depth * 16u + (size_t)operand0] = ART_vw_i32((uint32_t)operand1);]] },
    { name = "MOVE", operands = { "cell", "cell" }, semantics = [[
if(!ART_vw_reg(vm,operand0) || !ART_vw_reg(vm,operand1)) return;
vm->regs[vm->depth * 16u + (size_t)operand0] = vm->regs[vm->depth * 16u + (size_t)operand1];]] },
    { name = "DIV_INT", operands = { "cell", "cell", "cell" }, semantics = [[
cell a, b;
if(!ART_vw_reg(vm,operand0) || !ART_vw_reg(vm,operand1) || !ART_vw_reg(vm,operand2)) return;
a = vm->regs[vm->depth * 16u + (size_t)operand1]; b = vm->regs[vm->depth * 16u + (size_t)operand2];
if(!b) { vm_fail(-10); return; }
vm->regs[vm->depth * 16u + (size_t)operand0] = ART_vw_i32((uint32_t)(a / b));]] },
    { name = "GOTO", operands = { "label" }, flow = "jump", semantics = "vm_jump(operand0);" },
    { name = "IF_EQZ", operands = { "cell", "label" }, flow = "branch", semantics = [[
if(!ART_vw_reg(vm,operand0)) return;
if(!vm->regs[vm->depth * 16u + (size_t)operand0]) vm_jump(operand1);]] },
    { name = "IF_LT", operands = { "cell", "cell", "label" }, flow = "branch", semantics = [[
if(!ART_vw_reg(vm,operand0) || !ART_vw_reg(vm,operand1)) return;
if(vm->regs[vm->depth * 16u + (size_t)operand0] < vm->regs[vm->depth * 16u + (size_t)operand1]) vm_jump(operand2);]] },
    { name = "INVOKE_STATIC0", operands = { "label" }, flow = "call", semantics = [[
if(vm->depth >= 64u) { vm_fail(-3); return; }
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->regs[vm->depth * 16u], 0, 16u * sizeof(int64_t));]] },
    { name = "INVOKE_STATIC1", operands = { "label", "cell" }, flow = "call", semantics = [[
cell a;
if(!ART_vw_reg(vm,operand1)) return;
if(vm->depth >= 64u) { vm_fail(-3); return; }
a = vm->regs[vm->depth * 16u + (size_t)operand1];
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->regs[vm->depth * 16u], 0, 16u * sizeof(int64_t));
vm->regs[vm->depth * 16u] = a;]] },
    { name = "MOVE_RESULT", operands = { "cell" }, semantics = [[
if(!ART_vw_reg(vm,operand0)) return;
vm->regs[vm->depth * 16u + (size_t)operand0] = vm->result;]] },
    { name = "RETURN", operands = { "cell" }, flow = "return", semantics = [[
if(!ART_vw_reg(vm,operand0)) return;
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
vm->result = vm->regs[vm->depth * 16u + (size_t)operand0];
--vm->depth; (void)vm_return();]] },
    { name = "RETURN_VOID", flow = "return", semantics = [[
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
--vm->depth; (void)vm_return();]] },
    { name = "PRINT", operands = { "cell" }, semantics = [[
if(!ART_vw_reg(vm,operand0)) return;
vm->out = vm->regs[vm->depth * 16u + (size_t)operand0];]] },
    { name = "HALT", flow = "halt", semantics = "vm_halt();" },
  },
}
for _, op in ipairs { { "ADD_INT", "+" }, { "SUB_INT", "-" }, { "MUL_INT", "*" },
    { "AND_INT", "&" }, { "OR_INT", "|" }, { "XOR_INT", "^" } } do
  vm:instruction(op[1], { operands = { "cell", "cell", "cell" }, semantics = [[
uint32_t a, b;
if(!ART_vw_reg(vm,operand0) || !ART_vw_reg(vm,operand1) || !ART_vw_reg(vm,operand2)) return;
a = (uint32_t)vm->regs[vm->depth * 16u + (size_t)operand1];
b = (uint32_t)vm->regs[vm->depth * 16u + (size_t)operand2];
vm->regs[vm->depth * 16u + (size_t)operand0] = ART_vw_i32(a ]] .. op[2] .. [[ b);]] })
end
return vm
