stk-00 1
vm "ART"
configuration "switch" "int64_t" 16 64 64 "custom" 0
source "VMCollection/ART/ART.vmw" 5
component "token"
component "opcode"
component "insncode"
component "dispatch"
component "compile"
component "tape"
component "frame"
field "depth" "u64" 0
field "out" "i64" 0
field "regs" "i64" 1040
field "result" "i64" 0
subsystem "token" c{ 232
static int64_t ART_vw_i32(uint32_t x) {
  return x <= INT32_MAX ? (int64_t)x : -1 - (int64_t)(UINT32_MAX - x);
}
static int ART_vw_reg(ART_vm *vm, ART_cell r) {
  if(r < 0 || r >= 16) { ART_vw_fail(vm,-4); return 0; }
  return 1;
}

}c
: "ADD_INT" opcode 0 operands 3 "cell" "cell" "cell" effect "( -- )" flow "next" source "VMCollection/ART/ART.vmw" 72
c{ 293
uint32_t a, b;
if(!ART_vw_reg(vm,operand0) || !ART_vw_reg(vm,operand1) || !ART_vw_reg(vm,operand2)) return;
a = (uint32_t)vm->regs[vm->depth * 16u + (size_t)operand1];
b = (uint32_t)vm->regs[vm->depth * 16u + (size_t)operand2];
vm->regs[vm->depth * 16u + (size_t)operand0] = ART_vw_i32(a + b);
}c ;
