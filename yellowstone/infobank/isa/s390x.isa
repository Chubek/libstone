  offset = 0:16;
  signed = 1;
}

op b { class = branch; encoding = B;
  operands = offset: rel;
  syntax = "b {offset}";
  semantics = "(branch offset)";
  # BEGIN BINUTILS METADATA
  binutils = {
    lookup = "syntax_mnemonic";
    mnemonic = "b";
    variants = [
      { source = "binutils/opcodes/s390-opc.txt"; line = 271; table = "s390_opcodes"; mnemonic = "b"; opcode_template = "47f0"; format = "RX_0RRD"; description = "unconditional branch"; minimum_cpu = "g5"; modes = ["esa", "zarch"]; encoding_bits = 32; match = 0x47f00000; mask = 0xfff00000; operand_codes = ["D_20", "X_12", "B_16"]; }
    ];
  };
  # END BINUTILS METADATA
}

encoding BR { width = 16;
  base = 0x7f0;
  rs1 = 0:4;
}

op br { class = branch; encoding = BR;
  operands = rs1: GPR;
  syntax = "br %{rs1}";
  semantics = "(branch rs1)";
  # BEGIN BINUTILS METADATA
  binutils = {
    lookup = "syntax_mnemonic";
    mnemonic = "br";
    variants = [
      { source = "binutils/opcodes/s390-opc.txt"; line = 268; table = "s390_opcodes"; mnemonic = "br"; opcode_template = "07f0"; format = "RR_0R"; description = "unconditional branch"; minimum_cpu = "g5"; modes = ["esa", "zarch"]; encoding_bits = 16; match = 0x7f0; mask = 0xfff0; operand_codes = ["R_12"]; }
    ];
  };
  # END BINUTILS METADATA
}

encoding NOPR { width = 16;
  base = 0x700;
  rs1 = 0:4;
}

op nopr { class = misc; encoding = NOPR;
  operands = rs1: GPR;
  syntax = "nopr %{rs1}";
  semantics = "(effect (intrinsic \"nopr\" rs1))";
  # BEGIN BINUTILS METADATA
  binutils = {
    lookup = "syntax_mnemonic";
    mnemonic = "nopr";
    variants = [
