function(run expected_status expected_text)
  execute_process(COMMAND "${CLI}" ${ARGN}
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr RESULT_VARIABLE status)
  if(NOT status STREQUAL "${expected_status}")
    message(FATAL_ERROR "${ARGN} exited ${status} (wanted ${expected_status}): ${stderr}")
  endif()
  if(status STREQUAL "0")
    set(text "${stdout}")
  else()
    set(text "${stderr}")
    if(NOT stdout STREQUAL "")
      message(FATAL_ERROR "Failed location query also produced stdout: ${stdout}")
    endif()
  endif()
  string(FIND "${text}" "${expected_text}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "${ARGN} did not produce '${expected_text}':\n${text}")
  endif()
endfunction()

