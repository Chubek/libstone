    FrameDepth := Target + 1; PendingHas := True;
    if I.Op = 105 then PendingStatus := 5 else PendingStatus := 6;
    PendingData := EmptyData; PendingEnv := EmptyEnv;
  end
  else if I.Op = 110 then
  begin
    Gen := Alloc(6);
    if Gen < 0 then Exit;
    F^.Scratch := Gen; Objects[Gen]^.Next := -1;
    Snapshot := Alloc(5);
    if Snapshot < 0 then Exit;
    FillChar(Saved, SizeOf(Saved), 0);
    Saved.Pc := I.A; Saved.Node := F^.Node; Saved.Env := F^.Env; Saved.Data := F^.Data;
    Saved.Scratch := -1; Saved.LData := -1; Saved.LBind := -1; Saved.RData := -1; Saved.REnv := -1;
    Saved.Boundary := True;
    Objects[Snapshot]^.Saved := Saved; Objects[Snapshot]^.Next := -1;
    Objects[Gen]^.Next := Snapshot; Objects[Gen]^.Count := 1;
    D := MakeData([MakeValue(5, Gen)], 1);
    if D >= 0 then Finish(0, D, EmptyEnv);
  end
  else if (I.Op = 112) or (I.Op = 113) then
  begin
    V := Expr(I.A, F^.Node, F^.Data, F^.Env, FrameDepth + 1);
    if V.Kind <> 5 then begin Finish(1, -1, -1); Exit; end;
    Gen := V.Number;
    if Objects[Gen]^.State = 1 then begin Finish(1, -1, -1); Exit; end;
    if I.Op = 113 then
    begin
      Objects[Gen]^.State := 2; Objects[Gen]^.Next := -1; Objects[Gen]^.Count := 0;
      Finish(0, EmptyData, EmptyEnv);
    end
    else if Objects[Gen]^.State = 2 then
    begin
      D := MakeData([MakeValue(0, 0)], 1);
      if D >= 0 then Finish(0, D, EmptyEnv);
    end
    else
    begin
      Base := FrameDepth;
      if Base + Objects[Gen]^.Count > DepthMax then begin Broken := True; Exit; end;
      F^.Scratch := Gen; F^.State := 2; Snapshot := Objects[Gen]^.Next;
      for J := Objects[Gen]^.Count - 1 downto 0 do
      begin
        Frames[Base + J] := Objects[Snapshot]^.Saved; Snapshot := Objects[Snapshot]^.Next;
      end;
      Inc(FrameDepth, Objects[Gen]^.Count); Objects[Gen]^.State := 1;
      if Objects[Gen]^.Used then
      begin PendingHas := True; PendingStatus := 0; PendingData := EmptyData; PendingEnv := EmptyEnv; end;
    end;
  end
  else if I.Op = 111 then
  begin
    Target := FrameDepth - 2;
    while (Target >= 0) and (Actions[Frames[Target].Pc].Op <> 112) do Dec(Target);
    if Target < 0 then begin Finish(1, -1, -1); Exit; end;
    F^.Scratch := Alloc(1);
    if F^.Scratch < 0 then Exit;
    V := Expr(I.A, F^.Node, F^.Data, F^.Env, FrameDepth + 1);
    if V.Kind < 0 then begin Finish(1, -1, -1); Exit; end;
    Objects[F^.Scratch]^.Items[0] := V; Objects[F^.Scratch]^.Count := 1;
    Gen := Frames[Target].Scratch;
    Objects[Gen]^.Next := -1; Objects[Gen]^.Count := FrameDepth - Target - 2; Objects[Gen]^.Used := True;
    for J := Target + 1 to FrameDepth - 2 do
    begin
      Snapshot := Alloc(5);
      if Snapshot < 0 then Exit;
      Objects[Snapshot]^.Saved := Frames[J]; Objects[Snapshot]^.Next := Objects[Gen]^.Next;
      Objects[Gen]^.Next := Snapshot;
    end;
    PendingHas := True; PendingStatus := 4; PendingData := F^.Scratch; PendingEnv := EmptyEnv;
    FrameDepth := Target + 1;
  end
  else
  begin
    F^.State := 1;
    PushFrame(I.A, F^.Node, F^.Env, F^.Data);
  end;
end;
procedure DispatchResume;
var F: ^TFrame; I: TInstruction; St, D, E, Bindings, DataObj, Gen: LongInt;
begin
  F := @Frames[FrameDepth - 1]; I := Actions[F^.Pc];
  St := F^.RStatus; D := F^.RData; E := F^.REnv;
  if (I.Op = 9) or (I.Op = 10) or (I.Op = 11) then
  begin
    if F^.State = 1 then
    begin
      if St <> 0 then Finish(St, D, E)
      else
      begin
        F^.LData := D; F^.LBind := E; F^.State := 2;
        if I.Op = 11 then PushFrame(I.B, F^.Node, E, F^.Data)
        else if I.Op = 9 then PushFrame(I.B, F^.Node, F^.Env, D)
        else PushFrame(I.B, F^.Node, F^.Env, F^.Data);
      end;
    end
    else
    begin
      if St <> 0 then begin Finish(St, D, E); Exit; end;
      if I.Op = 11 then Bindings := E
      else
      begin
        Bindings := Merge(F^.LBind, E, False);
        if Bindings < 0 then begin if Broken then Finish(3, -1, -1) else Finish(1, -1, -1); Exit; end;
      end;
      F^.Scratch := Bindings;
      if I.Op = 9 then DataObj := D
      else
      begin
        DataObj := ConcatData(F^.LData, D);
        if DataObj < 0 then Exit;
      end;
      Finish(0, DataObj, Bindings);
    end;
  end
  else if I.Op = 12 then
  begin
    if (F^.State = 1) and (St = 1) then
    begin
      F^.State := 2;
      PushFrame(I.B, F^.Node, F^.Env, F^.Data);
    end
    else Finish(St, D, E);
  end
  else if I.Op = 14 then
  begin
    if St <> 0 then Finish(St, D, E)
    else
    begin
      Bindings := Merge(F^.Env, E, True);
      if Bindings < 0 then begin if Broken then Finish(3, -1, -1) else Finish(1, -1, -1); end
      else Finish(0, D, Bindings);
    end;
  end
  else if I.Op = 13 then
  begin
    if (F^.State = 1) and (St = 2) then
    begin
      F^.State := 2;
      PushFrame(I.B, F^.Node, F^.Env, D);
    end
    else Finish(St, D, E);
  end
  else if (I.Op = 17) or (I.Op = 20) or (I.Op = 21) or (I.Op = 23) or (I.Op = 100) then
  begin
    { apply, enact, letrec: propagate }
    Finish(St, D, E);
  end
  else if I.Op = 104 then
  begin
    if (St = 0) or (St = 6) then F^.State := 0
    else if St = 5 then Finish(0, EmptyData, EmptyEnv)
    else Finish(St, D, E);
  end
  else if I.Op = 112 then
  begin
    Gen := F^.Scratch;
    if St = 4 then Objects[Gen]^.State := 0
    else begin Objects[Gen]^.State := 2; Objects[Gen]^.Next := -1; Objects[Gen]^.Count := 0; end;
    if (St <> 0) and (St <> 4) then Finish(St, D, E)
    else
    begin
      F^.LData := MakeData([MakeValue(0, Ord(St = 4))], 1);
      if F^.LData < 0 then Exit;
      DataObj := ConcatData(F^.LData, D);
      if DataObj >= 0 then Finish(0, DataObj, E);
    end;
  end
  else Broken := True;
end;
function Run(Root: LongInt): LongInt;
var I: LongInt;
begin
  Result := 3;
  FreeTop := 0;
  for I := 0 to HeapMax - 1 do begin FreeStack[FreeTop] := HeapMax - 1 - I; Inc(FreeTop); end;
  EmptyData := Alloc(1);
  EmptyEnv := Alloc(2);
  if Broken then Exit;
  PushFrame(Ctors[Nodes[Root].Ctor].Rule, Root, EmptyEnv, EmptyData);
  if Broken then Exit;
  while True do
  begin
    if Broken then Exit(3);
    if Unwinding then
    begin
      { Nonlocal return: pop frames without dispatch until the nearest
        function boundary, then deliver the result. }
      I := Ord(Frames[FrameDepth - 1].Boundary);
      Dec(FrameDepth);
      if (I = 1) or (FrameDepth = 0) then
      begin
        Unwinding := False;
        PendingStatus := UnwindStatus; PendingData := UnwindData; PendingEnv := UnwindEnv;
        PendingHas := True;
      end;
      Continue;
    end;
    if FrameDepth = 0 then begin Result := PendingStatus; Exit; end;
    if PendingHas then
    begin
      Frames[FrameDepth - 1].RStatus := PendingStatus;
      Frames[FrameDepth - 1].RData := PendingData;
      Frames[FrameDepth - 1].REnv := PendingEnv;
      PendingHas := False;
      if not LegacyMode then Tick(FrameDepth);
      if Broken then Continue;
      DispatchResume;
    end
    else
    begin
      Tick(FrameDepth);
      if Broken then Continue;
      DispatchEntry;
    end;
  end;
end;
var Ch: Char; Root, J, Code: LongInt; V: TValue;
begin
  Position := 1; Steps := StepsMax; Code := 2;
  while not EOF(Input) do
  begin
    Read(Input, Ch);
    if (Ch = #0) or (Length(Source) = 65536) then begin Broken := True; Break; end;
    Source := Source + Ch;
  end;
  for J := 0 to TokenCount - 1 do Intern(Tokens[J]);
  Root := ParseNode(StartSort, 0);
  if Token <> '' then Broken := True;
  if not Broken then Code := Run(Root);
  if Broken or (Code = 3) then
  begin
    for J := 0 to HeapMax - 1 do if Assigned(Objects[J]) then Dispose(Objects[J]);
    WriteLn(StdErr, 'input or resource error at byte ', Position - 1); Halt(2);
  end;
  case Code of 0: Write('completed'); 1: Write('failed'); else Write('escaped'); end;
  if (Code <> 1) and (PendingData >= 0) then
    for J := 0 to Objects[PendingData]^.Count - 1 do
    begin
      V := Objects[PendingData]^.Items[J];
      case V.Kind of
        0: Write(' ', V.Number);
        1: Write(' token:', Symbols[V.Number]);
        2: Write(' cell:', V.Number);
        3: Write(' closure');
        4: Write(' continuation');
        5: Write(' generator');
      end;
    end;
  WriteLn;
  for J := 0 to HeapMax - 1 do if Assigned(Objects[J]) then Dispose(Objects[J]);
  if Code <> 0 then Halt(1);
end.
