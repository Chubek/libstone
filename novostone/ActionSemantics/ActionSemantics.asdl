-- Concrete specification syntax; the generated visitor lowers it to machine IR.
%prefix novo_as
%option no-builtins
%%
document = (string name, string start, sort* sorts, data_sort* data_sorts, rewrite_set* rewrites, rule* rules)
sort = (string name, constructor* constructors, usize offset)
constructor = (string name, field* fields, usize offset)
field = (string name, string type, usize offset)
data_sort = (string name, variant* variants, usize offset)
variant = (string name, data_type* fields, usize offset)
data_type = (string name, usize offset)
rule = (string name, action body, usize offset)
rewrite_set = (string name, arm* arms, usize offset)
bank_ref = (string name, usize offset)
action = Primitive(string op, expr* operands)
       | Evaluate(string field)
       | Furthermore(action body)
       | Combine(string op, action left, action right)
       | Closure(action body)
       | Enact(expr function)
       | Apply(expr function, expr* arguments)
       | TailCall(expr function, expr* arguments)
       | LetRec(binding* bindings, action body)
       | Return(expr value)
       | CallCC(expr function)
       | Resume(expr continuation, expr value)
       | Unfolding(action body)
       | Unfold
       | TailUnfold
       | Generator(action body)
       | YieldValue(expr value)
       | Next(expr iterator)
       | Close(expr iterator)
       | Conditional(expr condition, action yes, action no)
       | While(expr condition, action body)
       | Break
       | Continue
       | Construct(string name, expr* arguments)
       | Deconstruct(expr value)
       | Match(expr subject, data_type? domain, arm* arms)
       | Rewrite(string strategy, expr subject, bank_ref* banks, arm* arms)
       attributes (usize offset)
binding = Binding(string name, action body) attributes (usize offset)
arm = MatchArm(pattern head, expr? guard, action body) attributes (usize offset)
pattern = Wildcard
        | Capture(string name)
        | IntPattern(string spelling)
        | TokenPattern(string spelling)
        | VariantPattern(string name, pattern* children)
        | AsPattern(pattern inner, string name)
        | OrPattern(pattern left, pattern right)
        attributes (usize offset)
expr = Integer(string spelling)
     | Field(string name)
     | Token(string name)
     | Unary(string op, expr operand)
     | Binary(string op, expr left, expr right)
     attributes (usize offset)
