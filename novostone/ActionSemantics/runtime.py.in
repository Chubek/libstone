# Generated by Novostone ActionSemantics. Standalone Python 3.
# Explicit-continuation Action Machine mirroring runtime.c.in; frames are heap
# objects, actions never rely on host recursion, and collection is mark-sweep.
import sys
import copy

@TABLES@


class Limit(Exception):
    pass


class Failure(Exception):
    pass


VK_INT, VK_TOKEN, VK_REF, VK_CLOSURE, VK_CONT, VK_GEN, VK_VARIANT = range(7)


class Variant:
    def __init__(self, tag, fields):
        self.tag, self.fields = tag, fields


class Continuation:
    def __init__(self, count):
        self.count, self.head, self.used = count, -1, False


class Snapshot:
    def __init__(self, frame, next):
        self.frame, self.next = copy.copy(frame), next


class Generator(Continuation):
    def __init__(self):
        super().__init__(1)
        self.running, self.done = False, False


def bounded(xs, n):
    if len(xs) > n:
        raise Limit()
    return xs


class Frame:
    __slots__ = ('pc', 'node', 'env', 'data', 'state', 'boundary', 'scratch',
                 'ldata', 'lbind', 'rstatus', 'rdata', 'renv', 'logical_depth')

    def __init__(self, pc, node, env, data):
        self.pc, self.node, self.env, self.data = pc, node, env, data
        self.state = 0
        self.logical_depth = 0
        self.boundary = False
        self.scratch = self.ldata = self.rdata = self.renv = -1
        self.lbind = -1
        self.rstatus = 0


class Machine:
    def __init__(self, text):
        self.text, self.pos = text, 0
        self.symbols = list(TOKENS)
        self.nodes, self.cells, self.initialized = [], [], []
        self.steps = STEPS_MAX
        self.objects = [None] * HEAP_MAX
        self.free = list(range(HEAP_MAX - 1, -1, -1))
        self.object_live = 0
        self.frames, self.pending, self.error = [], None, False
        self.unwind, self.unwind_result = False, None
        self.empty_data, self.empty_env = -1, -1

    # Heap: data objects are lists of values, binding objects are dicts,
    # closures are (pc, node, env) tuples.
    def value_roots(self, v):
        return {v[1]} if v[0] >= VK_CLOSURE else set()

    def frame_roots(self, f):
        return {i for i in (f.env, f.data, f.ldata, f.lbind, f.rdata, f.renv, f.scratch) if i >= 0}

    def mark_roots(self):
        roots = {self.empty_data, self.empty_env}
        for f in self.frames:
            roots |= self.frame_roots(f)
        for v, initialized in zip(self.cells, self.initialized):
            if initialized:
                roots |= self.value_roots(v)
        if self.pending is not None:
            status, data, env = self.pending
            if data >= 0:
                roots.add(data)
            if env >= 0:
                roots.add(env)
        if self.unwind_result is not None:
            status, data, env = self.unwind_result
            if data >= 0:
                roots.add(data)
            if env >= 0:
                roots.add(env)
        return roots

    def collect(self):
        marked = set()
        work = self.mark_roots()
        while work:
            i = work.pop()
            if i in marked or not 0 <= i < HEAP_MAX or self.objects[i] is None:
                continue
            marked.add(i)
            obj = self.objects[i]
            if isinstance(obj, list):
                for v in obj:
                    work |= self.value_roots(v)
            elif isinstance(obj, dict):
                for v in obj.values():
                    work |= self.value_roots(v)
            elif isinstance(obj, Continuation):
                work.add(obj.head)
            elif isinstance(obj, Snapshot):
                work |= self.frame_roots(obj.frame)
                work.add(obj.next)
            elif isinstance(obj, Variant):
                for v in obj.fields:
                    work |= self.value_roots(v)
            else:
                work.add(obj[2])
        for i in range(HEAP_MAX):
            if self.objects[i] is not None and i not in marked:
                self.objects[i] = None
                self.free.append(i)
                self.object_live -= 1

    def alloc(self, obj):
        if not self.free:
            self.collect()
            if not self.free:
                raise Limit()
        index = self.free.pop()
        self.objects[index] = obj
        self.object_live += 1
        return index

    def make_data(self, items):
        bounded(items, DATA_MAX)
        return self.alloc(list(items))

    def concat_data(self, a, b):
        if a < 0 or b < 0:
            raise Limit()
        ea, eb = self.objects[a], self.objects[b]
        if len(ea) + len(eb) > DATA_MAX:
            raise Limit()
        return self.alloc(ea + eb)

    def merge(self, a, b, overlay):
        if a < 0 or b < 0:
            raise Limit()
        ea, eb = self.objects[a], self.objects[b]
        if not overlay and ea.keys() & eb.keys():
            raise Failure()
        out = dict(ea)
        out.update(eb)
        return self.alloc(bounded(out, BIND_MAX))

    def tick(self, depth):
        if LEGACY_MODE and self.frames:
            depth += self.frames[-1].logical_depth - len(self.frames)
        self.steps -= 1
        if depth > DEPTH_MAX or self.steps < 0:
            raise Limit()

    def token(self):
        t = self.text
        while self.pos < len(t) and t[self.pos] in ' \t\r\n':
            self.pos += 1
        start = self.pos
        if self.pos == len(t):
            return ''
        c = t[self.pos]
        self.pos += 1
        if c.isascii() and (c.isalpha() or c == '_'):
            while self.pos < len(t) and t[self.pos].isascii() and (t[self.pos].isalnum() or t[self.pos] == '_'):
                self.pos += 1
        elif c in '-0123456789':
            while self.pos < len(t) and t[self.pos] in '0123456789':
                self.pos += 1
        result = t[start:self.pos]
        if len(result) > 64:
            raise ValueError('token exceeds 64 bytes')
        return result

    def expect(self, token):
        if self.token() != token:
            raise ValueError('expected ' + token)

    def intern(self, name):
        if not name or not name.isascii() or not (name[0].isalpha() or name[0] == '_') or not all(c.isalnum() or c == '_' for c in name):
            raise ValueError('expected identifier')
        if name not in self.symbols:
            bounded(self.symbols + [name], SYMBOLS_MAX)
            self.symbols.append(name)
        return self.symbols.index(name)

    def node(self, sort, depth=0):
        if depth > PARSE_DEPTH_MAX:
            raise Limit()
        name = self.token()
        ci = next((i for i, c in enumerate(CTORS) if c[0] == name and c[1] == sort), -1)
        if ci < 0:
            raise ValueError('unknown constructor or wrong sort')
        self.expect('(')
        fields = []
        for i, typ in enumerate(CTORS[ci][3]):
            if i:
                self.expect(',')
            if typ >= 2:
                fields.append(self.node(typ - 2, depth + 1))
            else:
                text = self.token()
                if typ == 1:
                    fields.append(self.intern(text))
                else:
                    digits = text[1:] if text.startswith('-') else text
                    if not digits or not digits.isascii() or any(c not in '0123456789' for c in digits):
                        raise ValueError('expected integer')
                    uv = int(digits)
                    if text.startswith('-'):
                        if uv > INT_MAG:
                            raise ValueError('integer out of range')
                        fields.append(-uv)
                    else:
                        if uv > INT_HI:
                            raise ValueError('integer out of range')
                        fields.append(uv)
        self.expect(')')
        bounded(self.nodes + [(ci, fields)], NODES_MAX)
        self.nodes.append((ci, fields))
        return len(self.nodes) - 1

    def has_type(self, value, typ):
        if typ == 2:
            return True
        if typ < 2:
            return value[0] == typ
        return value[0] == VK_VARIANT and VARIANTS[self.objects[value[1]].tag][1] == typ

    def structural_equal(self, x, y, depth):
        stack = []
        while True:
            self.tick(depth + len(stack))
            if x[0] != y[0]:
                return False
            if x[1] != y[1]:
                if x[0] != VK_VARIANT:
                    return False
                left, right = self.objects[x[1]], self.objects[y[1]]
                if left.tag != right.tag:
                    return False
                if left.fields:
                    stack.append((left.fields, right.fields, 0))
            while stack and stack[-1][2] == len(stack[-1][0]):
                stack.pop()
            if not stack:
                return True
            left, right, index = stack[-1]
            x, y = left[index], right[index]
            stack[-1] = (left, right, index + 1)

    def matches(self, index, v, captures, depth):
        self.tick(depth)
        op, a, b, val, pool, count = PATTERNS[index]
        if op == 0:
            return True
        if op == 1:
            captures.append((a, v))
            return True
        if op == 2:
            return v == (VK_INT, val)
        if op == 3:
            return v == (VK_TOKEN, a)
        if op == 5:
            if not self.matches(a, v, captures, depth + 1):
                return False
            captures.append((b, v))
            return True
        if op == 6:
            saved = len(captures)
            if self.matches(a, v, captures, depth + 1):
                return True
            del captures[saved:]
            return self.matches(b, v, captures, depth + 1)
        if v[0] != VK_VARIANT or self.objects[v[1]].tag != a:
            return False
        for j in range(count):
            if not self.matches(POOL[pool + j], self.objects[v[1]].fields[j], captures, depth + 1):
                return False
        return True

    def expr(self, index, node, data, env, depth):
        self.tick(depth)
        op, a, b, val, pool, count = EXPRS[index]
        ci, fields = self.nodes[node]
        if op == 0:
            return (VK_INT, val)
        if op == 1:
            return (CTORS[ci][3][a], fields[a])
        if op == 2:
            return (VK_TOKEN, a)
        if op == 3:
            if a >= len(data):
                raise Failure()
            return data[a]
        x = self.expr(a, node, data, env, depth + 1)
        if op == 4:
            if x[0] != VK_TOKEN or x[1] not in env:
                raise Failure()
            return env[x[1]]
        if op == 5:
            if x[0] != VK_REF or not 0 <= x[1] < len(self.cells) or not self.initialized[x[1]]:
                raise Failure()
            return self.cells[x[1]]
        if op == 12:
            if x[0] != VK_VARIANT:
                raise Failure()
            return (VK_INT, len(self.objects[x[1]].fields))
        y = self.expr(b, node, data, env, depth + 1)
        if op == 13:
            if x[0] != VK_VARIANT or y[0] != VK_INT or not 1 <= y[1] <= len(self.objects[x[1]].fields):
                raise Failure()
            return self.objects[x[1]].fields[y[1] - 1]
        if op == 14:
            return (VK_INT, int(self.structural_equal(x, y, depth + 1)))
        if op == 15:
            return (VK_INT, int(x == y))
        if x[0] != VK_INT or y[0] != VK_INT:
            raise Failure()
        x, y = x[1], y[1]
        if op == 6:
            z = x + y
        elif op == 7:
            z = x - y
        elif op == 8:
            z = x * y
        elif op == 9:
            if y == 0 or (x == -9223372036854775808 and y == -1):
                raise Failure()
            z = (abs(x) // abs(y)) * (-1 if (x < 0) != (y < 0) else 1)
        elif op == 10:
            z = int(x == y)
        else:
            z = int(x < y)
        if not INT_LO <= z <= INT_HI:
            raise Failure()
        return (VK_INT, z)

    def finish(self, status, data, env):
        self.frames.pop()
        self.pending = (status, data, env)

    def push(self, pc, node, env, data):
        if len(self.frames) >= DEPTH_MAX + int(LEGACY_MODE):
            raise Limit()
        frame = Frame(pc, node, env, data)
        frame.logical_depth = self.frames[-1].logical_depth + 1 if self.frames else 0
        self.frames.append(frame)

    def dispatch_entry(self, f):
        op, a, b, val, pool, count = ACTIONS[f.pc]
        if op == 0:
            self.finish(0, self.empty_data, self.empty_env)
        elif op == 1:
            self.finish(1, self.empty_data, self.empty_env)
        elif op in (2, 3, 4, 5, 6, 102):
            # Result storage is allocated before evaluation: yielder results
            # may reference heap objects, and allocation can collect.
            f.scratch = self.alloc({} if op == 5 else [])
            x = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if op == 2:
                self.objects[f.scratch].append(x)
                self.finish(0, f.scratch, self.empty_env)
            elif op == 4:
                self.objects[f.scratch].append(x)
                self.finish(2, f.scratch, self.empty_env)
            elif op == 3:
                self.finish(0 if x[0] == VK_INT and x[1] else 1, self.empty_data, self.empty_env)
            elif op == 5:
                y = self.expr(b, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
                if x[0] != VK_TOKEN:
                    raise Failure()
                self.objects[f.scratch][x[1]] = y
                self.finish(0, self.empty_data, f.scratch)
            else:
                y = self.expr(b, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
                if (op == 6 and x[0] != VK_INT) or y[0] != VK_REF or not 0 <= y[1] < len(self.cells):
                    raise Failure()
                self.cells[y[1]] = x
                self.initialized[y[1]] = True
                self.finish(0, self.empty_data, self.empty_env)
        elif op == 7:
            bounded(self.cells + [None], REFS_MAX)
            self.cells.append(None)
            self.initialized.append(False)
            self.finish(0, self.make_data([(VK_REF, len(self.cells) - 1)]), self.empty_env)
        elif op == 8:
            child = self.nodes[f.node][1][a]
            f.pc = CTORS[self.nodes[child][0]][2]
            f.node = child
            f.logical_depth += 1
        elif op == 16:
            closure = self.alloc((a, f.node, f.env))
            f.scratch = closure
            self.finish(0, self.make_data([(VK_CLOSURE, closure)]), self.empty_env)
        elif op in (17, 19, 20):
            # Argument storage is allocated before evaluation so evaluated
            # closures survive any collection.
            f.scratch = self.alloc([])
            function = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if function[0] != VK_CLOSURE:
                raise Failure()
            pc, node, env = self.objects[function[1]]
            args = self.objects[f.scratch]
            for j in range(count):
                argument = self.expr(POOL[pool + j], f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
                if len(args) >= DATA_MAX:
                    raise Limit()
                args.append(argument)
            if op == 19:
                target = len(self.frames) - 1
                while target > 0 and not self.frames[target].boundary:
                    target -= 1
                self.frames[target:] = [f]
                f.boundary = True
                f.pc, f.node, f.env, f.data = pc, node, env, f.scratch
                f.state = 0
                f.scratch = f.ldata = f.lbind = -1
                f.rstatus = 0
                f.rdata = f.renv = -1
            else:
                data = f.data if op == 20 else f.scratch
                self.push(pc, node, env, data)
                f.state = 2
                self.frames[-1].boundary = True
        elif op == 18:
            f.scratch = self.alloc([])
            v = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            self.objects[f.scratch].append(v)
            self.unwind_result = (0, f.scratch, self.empty_env)
            self.unwind = True
        elif op == 21:
            base = self.objects[f.env]
            shared = dict(base)
            f.scratch = self.alloc(shared)
            for j in range(count):
                closure = self.alloc((POOL[pool + 2 * j + 1], f.node, f.scratch))
                shared[POOL[pool + 2 * j]] = (VK_CLOSURE, closure)
                bounded(shared, BIND_MAX)
            self.push(b, f.node, f.scratch, f.data)
            f.state = 2
        elif op == 23:
            function = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if function[0] != VK_CLOSURE:
                raise Failure()
            pc, node, env = self.objects[function[1]]
            cont = Continuation(len(self.frames) - 1)
            f.scratch = self.alloc(cont)
            for frame in self.frames[:-1]:
                cont.head = self.alloc(Snapshot(frame, cont.head))
            f.ldata = self.make_data([(VK_CONT, f.scratch)])
            f.state = 2
            self.push(pc, node, env, f.ldata)
            self.frames[-1].boundary = True
        elif op == 24:
            v = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if v[0] != VK_CONT or self.objects[v[1]].used:
                raise Failure()
            cont = self.objects[v[1]]
            value = self.expr(b, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            data = self.make_data([value])
            cont.used = True
            restored = []
            snapshot = cont.head
            while snapshot >= 0:
                obj = self.objects[snapshot]
                restored.append(copy.copy(obj.frame))
                snapshot = obj.next
            self.frames = list(reversed(restored))
            self.pending = (0, data, self.empty_env)
        elif op == 100:
            f.state = 2
            self.push(a, f.node, f.env, f.data)
        elif op in (101, 107):
            target = len(self.frames) - 1
            while target >= 0 and ACTIONS[self.frames[target].pc][0] != 100:
                if ACTIONS[self.frames[target].pc][0] == 112:
                    raise Failure()
                target -= 1
            if target < 0:
                raise Failure()
            scope = self.frames[target]
            if op == 101:
                f.pc, f.node = ACTIONS[scope.pc][1], scope.node
            else:
                self.frames[target + 1:] = []
                self.push(ACTIONS[scope.pc][1], scope.node, f.env, f.data)
        elif op in (103, 104):
            condition = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if condition[0] != VK_INT:
                raise Failure()
            if op == 103:
                f.pc = b if condition[1] else val
            elif not condition[1]:
                self.finish(0, self.empty_data, self.empty_env)
            else:
                f.state = 1
                self.push(b, f.node, f.env, f.data)
        elif op in (105, 106):
            target = len(self.frames) - 1
            while target >= 0 and ACTIONS[self.frames[target].pc][0] != 104:
                if self.frames[target].boundary:
                    raise Failure()
                target -= 1
            if target < 0:
                raise Failure()
            self.frames[target + 1:] = []
            self.pending = (5 if op == 105 else 6, self.empty_data, self.empty_env)
        elif op == 114:
            fields = []
            f.scratch = self.alloc(Variant(a, fields))
            for j in range(count):
                value = self.expr(POOL[pool + j], f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
                if not self.has_type(value, POOL[VARIANTS[a][2] + j]):
                    raise Failure()
                fields.append(value)
            self.finish(0, self.make_data([(VK_VARIANT, f.scratch)]), self.empty_env)
        elif op == 115:
            depth = len(self.frames) + 1
            data, base = self.objects[f.data], self.objects[f.env]
            value = self.expr(a, f.node, data, base, depth)
            if b >= 0 and not self.has_type(value, b):
                raise Failure()
            for j in range(count):
                p, guard, body = POOL[pool + 3*j:pool + 3*j + 3]
                captures = []
                f.scratch = -1
                if not self.matches(p, value, captures, depth):
                    continue
                env = f.env
                if captures:
                    env = f.scratch = self.alloc(bounded(base | dict(captures), BIND_MAX))
                if guard >= 0:
                    try:
                        test = self.expr(guard, f.node, data, self.objects[env], depth)
                    except Failure:
                        continue
                    if test[0] != VK_INT or not test[1]:
                        continue
                f.pc, f.env, f.scratch = body, env, -1
                return
            raise Failure()
        elif op == 116:
            value = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if value[0] != VK_VARIANT:
                raise Failure()
            self.finish(0, self.make_data(self.objects[value[1]].fields), self.empty_env)
        elif op == 110:
            gen = Generator()
            f.scratch = self.alloc(gen)
            frame = Frame(a, f.node, f.env, f.data)
            frame.boundary = True
            gen.head = self.alloc(Snapshot(frame, -1))
            self.finish(0, self.make_data([(VK_GEN, f.scratch)]), self.empty_env)
        elif op in (112, 113):
            v = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            if v[0] != VK_GEN:
                raise Failure()
            gen = self.objects[v[1]]
            if gen.running:
                raise Failure()
            if op == 113:
                gen.done, gen.head, gen.count = True, -1, 0
                self.finish(0, self.empty_data, self.empty_env)
            elif gen.done:
                self.finish(0, self.make_data([(VK_INT, 0)]), self.empty_env)
            else:
                bounded(self.frames + [None] * gen.count, DEPTH_MAX)
                f.scratch, f.state = v[1], 2
                restored = []
                head = gen.head
                while head >= 0:
                    snapshot = self.objects[head]
                    restored.append(copy.copy(snapshot.frame))
                    head = snapshot.next
                self.frames.extend(reversed(restored))
                gen.running = True
                # A yielded action completes with no transients upon resumption.
                if gen.used:
                    self.pending = (0, self.empty_data, self.empty_env)
        elif op == 111:
            target = len(self.frames) - 2
            while target >= 0 and ACTIONS[self.frames[target].pc][0] != 112:
                target -= 1
            if target < 0:
                raise Failure()
            f.scratch = self.alloc([])
            v = self.expr(a, f.node, self.objects[f.data], self.objects[f.env], len(self.frames) + 1)
            self.objects[f.scratch].append(v)
            gen = self.objects[self.frames[target].scratch]
            gen.head, gen.count, gen.used = -1, len(self.frames) - target - 2, True
            for frame in self.frames[target + 1:-1]:
                gen.head = self.alloc(Snapshot(frame, gen.head))
            self.pending = (4, f.scratch, self.empty_env)
            self.frames[target + 1:] = []
        else:
            f.state = 1
            self.push(a, f.node, f.env, f.data)

    def dispatch_resume(self, f):
        op, a, b, val, pool, count = ACTIONS[f.pc]
        st, d, e = f.rstatus, f.rdata, f.renv
        if op in (9, 10, 11):
            if f.state == 1:
                if st:
                    self.finish(st, d, e)
                else:
                    f.ldata, f.lbind, f.state = d, e, 2
                    self.push(b, f.node, e if op == 11 else f.env, d if op == 9 else f.data)
            else:
                if st:
                    self.finish(st, d, e)
                    return
                bindings = e if op == 11 else self.merge(f.lbind, e, False)
                f.scratch = bindings
                dataobj = d if op == 9 else self.concat_data(f.ldata, d)
                self.finish(0, dataobj, bindings)
        elif op == 12:
            if f.state == 1 and st == 1:
                f.state = 2
                self.push(b, f.node, f.env, f.data)
            else:
                self.finish(st, d, e)
        elif op == 13:
            if f.state == 1 and st == 2:
                f.state = 2
                self.push(b, f.node, f.env, d)
            else:
                self.finish(st, d, e)
        elif op == 14:
            if st:
                self.finish(st, d, e)
            else:
                self.finish(0, d, self.merge(f.env, e, True))
        elif op in (17, 20, 21, 23, 100):
            self.finish(st, d, e)
        elif op == 104:
            if st in (0, 6):
                f.state = 0
            elif st == 5:
                self.finish(0, self.empty_data, self.empty_env)
            else:
                self.finish(st, d, e)
        elif op == 112:
            gen = self.objects[f.scratch]
            gen.running = False
            if st != 4:
                gen.done, gen.head, gen.count = True, -1, 0
            if st not in (0, 4):
                self.finish(st, d, e)
            else:
                f.ldata = self.make_data([(VK_INT, int(st == 4))])
                result = self.concat_data(f.ldata, d)
                self.finish(0, result, e)
        else:
            raise Limit()

    def run(self, root):
        self.empty_data = self.alloc([])
        self.empty_env = self.alloc({})
        self.push(CTORS[self.nodes[root][0]][2], root, self.empty_env, self.empty_data)
        while True:
            if self.error:
                return (3, -1, -1)
            if self.unwind:
                # Nonlocal return: pop frames without dispatch until the
                # nearest function boundary, then deliver the result.
                boundary = self.frames[-1].boundary
                self.frames.pop()
                if boundary or not self.frames:
                    self.unwind = False
                    self.pending = self.unwind_result
                continue
            if not self.frames:
                return self.pending
            f = self.frames[-1]
            try:
                if self.pending is not None:
                    st, d, e, = self.pending
                    self.pending = None
                    f.rstatus, f.rdata, f.renv = st, d, e
                    if not LEGACY_MODE:
                        self.tick(len(self.frames))
                    self.dispatch_resume(f)
                else:
                    self.tick(len(self.frames))
                    self.dispatch_entry(f)
            except Failure:
                self.finish(1, -1, -1)
            except Limit:
                self.error = True
                return (3, -1, -1)
            except RecursionError:
                self.error = True
                return (3, -1, -1)

    def show(self, v):
        if v[0] == VK_INT:
            return str(v[1])
        if v[0] == VK_TOKEN:
            return 'token:' + self.symbols[v[1]]
        if v[0] == VK_CLOSURE:
            return 'closure'
        if v[0] == VK_CONT:
            return 'continuation'
        if v[0] == VK_GEN:
            return 'generator'
        if v[0] == VK_VARIANT:
            return 'variant:' + VARIANTS[self.objects[v[1]].tag][0]
        if v[0] == VK_CONT:
            return 'continuation'
        return 'cell:' + str(v[1])


def main():
    try:
        text = sys.stdin.buffer.read(65537)
        if len(text) > 65536 or b'\0' in text:
            raise ValueError('invalid input size or NUL')
        m = Machine(text.decode('ascii'))
        root = m.node(START)
        if m.token():
            raise ValueError('trailing input')
        status, data, env = m.run(root)
        if m.error or status == 3:
            raise ValueError('resource error')
        word = ('completed', 'failed', 'escaped')[status]
        shown = [m.show(v) for v in m.objects[data]] if data >= 0 else []
        print(' '.join([word] + shown))
        return 0 if status == 0 else 1
    except (ValueError, Limit, RecursionError, MemoryError) as e:
        print('input or resource error: ' + str(e), file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
