/* Generated by Novostone ActionSemantics. Standalone C11.
   Explicit-continuation Action Machine: frames are bounded-pool objects, a
   pending slot carries results between frames, and actions never recurse on the
   host stack. In-flight results live in frame slots so collection stays sound. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <inttypes.h>

typedef struct { int op, a, b, value, pool, count; } Instruction;
typedef struct { const char *name; int sort, rule, count, fields[16]; } Constructor;
@TABLES@

/* Value kinds: -1 error sentinel, 0 integer, 1 token, 2 cell reference,
   3 closure. Heap object kinds: 1 transient tuple, 2 bindings, 3 closure. */
enum { VK_ERROR = -1, VK_INT = 0, VK_TOKEN = 1, VK_REF = 2, VK_CLOSURE = 3, VK_CONT = 4, VK_GEN = 5 };
enum { HO_DATA = 1, HO_ENV = 2, HO_CLOSURE = 3, HO_CONT = 4, HO_FRAME = 5, HO_GEN = 6 };
typedef struct { int kind; int64_t imm; } Value;
typedef struct { int pc, node, env, data, state, boundary, scratch, ldata, lbind, rstatus, rdata, renv, logical_depth; } Frame;
typedef struct {
    int kind, mark, count;
    Value items[DATA_MAX];
    int keys[BIND_MAX];
    Value values[BIND_MAX];
    struct { int pc, node, env; } closure;
    Frame frame;
    int next, used, state; /* generator: 0 suspended, 1 running, 2 closed */
} Object;
typedef struct { int status, data, env, has; } Pending;
typedef struct { int ctor; int64_t fields[16]; } Node;
typedef struct {
    char input[65538], symbols[SYMBOLS_MAX][65];
    size_t pos, length;
    Node nodes[NODES_MAX];
    int node_count, symbol_count, ref_count, error;
    int64_t steps;
    Value cells[REFS_MAX];
    int initialized[REFS_MAX];
    Object *objects[HEAP_MAX];
    int free_stack[HEAP_MAX], free_top, object_live;
    int work[HEAP_MAX], work_top;
    Frame frames[DEPTH_MAX + 1];
    int depth, unwind;
    Pending pending, unwind_result;
    int empty_data, empty_env;
} Machine;

static int alpha(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
static int digit(char c) { return c >= '0' && c <= '9'; }
static Value value(int kind, int64_t v) { Value r; r.kind = kind; r.imm = v; return r; }

/* Mark-sweep collection. Roots are the canonical empties, every live frame's
   environment, input data, result and scratch slots, and the pending result.
   Values referencing heap objects (closures) are traced transitively. Cell
   references live in separate monotonic storage, exactly like dialect 1. */
static void mark(Machine *m, int index);
static void mark_value(Machine *m, Value v) {
    if (v.kind == VK_CLOSURE || v.kind == VK_CONT || v.kind == VK_GEN) mark(m, (int)v.imm);
}
static void mark(Machine *m, int index) {
    Object *o;
    if (index < 0 || index >= HEAP_MAX) return;
    o = m->objects[index];
    if (!o || o->mark) return;
    o->mark = 1;
    m->work[m->work_top++] = index;
}
static void mark_frame(Machine *m, const Frame *f) {
    mark(m, f->env); mark(m, f->data);
    mark(m, f->ldata); mark(m, f->lbind);
    mark(m, f->rdata); mark(m, f->renv); mark(m, f->scratch);
}
static void gc(Machine *m) {
    int i, j;
    m->work_top = 0;
    for (i = 0; i < HEAP_MAX; ++i) if (m->objects[i]) m->objects[i]->mark = 0;
    mark(m, m->empty_data); mark(m, m->empty_env);
    for (i = 0; i < m->depth; ++i) {
        mark_frame(m, &m->frames[i]);
    }
    if (m->pending.has) { mark(m, m->pending.data); mark(m, m->pending.env); }
    mark(m, m->unwind_result.data); mark(m, m->unwind_result.env);
    for (i = 0; i < m->ref_count; ++i) if (m->initialized[i]) mark_value(m, m->cells[i]);
    while (m->work_top) {
        Object *o = m->objects[m->work[--m->work_top]];
        switch (o->kind) {
        case HO_DATA: for (j = 0; j < o->count; ++j) mark_value(m, o->items[j]); break;
        case HO_ENV: for (j = 0; j < o->count; ++j) mark_value(m, o->values[j]); break;
        case HO_CLOSURE: mark(m, o->closure.env); break;
        case HO_CONT: case HO_GEN: mark(m, o->next); break;
        case HO_FRAME: mark_frame(m, &o->frame); mark(m, o->next); break;
        default: break;
        }
    }
    for (i = 0; i < HEAP_MAX; ++i)
        if (m->objects[i] && !m->objects[i]->mark) {
            free(m->objects[i]); m->objects[i] = NULL;
            m->free_stack[m->free_top++] = i; --m->object_live;
        }
}
static int obj_alloc(Machine *m, int kind) {
    int i;
    if (!m->free_top) { gc(m); if (!m->free_top) { m->error = 1; return -1; } }
    i = m->free_stack[--m->free_top];
    m->objects[i] = calloc(1, sizeof(Object));
    if (!m->objects[i]) { m->error = 1; return -1; }
    m->objects[i]->kind = kind; ++m->object_live; return i;
}
static int make_data(Machine *m, const Value *items, int count) {
    int i = obj_alloc(m, HO_DATA), j;
    if (i < 0) return -1;
    if (count > DATA_MAX) { m->error = 1; return -1; }
    m->objects[i]->count = count;
    for (j = 0; j < count; ++j) m->objects[i]->items[j] = items[j];
    return i;
}
static int concat_data(Machine *m, int a, int b) {
    Object *ea, *eb; int i, j;
    if (a < 0 || b < 0) { m->error = 1; return -1; }
    ea = m->objects[a]; eb = m->objects[b];
    if (ea->count + eb->count > DATA_MAX) { m->error = 1; return -1; }
    i = obj_alloc(m, HO_DATA);
    if (i < 0) return -1;
    for (j = 0; j < ea->count; ++j) m->objects[i]->items[j] = ea->items[j];
    for (j = 0; j < eb->count; ++j) m->objects[i]->items[ea->count + j] = eb->items[j];
    m->objects[i]->count = ea->count + eb->count;
    return i;
}
/* Disjoint-union (overlay 0) or overlay (overlay 1) merge. Duplicate keys are
   checked before capacity, on every backend, exactly like dialect 1. */
static int merge(Machine *m, int a, int b, int overlay) {
    Object *ea, *eb; int j, k, out;
    if (a < 0 || b < 0) { m->error = 1; return -1; }
    ea = m->objects[a]; eb = m->objects[b];
    if (!overlay)
        for (j = 0; j < eb->count; ++j)
            for (k = 0; k < ea->count; ++k)
                if (ea->keys[k] == eb->keys[j]) return -1;
    out = obj_alloc(m, HO_ENV);
    if (out < 0) return -1;
    m->objects[out]->count = ea->count;
    for (j = 0; j < ea->count; ++j) {
        m->objects[out]->keys[j] = ea->keys[j];
        m->objects[out]->values[j] = ea->values[j];
    }
    for (j = 0; j < eb->count; ++j) {
        for (k = 0; k < m->objects[out]->count; ++k)
            if (m->objects[out]->keys[k] == eb->keys[j]) break;
        if (k == BIND_MAX) { m->error = 1; return -1; }
        if (k == m->objects[out]->count) ++m->objects[out]->count;
        m->objects[out]->keys[k] = eb->keys[j];
        m->objects[out]->values[k] = eb->values[j];
    }
    return out;
}
static void tick(Machine *m, int depth) {
    if (LEGACY_MODE && m->depth)
        depth += m->frames[m->depth - 1].logical_depth - m->depth;
    if (depth > DEPTH_MAX || --m->steps < 0) m->error = 1;
}
static void token(Machine *m, char out[65]) {
    size_t start, n;
    while (m->pos < m->length && strchr(" \t\r\n", m->input[m->pos])) ++m->pos;
    start = m->pos;
    if (m->pos < m->length) {
        char c = m->input[m->pos++];
        if (alpha(c)) while (m->pos < m->length && (alpha(m->input[m->pos]) || digit(m->input[m->pos]))) ++m->pos;
        else if (digit(c) || c == '-') while (m->pos < m->length && digit(m->input[m->pos])) ++m->pos;
    }
    n = m->pos - start;
    if (n > 64) { m->error = 1; n = 0; }
    memcpy(out, m->input + start, n); out[n] = 0;
}
static void expect(Machine *m, const char *s) { char t[65]; token(m, t); if (strcmp(t, s)) m->error = 1; }
static int intern(Machine *m, const char *s) {
    int i;
    if (!alpha(s[0])) { m->error = 1; return 0; }
    for (i = 0; i < m->symbol_count; ++i) if (!strcmp(s, m->symbols[i])) return i;
    if (i == SYMBOLS_MAX) { m->error = 1; return 0; }
    strcpy(m->symbols[i], s); ++m->symbol_count;
    return i;
}
static int parse_node(Machine *m, int sort, int depth) {
    char t[65]; int c, f, index, negative; Node node = {0};
    uint64_t uv;
    if (depth > PARSE_DEPTH_MAX || m->error) { m->error = 1; return 0; }
    token(m, t);
    for (c = 0; c < CTOR_COUNT; ++c) if (CTORS[c].sort == sort && !strcmp(CTORS[c].name, t)) break;
    if (c == CTOR_COUNT) { m->error = 1; return 0; }
    node.ctor = c; expect(m, "(");
    for (f = 0; f < CTORS[c].count && !m->error; ++f) {
        int type = CTORS[c].fields[f];
        size_t p;
        if (f) expect(m, ",");
        if (type >= 2) node.fields[f] = parse_node(m, type - 2, depth + 1);
        else {
            token(m, t);
            if (type == 1) node.fields[f] = intern(m, t);
            else {
                p = t[0] == '-' ? 1u : 0u; uv = 0; negative = t[0] == '-';
                if (!digit(t[p])) m->error = 1;
                for (; t[p] && !m->error; ++p) {
                    int d = t[p] - '0';
                    if (!digit(t[p]) || uv > (uint64_t)INT_MAG / 10u ||
                        (uv == (uint64_t)INT_MAG / 10u && (uint64_t)d > (uint64_t)INT_MAG % 10u)) { m->error = 1; break; }
                    uv = uv * 10u + (uint64_t)d;
                }
                if (!m->error) {
                    if (negative) {
                        if (uv > (uint64_t)INT_MAG) m->error = 1;
                        else node.fields[f] = -(int64_t)uv;
                    } else {
                        if (uv > (uint64_t)INT_HI) m->error = 1;
                        else node.fields[f] = (int64_t)uv;
                    }
                }
            }
        }
    }
    expect(m, ")");
    if (m->node_count == NODES_MAX || m->error) { m->error = 1; return 0; }
    index = m->node_count++; m->nodes[index] = node; return index;
}
/* Yielders are pure and evaluated with bounded host recursion; only actions
   carry captureable control state, and they use the frame machine. */
static Value expr(Machine *m, int index, int node, const Object *data, const Object *env, int depth) {
    Instruction i = EXPRS[index]; Value x, y; int k; int64_t z;
    tick(m, depth);
    if (m->error) return value(VK_ERROR, 0);
    switch (i.op) {
    case 0: return value(VK_INT, i.value);
    case 1: return value(CTORS[m->nodes[node].ctor].fields[i.a], m->nodes[node].fields[i.a]);
    case 2: return value(VK_TOKEN, i.a);
    case 3: return i.a < data->count ? data->items[i.a] : value(VK_ERROR, 0);
    default: break;
    }
    x = expr(m, i.a, node, data, env, depth + 1);
    if (x.kind < 0) return x;
    if (i.op == 4) {
        if (x.kind == VK_TOKEN)
            for (k = 0; k < env->count; ++k) if (env->keys[k] == x.imm) return env->values[k];
        return value(VK_ERROR, 0);
    }
    if (i.op == 5) {
        if (x.kind != VK_REF || x.imm < 0 || x.imm >= m->ref_count || !m->initialized[x.imm])
            return value(VK_ERROR, 0);
        return m->cells[x.imm];
    }
    y = expr(m, i.b, node, data, env, depth + 1);
    if (x.kind != VK_INT || y.kind != VK_INT) return value(VK_ERROR, 0);
    switch (i.op) {
    case 6: z = x.imm + y.imm; break;
    case 7: z = x.imm - y.imm; break;
    case 8: z = x.imm * y.imm; break;
    case 9:
        if (!y.imm || (x.imm == INT64_MIN && y.imm == -1)) return value(VK_ERROR, 0);
        z = x.imm / y.imm; break;
    case 10: z = x.imm == y.imm; break;
    default: z = x.imm < y.imm; break;
    }
    return z < INT_LO || z > INT_HI ? value(VK_ERROR, 0) : value(VK_INT, z);
}
static void finish(Machine *m, int status, int data, int bindings) {
    --m->depth;
    m->pending.status = status; m->pending.data = data; m->pending.env = bindings;
    m->pending.has = 1;
}
static int push_frame(Machine *m, int pc, int node, int env, int data) {
    Frame *f;
    if (m->depth >= DEPTH_MAX + LEGACY_MODE) { m->error = 1; return 0; }
    f = &m->frames[m->depth++];
    f->pc = pc; f->node = node; f->env = env; f->data = data;
    f->logical_depth = m->depth > 1 ? m->frames[m->depth - 2].logical_depth + 1 : 0;
    f->state = 0; f->boundary = 0; f->scratch = -1;
    f->ldata = -1; f->lbind = -1;
    f->rstatus = 0; f->rdata = -1; f->renv = -1;
    return 1;
}
static Pending run(Machine *m, int root) {
    Pending out;
    int i;
    for (i = 0; i < HEAP_MAX; ++i) m->free_stack[m->free_top++] = HEAP_MAX - 1 - i;
    m->unwind_result.data = -1; m->unwind_result.env = -1; m->unwind_result.has = 0;
    m->empty_data = obj_alloc(m, HO_DATA);
    m->empty_env = obj_alloc(m, HO_ENV);
    if (m->error || !push_frame(m, CTORS[m->nodes[root].ctor].rule, root, m->empty_env, m->empty_data)) {
        out.has = 0; out.status = 3; return out;
    }
    for (;;) {
        Frame *f; Instruction i;
        if (m->error) { out.has = 0; out.status = 3; return out; }
        if (m->unwind) {
            /* Nonlocal return: pop frames without dispatch until the nearest
               function boundary, then deliver the result to its parent. */
            int boundary = m->frames[m->depth - 1].boundary;
            --m->depth;
            if (boundary || m->depth == 0) {
                m->unwind = 0;
                m->pending = m->unwind_result;
                m->pending.has = 1;
            }
            continue;
        }
        if (m->depth == 0) return m->pending;
        f = &m->frames[m->depth - 1];
        i = ACTIONS[f->pc];
        if (m->pending.has) {
            /* A child frame finished: deliver its result through this frame. */
            f->rstatus = m->pending.status; f->rdata = m->pending.data; f->renv = m->pending.env;
            m->pending.has = 0;
            if (!LEGACY_MODE) tick(m, m->depth);
            if (m->error) continue;
            switch (i.op) {
            case 9: case 10: case 11: /* then, and then, hence */
                if (f->state == 1) {
                    if (f->rstatus) { finish(m, f->rstatus, f->rdata, f->renv); break; }
                    f->ldata = f->rdata; f->lbind = f->renv; f->state = 2;
                    push_frame(m, i.b, f->node, i.op == 11 ? f->renv : f->env, i.op == 9 ? f->rdata : f->data);
                } else {
                    int bindings, dataobj;
                    if (f->rstatus) { finish(m, f->rstatus, f->rdata, f->renv); break; }
                    if (i.op == 11) bindings = f->renv;
                    else {
                        bindings = merge(m, f->lbind, f->renv, 0);
                        if (bindings < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                    }
                    f->scratch = bindings; /* root intermediate merge across concat GC */
                    if (i.op == 9) dataobj = f->rdata;
                    else {
                        dataobj = concat_data(m, f->ldata, f->rdata);
                        if (dataobj < 0) break;
                    }
                    finish(m, 0, dataobj, bindings);
                }
                break;
            case 12: /* otherwise */
                if (f->state == 1 && f->rstatus == 1) {
                    f->state = 2;
                    push_frame(m, i.b, f->node, f->env, f->data);
                } else finish(m, f->rstatus, f->rdata, f->renv);
                break;
            case 13: /* trapping */
                if (f->state == 1 && f->rstatus == 2) {
                    f->state = 2;
                    push_frame(m, i.b, f->node, f->env, f->rdata);
                } else finish(m, f->rstatus, f->rdata, f->renv);
                break;
            case 14: /* furthermore */
                if (f->rstatus) { finish(m, f->rstatus, f->rdata, f->renv); break; }
                {
                    int bindings = merge(m, f->env, f->renv, 1);
                    if (bindings < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                    finish(m, 0, f->rdata, bindings);
                }
                break;
            case 17: case 20: case 21: case 23: case 100:
                finish(m, f->rstatus, f->rdata, f->renv);
                break;
            case 104:
                if (f->rstatus == 0 || f->rstatus == 6) f->state = 0;
                else if (f->rstatus == 5) finish(m, 0, m->empty_data, m->empty_env);
                else finish(m, f->rstatus, f->rdata, f->renv);
                break;
            case 112: {
                Object *gen = m->objects[f->scratch];
                int result;
                gen->state = f->rstatus == 4 ? 0 : 2;
                if (gen->state == 2) { gen->next = -1; gen->count = 0; }
                if (f->rstatus != 0 && f->rstatus != 4) { finish(m, f->rstatus, f->rdata, f->renv); break; }
                {
                    Value flag = value(VK_INT, f->rstatus == 4);
                    f->ldata = make_data(m, &flag, 1);
                }
                if (f->ldata < 0) break;
                result = concat_data(m, f->ldata, f->rdata);
                if (result >= 0) finish(m, 0, result, f->renv);
                break;
            }
            default:
                m->error = 1; break;
            }
        } else {
            tick(m, m->depth);
            if (m->error) continue;
            switch (i.op) {
            case 0: finish(m, 0, m->empty_data, m->empty_env); break;
            case 1: finish(m, 1, m->empty_data, m->empty_env); break;
            case 2: case 3: case 4: case 5: case 6: case 102: {
                /* Allocate result storage before evaluation: yielder results may
                   reference heap objects, and allocation can collect. */
                f->scratch = i.op == 5 ? obj_alloc(m, HO_ENV) : obj_alloc(m, HO_DATA);
                if (f->scratch < 0) break;
                Value x = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                if (x.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                if (i.op == 2 || i.op == 4) {
                    m->objects[f->scratch]->count = 1;
                    m->objects[f->scratch]->items[0] = x;
                    finish(m, i.op == 2 ? 0 : 2, f->scratch, m->empty_env);
                } else if (i.op == 3) finish(m, x.kind == VK_INT && x.imm ? 0 : 1, m->empty_data, m->empty_env);
                else if (i.op == 5) {
                    Value y = expr(m, i.b, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                    if (y.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                    if (x.kind != VK_TOKEN) { finish(m, 1, -1, -1); break; }
                    m->objects[f->scratch]->count = 1;
                    m->objects[f->scratch]->keys[0] = (int)x.imm;
                    m->objects[f->scratch]->values[0] = y;
                    finish(m, 0, m->empty_data, f->scratch);
                } else {
                    Value y = expr(m, i.b, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                    if (y.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                    if ((i.op == 6 && x.kind != VK_INT) || y.kind != VK_REF || y.imm < 0 || y.imm >= m->ref_count) {
                        finish(m, 1, -1, -1); break;
                    }
                    m->cells[y.imm] = x; m->initialized[y.imm] = 1;
                    finish(m, 0, m->empty_data, m->empty_env);
                }
                break;
            }
            case 7: /* allocate */
                if (m->ref_count == REFS_MAX) { m->error = 1; break; }
                {
                    Value cell = value(VK_REF, m->ref_count++);
                    int d = make_data(m, &cell, 1);
                    if (d < 0) break;
                    finish(m, 0, d, m->empty_env);
                }
                break;
            case 8: { /* evaluate: tail-replace the current frame */
                int child = (int)m->nodes[f->node].fields[i.a];
                f->pc = CTORS[m->nodes[child].ctor].rule;
                f->node = child;
                ++f->logical_depth;
                break;
            }
            case 16: { /* closure: capture body, environment, and syntax node */
                int closure = obj_alloc(m, HO_CLOSURE);
                Value cell;
                int d;
                if (closure < 0) break;
                m->objects[closure]->closure.pc = i.a;
                m->objects[closure]->closure.node = f->node;
                m->objects[closure]->closure.env = f->env;
                f->scratch = closure;
                cell = value(VK_CLOSURE, closure);
                d = make_data(m, &cell, 1);
                if (d < 0) break;
                finish(m, 0, d, m->empty_env);
                break;
            }
            case 17: case 19: case 20: { /* apply, tailcall, enact */
                Object *closure = NULL;
                int j, failed = 0;
                /* Argument storage is allocated before evaluation so evaluated
                   closures survive any collection. */
                f->scratch = obj_alloc(m, HO_DATA);
                if (f->scratch < 0) break;
                {
                    Value function = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                    if (function.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); failed = 1; }
                    else if (function.kind != VK_CLOSURE) { finish(m, 1, -1, -1); failed = 1; }
                    else closure = m->objects[(int)function.imm];
                }
                for (j = 0; !failed && j < i.count; ++j) {
                    Value argument = expr(m, POOL[i.pool + j], f->node,
                        m->objects[f->data], m->objects[f->env], m->depth + 1);
                    if (argument.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); failed = 1; break; }
                    if (m->objects[f->scratch]->count >= DATA_MAX) { m->error = 1; failed = 1; break; }
                    m->objects[f->scratch]->items[m->objects[f->scratch]->count++] = argument;
                }
                if (failed || m->error) break;
                if (i.op == 19) { /* discard the current function's continuation */
                    int target = m->depth - 1;
                    while (target > 0 && !m->frames[target].boundary) --target;
                    m->frames[target] = *f;
                    m->depth = target + 1;
                    f = &m->frames[target];
                    f->boundary = 1;
                    f->pc = closure->closure.pc;
                    f->node = closure->closure.node;
                    f->env = closure->closure.env;
                    f->data = f->scratch;
                    f->state = 0;
                    f->scratch = -1;
                    f->ldata = -1; f->lbind = -1;
                    f->rstatus = 0; f->rdata = -1; f->renv = -1;
                } else if (i.op == 20) { /* enact: pass the current transients */
                    if (!push_frame(m, closure->closure.pc, closure->closure.node,
                        closure->closure.env, f->data)) break;
                    f->state = 2;
                    m->frames[m->depth - 1].boundary = 1;
                } else { /* apply: push, mark a function boundary */
                    if (!push_frame(m, closure->closure.pc, closure->closure.node,
                        closure->closure.env, f->scratch)) break;
                    f->state = 2;
                    m->frames[m->depth - 1].boundary = 1;
                }
                break;
            }
            case 18: { /* return: complete the nearest function boundary */
                f->scratch = obj_alloc(m, HO_DATA);
                if (f->scratch < 0) break;
                {
                    Value v = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                    if (v.kind < 0) { finish(m, m->error ? 3 : 1, -1, -1); break; }
                    m->objects[f->scratch]->count = 1;
                    m->objects[f->scratch]->items[0] = v;
                }
                m->unwind_result.status = 0;
                m->unwind_result.data = f->scratch;
                m->unwind_result.env = m->empty_env;
                m->unwind_result.has = 1;
                m->unwind = 1;
                break;
            }
            case 21: { /* letrec: shared recursive environment */
                int j;
                f->scratch = obj_alloc(m, HO_ENV);
                if (f->scratch < 0) break;
                {
                    Object *base = m->objects[f->env];
                    Object *shared = m->objects[f->scratch];
                    shared->count = base->count;
                    for (j = 0; j < base->count; ++j) {
                        shared->keys[j] = base->keys[j];
                        shared->values[j] = base->values[j];
                    }
                    for (j = 0; j < i.count; ++j) {
                        int key = POOL[i.pool + 2 * j];
                        int closure = obj_alloc(m, HO_CLOSURE);
                        if (closure < 0) break;
                        m->objects[closure]->closure.pc = POOL[i.pool + 2 * j + 1];
                        m->objects[closure]->closure.node = f->node;
                        m->objects[closure]->closure.env = f->scratch;
                        /* The write happens before any further allocation, so
                           every created closure stays reachable via the shared
                           environment rooted through the frame. */
                        int k;
                        for (k = 0; k < shared->count && shared->keys[k] != key; ++k) {}
                        if (k == BIND_MAX) { m->error = 1; break; }
                        shared->keys[k] = key;
                        shared->values[k] = value(VK_CLOSURE, closure);
                        if (k == shared->count) ++shared->count;
                    }
                    if (m->error) break;
                }
                if (!push_frame(m, i.b, f->node, f->scratch, f->data)) break;
                f->state = 2;
                break;
            }
            case 23: { /* callcc: snapshot caller frames, excluding this action */
                int cont, j, snapshot, d;
                Value function = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                int pc, node, env;
                if (function.kind != VK_CLOSURE) { finish(m, 1, -1, -1); break; }
                pc = m->objects[function.imm]->closure.pc;
                node = m->objects[function.imm]->closure.node;
                env = m->objects[function.imm]->closure.env;
                cont = obj_alloc(m, HO_CONT);
                if (cont < 0) break;
                f->scratch = cont; m->objects[cont]->next = -1;
                m->objects[cont]->count = m->depth - 1;
                for (j = 0; j < m->depth - 1; ++j) {
                    snapshot = obj_alloc(m, HO_FRAME);
                    if (snapshot < 0) break;
                    m->objects[snapshot]->frame = m->frames[j];
                    m->objects[snapshot]->next = m->objects[cont]->next;
                    m->objects[cont]->next = snapshot;
                }
                if (m->error) break;
                {
                    Value v = value(VK_CONT, cont);
                    d = make_data(m, &v, 1);
                }
                if (d < 0) break;
                f->ldata = d; f->state = 2;
                if (push_frame(m, pc, node, env, d)) m->frames[m->depth - 1].boundary = 1;
                break;
            }
            case 24: { /* one-shot abortive resume; the store is shared */
                Value cont = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                Value v;
                int d, j, snapshot;
                Object *o;
                if (cont.kind != VK_CONT || m->objects[cont.imm]->used) { finish(m, 1, -1, -1); break; }
                v = expr(m, i.b, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                if (v.kind < 0) { finish(m, 1, -1, -1); break; }
                d = make_data(m, &v, 1);
                if (d < 0) break;
                o = m->objects[cont.imm]; o->used = 1;
                snapshot = o->next;
                m->depth = o->count;
                for (j = m->depth - 1; j >= 0; --j) {
                    m->frames[j] = m->objects[snapshot]->frame;
                    snapshot = m->objects[snapshot]->next;
                }
                m->pending = (Pending){0, d, m->empty_env, 1};
                m->unwind = 0;
                break;
            }
            case 110: {
                int gen = obj_alloc(m, HO_GEN), snapshot, d;
                Value v;
                Frame saved;
                if (gen < 0) break;
                f->scratch = gen; m->objects[gen]->next = -1;
                snapshot = obj_alloc(m, HO_FRAME);
                if (snapshot < 0) break;
                memset(&saved, 0, sizeof(saved));
                saved.pc = i.a; saved.node = f->node; saved.env = f->env; saved.data = f->data;
                saved.scratch = saved.ldata = saved.lbind = saved.rdata = saved.renv = -1;
                saved.boundary = 1;
                m->objects[snapshot]->frame = saved; m->objects[snapshot]->next = -1;
                m->objects[gen]->next = snapshot; m->objects[gen]->count = 1;
                v = value(VK_GEN, gen); d = make_data(m, &v, 1);
                if (d >= 0) finish(m, 0, d, m->empty_env);
                break;
            }
            case 112: case 113: {
                Value v = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                Object *gen;
                int j, head, base = m->depth;
                if (v.kind != VK_GEN) { finish(m, 1, -1, -1); break; }
                gen = m->objects[v.imm];
                if (gen->state == 1) { finish(m, 1, -1, -1); break; }
                if (i.op == 113) {
                    gen->state = 2; gen->next = -1; gen->count = 0;
                    finish(m, 0, m->empty_data, m->empty_env); break;
                }
                if (gen->state == 2) {
                    Value flag = value(VK_INT, 0);
                    int d = make_data(m, &flag, 1);
                    if (d >= 0) finish(m, 0, d, m->empty_env);
                    break;
                }
                if (base + gen->count > DEPTH_MAX) { m->error = 1; break; }
                f->scratch = (int)v.imm; f->state = 2;
                head = gen->next;
                for (j = gen->count - 1; j >= 0; --j) {
                    m->frames[base + j] = m->objects[head]->frame;
                    head = m->objects[head]->next;
                }
                m->depth += gen->count; gen->state = 1;
                if (gen->used) {
                    m->pending.has = 1; m->pending.status = 0;
                    m->pending.data = m->empty_data; m->pending.env = m->empty_env;
                }
                break;
            }
            case 111: {
                int target = m->depth - 2, j, snapshot;
                Object *gen;
                Value v;
                while (target >= 0 && ACTIONS[m->frames[target].pc].op != 112) --target;
                if (target < 0) { finish(m, 1, -1, -1); break; }
                f->scratch = obj_alloc(m, HO_DATA);
                if (f->scratch < 0) break;
                v = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                if (v.kind < 0) { finish(m, 1, -1, -1); break; }
                m->objects[f->scratch]->items[0] = v; m->objects[f->scratch]->count = 1;
                gen = m->objects[m->frames[target].scratch];
                gen->next = -1; gen->count = m->depth - target - 2; gen->used = 1;
                for (j = target + 1; j < m->depth - 1; ++j) {
                    snapshot = obj_alloc(m, HO_FRAME);
                    if (snapshot < 0) break;
                    m->objects[snapshot]->frame = m->frames[j];
                    m->objects[snapshot]->next = gen->next; gen->next = snapshot;
                }
                if (m->error) break;
                m->pending.has = 1; m->pending.status = 4;
                m->pending.data = f->scratch; m->pending.env = m->empty_env;
                m->depth = target + 1;
                break;
            }
            case 100: /* recursive action delimiter */
                f->state = 2;
                push_frame(m, i.a, f->node, f->env, f->data);
                break;
            case 101: case 107: { /* recursive substitution or explicit tail restart */
                int j = m->depth - 1, node = f->node, env = f->env, data = f->data;
                while (j >= 0 && ACTIONS[m->frames[j].pc].op != 100 &&
                       ACTIONS[m->frames[j].pc].op != 112) --j;
                if (j < 0 || ACTIONS[m->frames[j].pc].op == 112) { finish(m, 1, -1, -1); break; }
                if (i.op == 101) {
                    f->pc = ACTIONS[m->frames[j].pc].a; f->node = m->frames[j].node;
                } else {
                    m->depth = j + 1;
                    push_frame(m, ACTIONS[m->frames[j].pc].a, m->frames[j].node, env, data);
                }
                (void)node;
                break;
            }
            case 103: case 104: {
                Value condition = expr(m, i.a, f->node, m->objects[f->data], m->objects[f->env], m->depth + 1);
                if (condition.kind != VK_INT) { finish(m, 1, -1, -1); break; }
                if (i.op == 103) f->pc = condition.imm ? i.b : i.value;
                else if (!condition.imm) finish(m, 0, m->empty_data, m->empty_env);
                else { f->state = 1; push_frame(m, i.b, f->node, f->env, f->data); }
                break;
            }
            case 105: case 106: {
                int target = m->depth - 1;
                while (target >= 0 && ACTIONS[m->frames[target].pc].op != 104 &&
                       !m->frames[target].boundary) --target;
                if (target < 0 || ACTIONS[m->frames[target].pc].op != 104) { finish(m, 1, -1, -1); break; }
                m->depth = target + 1; m->pending.has = 1;
                m->pending.status = i.op == 105 ? 5 : 6;
                m->pending.data = m->empty_data; m->pending.env = m->empty_env;
                break;
            }
            case 9: case 10: case 11: case 12: case 13: case 14:
                f->state = 1;
                push_frame(m, i.a, f->node, f->env, f->data);
                break;
            default:
                m->error = 1; break;
            }
        }
    }
}
int main(void) {
    Machine *m = calloc(1, sizeof(*m)); Pending r;
    int root, j, code = 2, i; char t[65];
    if (!m) { fputs("resource error\n", stderr); return 2; }
    m->steps = STEPS_MAX; m->length = fread(m->input, 1, 65537, stdin);
    if (ferror(stdin) || m->length > 65536 || memchr(m->input, 0, m->length)) goto error;
    for (j = 0; j < TOKEN_COUNT; ++j) (void)intern(m, TOKENS[j]);
    root = parse_node(m, START, 0); token(m, t);
    if (m->error || *t) goto error;
    r = run(m, root);
    if (m->error || r.status == 3) goto error;
    fputs(r.status == 0 ? "completed" : r.status == 1 ? "failed" : "escaped", stdout);
    if (r.data >= 0)
        for (j = 0; j < m->objects[r.data]->count; ++j) {
            Value v = m->objects[r.data]->items[j];
            if (v.kind == VK_TOKEN) printf(" token:%s", m->symbols[v.imm]);
            else if (v.kind == VK_CLOSURE) printf(" closure");
            else if (v.kind == VK_CONT) printf(" continuation");
            else if (v.kind == VK_GEN) printf(" generator");
            else if (v.kind == VK_CONT) printf(" continuation");
            else printf(v.kind == VK_REF ? " cell:%" PRId64 : " %" PRId64, v.imm);
        }
    putchar('\n'); code = r.status ? 1 : 0;
    for (i = 0; i < HEAP_MAX; ++i) free(m->objects[i]);
    free(m); return code;
error:
    for (i = 0; i < HEAP_MAX; ++i) free(m->objects[i]);
    fprintf(stderr, "input or resource error at byte %zu\n", m->pos); free(m); return code;
}
