                    }
                    self.finish(0, self.empty_data, self.empty_env);
                } else if state == 2 {
                    let d = self.make_data(&[Value(VK_INT, 0)])?;
                    self.finish(0, d, self.empty_env);
                } else {
                    bounded(self.frames.len() + count, DEPTH_MAX)?;
                    self.frames[fi].scratch = v.1 as i32; self.frames[fi].state = 2;
                    let mut restored = Vec::with_capacity(count);
                    while head >= 0 {
                        match self.data_of(head)? {
                            Object::Snapshot { frame, next } => { restored.push(frame.clone()); head = *next; }
                            _ => return Err(Fault::Limit),
                        }
                    }
                    restored.reverse(); self.frames.extend(restored);
                    if let Some(Object::Generator { state, .. }) = &mut self.objects[v.1 as usize] { *state = 1; }
                    if used { self.pending = Some((0, self.empty_data, self.empty_env)); }
                }
            }
            111 => {
                let target = self.frames[..fi].iter().rposition(|f| ACTIONS[f.pc].op == 112).ok_or(Fault::Failed)?;
                let scratch = self.alloc(Object::Data(Vec::new()))?;
                self.frames[fi].scratch = scratch;
                let v = eval_or!(a);
                if let Some(Object::Data(items)) = &mut self.objects[scratch as usize] { items.push(v); }
                let gen = self.frames[target].scratch as usize;
                if let Some(Object::Generator { head, count, used, .. }) = &mut self.objects[gen] {
                    *head = -1; *count = fi - target - 1; *used = true;
                }
                for j in target + 1..fi {
                    let head = match self.data_of(gen as i32)? {
                        Object::Generator { head, .. } => *head, _ => return Err(Fault::Limit),
                    };
                    let snapshot = self.alloc(Object::Snapshot { frame: self.frames[j].clone(), next: head })?;
                    if let Some(Object::Generator { head, .. }) = &mut self.objects[gen] { *head = snapshot; }
                }
                self.frames.truncate(target + 1);
                self.pending = Some((4, scratch, self.empty_env));
            }
            _ => {
                self.frames[fi].state = 1;
                self.push(a as usize, node, env, data)?;
            }
        }
        Ok(())
    }
    fn resume(&mut self, fi: usize) -> Fallible<()> {
        let op = ACTIONS[self.frames[fi].pc].op;
        let b = ACTIONS[self.frames[fi].pc].b;
        let node = self.frames[fi].node;
        let state = self.frames[fi].state;
        let env = self.frames[fi].env;
        let data = self.frames[fi].data;
        let ldata = self.frames[fi].ldata;
        let lbind = self.frames[fi].lbind;
        let st = self.frames[fi].rstatus;
        let d = self.frames[fi].rdata;
        let e = self.frames[fi].renv;
        match op {
            9 | 10 | 11 => {
                if state == 1 {
                    if st != 0 { self.finish(st, d, e); return Ok(()); }
                    self.frames[fi].ldata = d;
                    self.frames[fi].lbind = e;
                    self.frames[fi].state = 2;
                    self.push(b as usize, node, if op == 11 { e } else { env }, if op == 9 { d } else { data })?;
                } else {
                    if st != 0 { self.finish(st, d, e); return Ok(()); }
                    let bindings = if op == 11 { e } else {
                        match self.merge(lbind, e, false) {
                            Ok(v) => v, Err(Fault::Failed) => { self.finish(1, -1, -1); return Ok(()); }, Err(x) => return Err(x),
                        }
                    };
                    self.frames[fi].scratch = bindings;
                    let dataobj = if op == 9 { d } else {
                        match self.concat_data(ldata, d) {
                            Ok(v) => v, Err(Fault::Failed) => { self.finish(1, -1, -1); return Ok(()); }, Err(x) => return Err(x),
                        }
                    };
                    self.finish(0, dataobj, bindings);
                }
            }
            12 => {
                if state == 1 && st == 1 {
                    self.frames[fi].state = 2;
                    self.push(b as usize, node, env, data)?;
                } else { self.finish(st, d, e); }
            }
            13 => {
                if state == 1 && st == 2 {
                    self.frames[fi].state = 2;
                    self.push(b as usize, node, env, d)?;
                } else { self.finish(st, d, e); }
            }
            14 => {
                if st != 0 { self.finish(st, d, e); return Ok(()); }
                let bindings = match self.merge(env, e, true) {
                    Ok(v) => v, Err(Fault::Failed) => { self.finish(1, -1, -1); return Ok(()); }, Err(x) => return Err(x),
                };
                self.finish(0, d, bindings);
            }
            17 | 20 | 21 | 23 | 100 => { self.finish(st, d, e); }
            104 => {
                if st == 0 || st == 6 { self.frames[fi].state = 0; }
                else if st == 5 { self.finish(0, self.empty_data, self.empty_env); }
                else { self.finish(st, d, e); }
            }
            112 => {
                let gen = self.frames[fi].scratch as usize;
                if let Some(Object::Generator { head, count, state, .. }) = &mut self.objects[gen] {
                    *state = if st == 4 { 0 } else { 2 };
                    if st != 4 { *head = -1; *count = 0; }
                }
                if st != 0 && st != 4 { self.finish(st, d, e); } else {
                    let prefix = self.make_data(&[Value(VK_INT, i64::from(st == 4))])?;
                    self.frames[fi].ldata = prefix;
                    let result = self.concat_data(prefix, d)?;
                    self.finish(0, result, e);
                }
            }
            _ => return Err(Fault::Limit),
        }
        Ok(())
    }
    fn run(&mut self, root: usize) -> Fallible<(i32, i32, i32)> {
        self.empty_data = self.alloc(Object::Data(Vec::new()))?;
        self.empty_env = self.alloc(Object::Env(Vec::new()))?;
        let rule = CTORS[self.nodes[root].0].rule;
        self.push(rule, root, self.empty_env, self.empty_data)?;
        loop {
            if self.unwind {
                // Nonlocal return: pop frames without dispatch until the
                // nearest function boundary, then deliver the result.
                let boundary = self.frames.last().expect("unwind frame").boundary;
                self.frames.pop();
                if boundary || self.frames.is_empty() {
                    self.unwind = false;
                    self.pending = self.unwind_result;
                }
                continue;
            }
            if self.frames.is_empty() { return Ok(self.pending.expect("final result")); }
            let fi = self.frames.len() - 1;
            if let Some((st, d, e)) = self.pending.take() {
                self.frames[fi].rstatus = st;
                self.frames[fi].rdata = d;
                self.frames[fi].renv = e;
                if !LEGACY_MODE { self.tick(self.frames.len() as i32)?; }
                self.resume(fi)?;
            } else {
                self.tick(self.frames.len() as i32)?;
                match self.enter(fi) {
                    Err(Fault::Failed) => self.finish(1, -1, -1),
                    result => result?,
                }
            }
        }
    }
}
fn run() -> Fallible<i32> {
    let mut text = Vec::new();
    io::stdin().take(65537).read_to_end(&mut text).map_err(|_| Fault::Input)?;
    bounded(text.len(), 65536)?;
    if text.contains(&0) { return Err(Fault::Input); }
    let mut m = Machine {
        text, pos: 0, symbols: TOKENS.iter().map(|s| s.to_string()).collect(),
        nodes: Vec::new(), cells: Vec::new(), steps: STEPS_MAX,
        objects: (0..HEAP_MAX).map(|_| None).collect(),
        free: (0..HEAP_MAX).rev().collect(), pending: None,
        unwind: false, unwind_result: None,
        frames: Vec::new(), empty_data: -1, empty_env: -1,
    };
    let root = m.node(START, 0)?;
    if !m.token()?.is_empty() { return Err(Fault::Input); }
    let (status, data, _) = m.run(root)?;
    print!("{}", match status { 0 => "completed", 1 => "failed", _ => "escaped" });
    if data >= 0 {
        if let Some(Object::Data(items)) = &m.objects[data as usize] {
            for v in items {
                match v.0 {
                    VK_INT => print!(" {}", v.1),
                    VK_TOKEN => print!(" token:{}", m.symbols[v.1 as usize]),
                    VK_CLOSURE => print!(" closure"),
                    VK_CONT => print!(" continuation"),
                    VK_GEN => print!(" generator"),
                    _ => print!(" cell:{}", v.1),
                }
            }
        }
    }
    println!(); Ok(if status == 0 { 0 } else { 1 })
}
fn main() {
    std::process::exit(match run() { Ok(code) => code, Err(e) => { eprintln!("input or resource error: {:?}", e); 2 } });
}
