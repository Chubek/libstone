  (microarch generic
    (issue-width 1)
    (model conservative-in-order)
    (schedules (ref schedule alu) (ref schedule mul) (ref schedule div) (ref schedule load) (ref schedule store) (ref schedule branch) (ref schedule fp) (ref schedule serial))
    (hazards "RAW, WAR and WAW dependencies; flags and implicit registers are resources. Never speculate trapping, volatile, atomic or serializing operations across control or memory barriers."))
  (legalize wide-integer
    (types (ref type i128))
    (action expand)
    (recipe "add/sub: two i64 halves with explicit carry/borrow; multiply: four limb products; shifts: split at 64; compare: high signed/unsigned then low unsigned. Division and remainder call __divti3/__udivti3/__modti3/__umodti3 with target ABI."))
  (legalize small-integer
    (types (ref type i1) (ref type i8) (ref type i16))
    (action promote)
    (to (ref type i32))
    (recipe "Zero/sign extend before widened operations according to IR; truncate stores/results. Mask i1. Signed compare/div/rem/arithmetic shift require sign extension. Preserve original-width overflow and poison semantics at the IR boundary."))
  (legalize unsupported-vector
    (action scalarize)
    (recipe "Split fixed vectors into independently legalized lanes. Preserve lane masks and inactive-lane merge/zero policy. Scalable vectors require an explicitly enabled scalable backend or a diagnostic, never silently assume a fixed length."))
  (legalize runtime-fallbacks
    (action libcall)
    (symbols "memcpy memmove memset; __divdi3/__udivdi3/__moddi3/__umoddi3 for i64 division/remainder when no legal machine form; __atomic_load/__atomic_store/__atomic_exchange/__atomic_compare_exchange for unsupported widths; fmod/fmodf, sqrt/sqrtf, conversions and compiler-rt helpers as required. Link the target-compatible runtime.")
    (constraints "Honor overlap for memmove, volatile and atomic semantics, errno/fenv requirements, and exact ABI helper signatures. Unsupported operations without a legal expansion/runtime declaration must be diagnosed."))
  (rewrite add-zero
    (match (bvadd W X (const W 0)))
    (replace X)
    (guards "Pure bitvector result; arithmetic flags dead, no memory/fault/volatile effects, matching widths. SSA poison behavior must already be discharged.")
    (proof (ref smt bitvectors)))
  (rewrite double-xor
    (match (bvxor W X X))
    (replace (const W 0))
    (guards "Identical defined operands at equal width; flags dead; do not duplicate or remove observable loads.")
    (proof (ref smt bitvectors)))
  (rewrite branch-inversion
    (recipe "Invert predicate and exchange CFG successors; preserve fallthrough edge probabilities, exception edges, target reachability and relocation kind."))
  (smt bitvectors
    (logic QF_AUFBV)
    (state "Registers are storage bitvectors; memory is Array[addr64,byte8]. Subregister writes use extract/concat. Separate memory tokens and effect order from pure values.")
    (preconditions "Equal input widths; defined inputs; alignment and no-fault hypotheses explicit. Undefined architectural flags are fresh independent values. Never treat undefined as zero or assume poison can be concretized.")
    (objective "Prove equivalence of live outputs, memory effects, traps and control flow under guards before comparing size/latency/register-pressure costs. Timeouts or unknown solver results reject a rewrite."))
  (smt floating-point
    (logic QF_FP)
    (preconditions "Model rounding modes, signed zero, NaNs, infinities, exceptions and target flush/NaN propagation. Reassociation requires explicit fast-math permissions. Bitvector identities do not prove IEEE-754 transformations."))
  (legalize floating-transcendentals
    (types (ref type f32) (ref type f64))
    (action libcall)
    (recipe "sin/cos/tan/exp/log/pow/sqrt/fmod and their f-suffixed f32 variants use the declared target C runtime signatures. Preserve errno and fenv observability unless IR flags permit otherwise. IEEE scalar arithmetic uses native forms only with enabled FP state; otherwise use compiler-rt soft-float helpers."))
  (legalize unaligned-access
    (action expand)
    (recipe "Where normal unaligned accesses are unavailable, assemble/disassemble little-endian bytes using shifts/OR and byte loads/stores. Do not split atomic or volatile accesses unless the execution environment explicitly allows it; otherwise call the appropriate runtime or diagnose."))
  (rewrite load-store-combine
    (recipe "Combine adjacent nonvolatile, nonatomic accesses only with proven alias, alignment, bounds, endianness and no-extra-fault equivalence; retain debug locations and memory ordering tokens. A shorter sequence is not automatically equivalent."))
