    (arity 2 2)
    (semantics "Arguments width,value: bitvector value modulo 2^width."))
  (pcode-op pc
    (arity 0 0)
    (semantics "Current instruction address."))
  (pcode-op jump
    (arity 1 1)
    (semantics "Set PC to target; enforce architectural alignment and access checks."))
  (pcode-op nop
    (arity 0 0)
    (semantics "No state change except normal fallthrough."))
  (pcode-op trap
    (arity 1 1)
    (semantics "Raise named synchronous exception without normal fallthrough."))
