    (sources "ArchTk/infobank/Capstone-Arch/WASM/WASMDisassembler.c opcode table; Binaryen-WASM/wasm-stack.cpp and wasm-validator.cpp for stack typing and binary emission.")
    (semantics "Operands read pre-state. Effects commit after fault checks; normal fallthrough advances PC by encoded length. Widths are bits; offsets are bytes."))
  (coverage profile
    (status selected-concrete-forms)
    (contract "WebAssembly MVP wasm32 stack machine. Selected no-immediate integer operations and canonical single-byte LEB constants only. Not a register ISA. No general LEB128, structured control, module serialization, SIMD or threads encoder.")
