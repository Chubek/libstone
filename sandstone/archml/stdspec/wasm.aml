    (arity 1 1)
    (semantics "Read named implicit architectural register."))
  (pcode-op set-reg
    (arity 2 2)
    (semantics "Write named implicit architectural register."))
  (pcode-op parallel
    (arity 2 2)
    (semantics "Evaluate both effects in pre-state and commit together after fault checks."))
