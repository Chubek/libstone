; ArchML v1: riscv64. Generated by tools/generate_archml.py.
; Concrete forms and extension coverage are listed explicitly below.
(archml 1 riscv64
  (target riscv64
    (bits 64)
    (endian little)
    (triple "riscv64-unknown-linux-gnu")
    (default-features (ref feature base) (ref feature m) (ref feature a) (ref feature f) (ref feature d))
    (default-abi (ref abi lp64d))
    (sources "RISC-V unprivileged ISA RV64I/M/A/F/D/C and ELF psABI. Local encoding cross-check: ArchTk/infobank/Capstone-Arch/RISCV/RISCVGenDisassemblerTables.inc and LLVM-Target/RISCV/RISCVInstrInfo.td. Vector state is metadata-only.")
    (semantics "P-code evaluates operands in the pre-instruction state. Parallel effects commit together after fault checks. Widths are bits; addresses and displacements are bytes. Each instruction has an implicit next-PC equal to PC plus encoded length. Unwritten state is preserved."))
  (coverage compiler-profile
    (status concrete-forms-with-explicit-fallbacks)
    (contract "Instruction records are executable encoding templates, not mnemonic families. Unlisted operand/addressing forms are unsupported by the encoder. Metadata-only extensions must not be selected. Legalization supplies scalar expansion or named runtime helpers for unsupported operations. This is a compiler profile, not an exhaustive ISA or privileged-system simulator.")
    (abi-scope "ELF relocatable objects; static/small code model by default. ABI records describe aggregate/varargs rules for frontend ABI lowering. Object writer, linker and unwinder consume relocation/layout metadata."))
  (pcode-op parallel
    (arity 1 64)
    (effect effect)
    (semantics "Evaluate every RHS in pre-state; commit nonconflicting writes together after all synchronous fault checks. Memory faults leave the architectural destination and PC unchanged. Conflicting writes are invalid."))
  (pcode-op read
    (arity 1 1)
    (effect value)
    (semantics "Read a named instruction operand: register operands read the selected view; immediate operands return the supplied scaled signed/unsigned value. Zero registers read zero. Storage aliases and per-instruction vector write policies apply."))
  (pcode-op write
    (arity 2 2)
    (effect effect)
    (semantics "Write a named destination operand, truncating to its architectural view width; apply register write policy. Read-only/discard registers ignore the write."))
  (pcode-op reg
    (arity 1 1)
    (effect value)
    (semantics "Read the explicitly named implicit architectural register in pre-state."))
  (pcode-op set-reg
    (arity 2 2)
    (effect effect)
    (semantics "Write an explicitly named implicit architectural register with its view policy."))
  (pcode-op const
    (arity 2 2)
    (effect value)
    (semantics "Construct a bitvector of width argument 1 by reducing integer argument 2 modulo 2^width."))
  (pcode-op pc
    (arity 0 0)
    (effect value)
    (semantics "Current instruction address, not the next instruction."))
  (pcode-op next-pc
    (arity 0 0)
    (effect value)
    (semantics "PC plus concrete encoding length modulo address width."))
  (pcode-op jump
    (arity 1 1)
    (effect control)
    (semantics "Set PC to target. Target alignment and executable mapping checks are architecture-specific precise exceptions."))
  (pcode-op branch
    (arity 2 2)
    (effect control)
    (semantics "If boolean condition is true, jump to target; otherwise advance to next-PC."))
  (pcode-op nop
    (arity 0 0)
    (effect effect)
    (semantics "No architectural state change except advancing PC."))
  (pcode-op trap
    (arity 1 1)
    (effect control)
    (semantics "Raise the named synchronous exception; no normal fallthrough."))
  (pcode-op load
    (arity 4 4)
    (effect memory)
    (semantics "Arguments width,address,endian,required-alignment. Read width/8 bytes with the named endian; access/translation/alignment checks precede all destination writes. Memory ordering follows the profile."))
  (pcode-op store
    (arity 5 5)
    (effect memory)
    (semantics "Arguments width,address,value,endian,required-alignment. Write low width bits with precise checks before commit. Not implicitly atomic beyond the memory record guarantee."))
  (pcode-op sext
    (arity 3 3)
    (effect value)
    (semantics "Arguments source-width,destination-width,value. Sign extend low source-width bits; destination >= source."))
  (pcode-op zext
    (arity 3 3)
    (effect value)
    (semantics "Arguments source-width,destination-width,value. Zero extend low source-width bits; destination >= source."))
  (pcode-op extract
    (arity 3 3)
    (effect value)
    (semantics "Arguments value,low-bit,width. Return the selected low-indexed bit slice."))
  (pcode-op deposit
    (arity 4 4)
    (effect value)
    (semantics "Arguments old,value,low-bit,width. Replace only that bit slice in old."))
  (pcode-op eq
    (arity 2 2)
    (effect bool)
    (semantics "Bitvector equality; operands must have equal width."))
  (pcode-op ne
    (arity 2 2)
    (effect bool)
    (semantics "Bitvector inequality; operands must have equal width."))
  (pcode-op slt
    (arity 2 2)
    (effect bool)
    (semantics "Signed two-complement less-than on equally sized bitvectors."))
  (pcode-op ult
    (arity 2 2)
    (effect bool)
    (semantics "Unsigned less-than on equally sized bitvectors."))
  (pcode-op sge
    (arity 2 2)
    (effect bool)
    (semantics "Signed greater-than-or-equal on equally sized bitvectors."))
  (pcode-op uge
    (arity 2 2)
    (effect bool)
    (semantics "Unsigned greater-than-or-equal on equally sized bitvectors."))
  (pcode-op bool-int
    (arity 2 2)
    (effect value)
    (semantics "Arguments width,boolean. Produce zero or one at width."))
  (pcode-op fence
    (arity 2 2)
    (effect memory)
    (semantics "Order named predecessor and successor access sets. Compiler motion and hardware visibility both obey the target atomic record."))
  (pcode-op fp-bin
    (arity 5 5)
    (effect value)
    (semantics "Arguments operation,IEEE-format,left,right,rounding-environment. Perform IEEE-754 arithmetic including signed zero, infinities and NaNs. Set target sticky exception flags; trap only if enabled. Target NaN propagation, flush modes and boxing policy come from vector/extension records."))
  (pcode-op vector-bin
    (arity 5 5)
    (effect value)
    (semantics "Arguments operation,lane-format,lane-count,left,right. Apply lane-wise operation. Integer lanes wrap; floating lanes use the FP environment. No cross-lane carries."))
  (pcode-op x86-condition
    (arity 1 1)
    (effect bool)
    (semantics "Decode condition nibble: 0 OF,2 CF,4 ZF,6 CF|ZF,8 SF,10 PF,12 SF!=OF,14 ZF|(SF!=OF); odd nibbles invert the preceding predicate."))
  (pcode-op arm-condition
    (arity 1 1)
    (effect bool)
    (semantics "0 Z,2 C,4 N,6 V,8 C&!Z,10 N==V,12 !Z&(N==V); odd values invert except 15, and 14/15 always true."))
  (pcode-op x86-flags-add
    (arity 3 3)
    (effect flags)
    (semantics "Arguments width,a,b. r=(a+b) mod 2^w; CF=unsigned carry; OF=((~(a xor b)&(a xor r))>>(w-1))&1; AF=((a xor b xor r)>>4)&1; ZF=r==0; SF=msb(r); PF=even parity of low byte."))
  (pcode-op x86-flags-sub
    (arity 3 3)
    (effect flags)
    (semantics "Arguments width,a,b. r=(a-b) mod 2^w; CF=unsigned a<b; OF=(((a xor b)&(a xor r))>>(w-1))&1; AF=((a xor b xor r)>>4)&1; ZF=r==0; SF=msb(r); PF=even parity low byte."))
  (pcode-op x86-flags-logic
    (arity 2 2)
    (effect flags)
    (semantics "Arguments width,result. CF=OF=0; AF undefined/fresh nondeterministic; ZF=result==0; SF=msb(result); PF=even parity low byte. Undefined flags are not poison and cannot justify equality proofs."))
  (pcode-op x86-imul-flags
    (arity 3 3)
    (effect flags)
    (semantics "Arguments width,a,b. CF=OF iff signed full product differs from sign-extension of low width bits. SF/ZF/AF/PF undefined."))
  (pcode-op x86-shift
    (arity 4 4)
    (effect effect)
    (semantics "Arguments operation,width,destination-operand,count. Mask count to 5 bits for width32 or 6 for width64; zero count preserves destination and flags. For nonzero count set result and CF to last shifted bit, ZF/SF/PF from result, AF undefined; OF defined only for count1: SHL=msb(result) xor CF, SHR=old msb, SAR=0. Counts>1 leave OF undefined."))
  (pcode-op nzcv-add
    (arity 3 3)
    (effect flags)
    (semantics "Arguments width,a,b. N=msb(sum), Z=sum==0, C=unsigned carry, V=signed overflow. Results computed modulo width."))
  (pcode-op nzcv-sub
    (arity 3 3)
    (effect flags)
    (semantics "Arguments width,a,b. N=msb(difference), Z=difference==0, C=unsigned a>=b (no borrow), V=signed overflow."))
  (pcode-op nzcv-logic
    (arity 2 2)
    (effect flags)
    (semantics "Arguments width,result. N=msb, Z=result==0, C=V=0."))
  (pcode-op amo
    (arity 5 5)
    (effect memory)
    (semantics "Arguments operation,width,address,new-value,order-bits. Atomic read-modify-write linearizes at one point; returns old value. Order bit1 acquire, bit0 release. Natural alignment required. Faults do not commit. Word results sign-extend on RV64."))
  (pcode-op reserve-load
    (arity 3 3)
    (effect memory)
    (semantics "Arguments width,address,order. Load and establish implementation-defined reservation granule containing address. Word results sign-extend. Natural alignment and access permissions required."))
  (pcode-op conditional-store
    (arity 4 4)
    (effect memory)
    (semantics "Arguments width,address,value,order. Return 0 and store if reservation succeeds; otherwise nonzero and no write. Always clears reservation. Spurious failure is permitted; compiler must loop and obey forward-progress rules."))
  (pcode-op x86-xchg-memory
    (arity 3 3)
    (effect memory)
    (semantics "Arguments width,address,new-value. Implicitly locked exchange; return old value, globally ordered atomic RMW. Does not change arithmetic flags."))
  (pcode-op bvadd
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: modular addition; inputs and result reduced modulo 2^width."))
  (pcode-op bvsub
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: modular subtraction; inputs and result reduced modulo 2^width."))
  (pcode-op bvmul
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: low modular product; inputs and result reduced modulo 2^width."))
  (pcode-op bvand
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: bitwise AND; inputs and result reduced modulo 2^width."))
  (pcode-op bvor
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: bitwise OR; inputs and result reduced modulo 2^width."))
  (pcode-op bvxor
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: bitwise XOR; inputs and result reduced modulo 2^width."))
  (pcode-op bvshl
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: logical left shift; inputs and result reduced modulo 2^width. Shift count >= width yields zero for logical shifts and sign fill for arithmetic shift; instructions explicitly mask counts where required."))
  (pcode-op bvlshr
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: logical right shift; inputs and result reduced modulo 2^width. Shift count >= width yields zero for logical shifts and sign fill for arithmetic shift; instructions explicitly mask counts where required."))
  (pcode-op bvashr
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: arithmetic right shift; inputs and result reduced modulo 2^width. Shift count >= width yields zero for logical shifts and sign fill for arithmetic shift; instructions explicitly mask counts where required."))
  (pcode-op bvudiv
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: unsigned quotient; inputs and result reduced modulo 2^width. Zero divisor yields all-ones quotient or dividend remainder; signed MIN/-1 yields MIN quotient and zero remainder. Targets with trapping division need separate trap checks."))
  (pcode-op bvsdiv
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: signed quotient rounded toward zero; inputs and result reduced modulo 2^width. Zero divisor yields all-ones quotient or dividend remainder; signed MIN/-1 yields MIN quotient and zero remainder. Targets with trapping division need separate trap checks."))
  (pcode-op bvurem
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: unsigned remainder; inputs and result reduced modulo 2^width. Zero divisor yields all-ones quotient or dividend remainder; signed MIN/-1 yields MIN quotient and zero remainder. Targets with trapping division need separate trap checks."))
  (pcode-op bvsrem
    (arity 3 3)
    (effect value)
    (semantics "Arguments width,a,b: signed remainder with dividend sign; inputs and result reduced modulo 2^width. Zero divisor yields all-ones quotient or dividend remainder; signed MIN/-1 yields MIN quotient and zero remainder. Targets with trapping division need separate trap checks."))
