-- amdgpu.dsymspec — AMD GCN/RDNA/CDNA (AMDGPU HSA kernel ABI).
-- Encodings are representative 32/64-bit SOP/VOP/FLAT words, not bit-exact;
-- register file (SGPR/VGPR/AGPR + EXEC/VCC/SCC/M0 + flat_scratch), features
-- (GCN/RDNA/CDNA, wave32/64, FLAT, XNACK), and HSA sections/relocations are
-- accurate. Cross-checked via TableGen AMDGPU target + arch_oracle +
-- ccbe_oracle SIMT/vector-ISA topics.
-- Strata: base(sop) | vop | flat | ds(buffer) | image | cdna-mfma | priv.
local symas = require("backend").new("amdgpu")

symas.target{
    arch = "amdgpu", subarch = "gfx900",
    addr_size = 64, op_size = 32, addr_def = 64, align = 4,
    byte_order = "little", obj_format = "ELF64", abi = "amdgpu-HSA",
    calling_conv = "amdgpu-hsa-kernel",
    features = { "base", "gcn", "wave64" },
}

symas.feature{ name = "base", desc = "scalar SOP base" }
symas.feature{ name = "gcn", desc = "Graphics Core Next" }
symas.feature{ name = "rdna", desc = "RDNA" }
symas.feature{ name = "cdna", desc = "CDNA (matrix cores)" }
symas.feature{ name = "wave32", desc = "32-lane wavefront" }
symas.feature{ name = "wave64", desc = "64-lane wavefront" }
symas.feature{ name = "flat", desc = "flat addressing (FLAT/GLOBAL)" }
symas.feature{ name = "xnack", desc = "execute-mask XNACK" }
symas.feature{ name = "priv", desc = "privileged (s_getreg/s_setreg)" }
symas.feature{ name = "image", desc = "image/memory ops (MUBUF/MTBUF/MIMG)" }
symas.feature{ name = "mfma", desc = "matrix-fused multiply-add (CDNA)" }

for i = 0, 105 do
    symas.register{ name = "s" .. i, class = "gpr", width = 32, enc = i, flags = { "readable", "writable" } }
end
for i = 0, 255 do
    symas.register{ name = "v" .. i, class = "gpr", width = 32, enc = i, flags = { "readable", "writable" } }
end
for i = 0, 255 do
    symas.register{ name = "a" .. i, class = "gpr", width = 32, enc = i, flags = { "readable", "writable" } }
end
symas.register{ name = "exec", class = "mask", width = 64, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "vcc", class = "mask", width = 64, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "scc", class = "status", width = 8, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "m0", class = "special", width = 32, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "flat_scratch", class = "special", width = 64, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "xnack_mask", class = "mask", width = 64, enc = 0, flags = { "readable", "writable" } }
symas.register{ name = "pc", class = "special", width = 64, enc = 0 }

symas.encoder{ name = "s_nop",  source = "emit32le(0xBF800000);", max_bytes = 4 }
symas.encoder{ name = "s_add",  source = "emit32le(0x81000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "s_sub",  source = "emit32le(0x82000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "s_and",  source = "emit32le(0x88000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "s_or",   source = "emit32le(0x8A000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "s_mov",  source = "emit32le(0xBE000000 + dst*16777216 + src0);", max_bytes = 4 }
symas.encoder{ name = "s_branch", source = "emit32le(0xBF800002); emit_relocation(sym, R_AMDGPU_REL32);", max_bytes = 4, max_relocs = 1 }
symas.encoder{ name = "s_cbranch", source = "emit32le(0xBF840000); emit_relocation(sym, R_AMDGPU_REL32);", max_bytes = 4, max_relocs = 1 }
symas.encoder{ name = "s_endpgm", source = "emit32le(0xBF810000);", max_bytes = 4 }
symas.encoder{ name = "s_waitcnt", source = "emit32le(0xBF8C0000 + imm);", max_bytes = 4 }
symas.encoder{ name = "s_barrier", source = "emit32le(0xBF8A0000);", max_bytes = 4 }
symas.encoder{ name = "s_load", source = "emit32le(0xC0000000 + dst*16777216 + src0*256);", max_bytes = 4 }
symas.encoder{ name = "s_store", source = "emit32le(0xC8000000 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "s_getreg", source = "emit32le(0xB0000000 + dst*16777216 + src0);", max_bytes = 4 }
symas.encoder{ name = "v_add",  source = "emit32le(0x4A000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "v_sub",  source = "emit32le(0x4A800000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "v_mul",  source = "emit32le(0x4C000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "v_mov",  source = "emit32le(0x7E000000 + dst*16777216 + src0);", max_bytes = 4 }
symas.encoder{ name = "v_cmp",  source = "emit32le(0x4F000000 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "v_cndmask", source = "emit32le(0x4E000000 + dst*16777216 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "flat_load", source = "emit64le(0xDC50000000000000 + dst*16777216 + src0*4294967296);", max_bytes = 8 }
symas.encoder{ name = "flat_store", source = "emit64le(0xDC70000000000000 + src0*4294967296 + src1*16777216);", max_bytes = 8 }
symas.encoder{ name = "ds_read", source = "emit32le(0xD8000000 + dst*16777216 + src0*256);", max_bytes = 4 }
symas.encoder{ name = "ds_write", source = "emit32le(0xD9000000 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "buffer_load", source = "emit32le(0xE0000000 + dst*16777216 + src0*256);", max_bytes = 4 }
symas.encoder{ name = "buffer_store", source = "emit32le(0xE8000000 + src0*256 + src1);", max_bytes = 4 }
symas.encoder{ name = "image_load", source = "emit32le(0xF0000000 + dst*16777216 + src0*256);", max_bytes = 4 }
symas.encoder{ name = "mfma",   source = "emit64le(0xD000000000000000 + dst*16777216 + src0*4294967296);", max_bytes = 8 }

local function sg() return { kind = "reg", class = "gpr", width = 32 } end
local function wsg() return { kind = "reg", class = "gpr", width = 32, access = "write" } end
local function vg() return { kind = "reg", class = "gpr", width = 32 } end
local function wvg() return { kind = "reg", class = "gpr", width = 32, access = "write" } end

for _, m in ipairs({ "s_nop", "s_add", "s_sub", "s_and", "s_or", "s_mov",
    "s_branch", "s_cbranch", "s_endpgm", "s_waitcnt", "s_barrier",
    "s_load", "s_store", "s_getreg", "v_add", "v_sub", "v_mul", "v_mov",
    "v_cmp", "v_cndmask", "flat_load", "flat_store", "ds_read", "ds_write",
    "buffer_load", "buffer_store", "image_load", "mfma" }) do
    symas.mnemonic{ name = m }
end
symas.form{ mnemonic = "s_nop", encoder = "s_nop" }
symas.form{ mnemonic = "s_add", encoder = "s_add", operands = { wsg(), sg(), sg() } }
symas.form{ mnemonic = "s_sub", encoder = "s_sub", operands = { wsg(), sg(), sg() } }
symas.form{ mnemonic = "s_and", encoder = "s_and", operands = { wsg(), sg(), sg() } }
symas.form{ mnemonic = "s_or",  encoder = "s_or",  operands = { wsg(), sg(), sg() } }
symas.form{ mnemonic = "s_mov", encoder = "s_mov", operands = { wsg(), sg() } }
symas.form{ mnemonic = "s_branch", encoder = "s_branch", flags = { "branch", "terminator", "reloc" }, operands = { { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "s_cbranch", encoder = "s_cbranch", flags = { "cond_branch", "reloc" }, operands = { { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "s_endpgm", encoder = "s_endpgm", flags = { "return", "terminator" } }
symas.form{ mnemonic = "s_waitcnt", encoder = "s_waitcnt", operands = {
    { kind = "imm", width = 16, signed = false, imm_min = 0, imm_max = 65535 } } }
symas.form{ mnemonic = "s_barrier", encoder = "s_barrier" }
symas.form{ mnemonic = "s_load", encoder = "s_load", flags = { "reads_mem" }, operands = { wsg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "s_store", encoder = "s_store", flags = { "writes_mem" }, operands = { sg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "s_getreg", encoder = "s_getreg", required = { "priv" }, flags = { "privileged" }, operands = { wsg(), sg() } }
symas.form{ mnemonic = "v_add", encoder = "v_add", operands = { wvg(), vg(), vg() } }
symas.form{ mnemonic = "v_sub", encoder = "v_sub", operands = { wvg(), vg(), vg() } }
symas.form{ mnemonic = "v_mul", encoder = "v_mul", operands = { wvg(), vg(), vg() } }
symas.form{ mnemonic = "v_mov", encoder = "v_mov", operands = { wvg(), vg() } }
symas.form{ mnemonic = "v_cmp", encoder = "v_cmp", operands = { vg(), vg() } }
symas.form{ mnemonic = "v_cndmask", encoder = "v_cndmask", operands = { wvg(), vg(), vg() } }
symas.form{ mnemonic = "flat_load", encoder = "flat_load", required = { "flat" }, flags = { "reads_mem" },
    operands = { wvg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "flat_store", encoder = "flat_store", required = { "flat" }, flags = { "writes_mem" },
    operands = { vg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "ds_read", encoder = "ds_read", flags = { "reads_mem" }, operands = { wvg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "ds_write", encoder = "ds_write", flags = { "writes_mem" }, operands = { vg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "buffer_load", encoder = "buffer_load", required = { "image" }, flags = { "reads_mem" },
    operands = { wvg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "buffer_store", encoder = "buffer_store", required = { "image" }, flags = { "writes_mem" },
    operands = { vg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "image_load", encoder = "image_load", required = { "image" }, flags = { "reads_mem" },
    operands = { wvg(), { kind = "mem", width = 32 } } }
symas.form{ mnemonic = "mfma", encoder = "mfma", required = { "mfma" }, operands = { wvg(), vg(), vg() } }

symas.syntax{ name = "default", comment = ";", separator = ", " }

symas.section{ name = ".text", flags = { "exec", "alloc", "code" }, align = 4, content = "code" }
symas.section{ name = ".rodata", flags = { "alloc", "readonly", "data" }, align = 4, content = "data" }
symas.section{ name = ".data", flags = { "write", "alloc", "data" }, align = 4, content = "data" }
symas.section{ name = ".AMDGPU.config", flags = { "alloc", "readonly", "meta" }, align = 4, content = "meta" }
symas.section{ name = ".AMDGPU.disasm", flags = { "alloc", "readonly", "meta" }, align = 4, content = "meta" }
symas.section{ name = ".note", flags = { "alloc", "readonly", "meta" }, align = 4, content = "meta" }

symas.linkage{ name = "kernel_entry", binding = "global", visibility = "default", symtype = "func" }
symas.linkage{ name = "func_local", binding = "local", visibility = "default", symtype = "func" }
symas.linkage{ name = "object_global", binding = "global", visibility = "default", symtype = "object" }

symas.reloc{ name = "R_AMDGPU_NONE", width = 32, expr = "S + A" }
symas.reloc{ name = "R_AMDGPU_ABS32", width = 32, expr = "S + A" }
symas.reloc{ name = "R_AMDGPU_ABS64", width = 64, expr = "S + A" }
symas.reloc{ name = "R_AMDGPU_REL32", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_AMDGPU_GOT", width = 64, expr = "GOT(S) + A" }
symas.reloc{ name = "R_AMDGPU_RELATIVE", width = 64, expr = "B + A" }
symas.reloc{ name = "R_AMDGPU_GLOB_DAT", width = 64, expr = "S + A" }

symas.debug{ msg = "amdgpu SIMT: sop+vop+flat/ds/image+mfma stratification", kind = "target", ref = "" }
symas.debug{ msg = "flat forms require flat", kind = "form", ref = "flat_load" }
symas.debug{ msg = "mfma forms require cdna/mfma", kind = "form", ref = "mfma" }

print(symas.emit())
