@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(ZLIB)
find_dependency(Threads)
if(@SANDSTONE_BUILD_COMPILER@)
  find_dependency(Boost CONFIG COMPONENTS json)
endif()
if(@SANDSTONE_BUILD_ASSEMBLER@)
  find_dependency(LibstoneLua CONFIG)
endif()
if(@SANDSTONE_BUILD_SANDSLAB@)
  find_dependency(SandSLAB CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SandstoneTargets.cmake")
