-- RVV 1.0. Register widths are nominal catalog storage widths, not a
-- constraint on the target's VLEN. Optional masks are textual v0.t, while
-- carry and merge mnemonics require an explicit v0 input. Both are normalized
-- as a register number (0), never a direct binding for the inverse vm bit.
local vx = {"v","f","d"}
local vd, vs = vreg(0), vreg(1)
local va = {kind="reg",class="vec",width=128,access="readwrite"}
local function vector(m, base, regs, fields, mask, guards, flags)
    if mask ~= "required" then
        extra(m,regs,(guards or "")..word(base+(mask=="optional" and 33554432 or 0),fields),vx,flags)
    end
    if mask ~= "none" then
        local operands = {}
        for _, operand in ipairs(regs) do operands[#operands+1] = operand end
        local bound_mask = "r"..#operands
        operands[#operands+1] = vs
        extra(m,operands,(guards or "").."require("..bound_mask.." == 0); "..word(base,fields),vx,flags,nil,"_mask")
    end
end
local vtype = "require(r2 % 8 != 4 && (r2/8) % 8 <= 3); "
extra("vsetvl",{dst,src,src},word(0x80007057,rrr),vx)
extra("vsetivli",{dst,unsigned(5),unsigned(8)},vtype..word(0xc0007057,rrr),vx)

-- Unit stride, strided, unordered/ordered indexed, and unit-stride fault
-- only first loads all share the same nf/EEW construction. The spelling
-- bakes in the segment count; it is not a user-supplied bitfield.
for _,size in ipairs({{8,0},{16,5},{32,6},{64,7}}) do
    local eew, funct3 = size[1],size[2]
    for _,mode in ipairs({
        {"vl","vlseg","e",0,0,false},{"vs","vsseg","e",0,0,true},
        {"vl","vlseg","e",0,16,false,nil,"ff"},
        {"vls","vlsseg","e",2,0,false,src},{"vss","vssseg","e",2,0,true,src},
        {"vlux","vluxseg","ei",1,0,false,vs},{"vsux","vsuxseg","ei",1,0,true,vs},
        {"vlox","vloxseg","ei",3,0,false,vs},{"vsox","vsoxseg","ei",3,0,true,vs},
    }) do
        local reg, flags = mode[6] and vs or vd, mode[6] and {"writes_mem"} or {"reads_mem"}
        local regs, fields = {reg,src},rr
        if mode[7] then regs[3]=mode[7]; fields=rrr end
        -- 64-bit index elements are outside the RV32 profile, unlike
        -- 64-bit data elements in unit-stride, strided, and whole loads.
        if not (rv32 and eew == 64 and (mode[4] == 1 or mode[4] == 3)) then
            for n = 1, 8 do
                local m = (n==1 and mode[1] or mode[2]..n)..mode[3]..eew..(mode[8] or "")..".v"
                local base = (mode[6] and 0x27 or 7) + funct3*4096 + mode[4]*67108864 +
                             mode[5]*1048576 + (n-1)*536870912
                if m == "vle32.v" or m == "vse32.v" then
                    added[m] = true
                    extra(m,{reg,src,vs},"require(r2 == 0); "..word(base,rr),vx,flags,nil,"_mask")
                else
                    vector(m,base,regs,fields,"optional",nil,flags)
                end
            end
        end
    end
end
vector("vlm.v",0x02b00007,{vd,src},rr,"none",nil,{"reads_mem"})
vector("vsm.v",0x02b00027,{vs,src},rr,"none",nil,{"writes_mem"})
for _,n in ipairs({1,2,4,8}) do
    local reg_group = aligned("r0",n)
    local base = 0x02800000+(n-1)*536870912
    for _,size in ipairs({{8,0},{16,5},{32,6},{64,7}}) do
        vector("vl"..n.."re"..size[1]..".v",base+7+size[2]*4096,{vd,src},rr,"none",reg_group,{"reads_mem"})
    end
    vector("vl"..n.."r.v",base+7,{vd,src},rr,"none",reg_group,{"reads_mem","aliases"})
    vector("vs"..n.."r.v",base+0x27,{vs,src},rr,"none",reg_group,{"writes_mem"})
    vector("vmv"..n.."r.v",0x9e003057+(n-1)*32768,{vd,vs},"r0*128 + r1*1048576","none",
           reg_group..aligned("r1",n))
end

-- Vector arithmetic opcode inventory follows riscv-opcodes rv_v. Group
-- by textual operand order; accumulators take vs1/rs1 before vs2, while
-- other operations generally take vs2 first. Data and floating scalar
-- operands can occupy the same encoding field but have different classes.
local vr = "r0*128 + r1*1048576"
local vrr = vr.." + r2*32768"
local acc = "r0*128 + r1*32768 + r2*1048576"
local function varith(ops, base_fields, mask, rows)
    for _,op in ipairs(rows) do
        if op[1] == "vadd.vv" then
            added[op[1]] = true
            extra(op[1],{vd,vs,vs,vs},"require(r3 == 0); "..word(op[2],base_fields),vx,nil,nil,"_mask")
        else
            local guards = ""
            if op[1]:find("vslideup",1,true)==1 or op[1]:find("slide1up",1,true) or op[1]:find("vrgather",1,true)==1
               or op[1] == "vcompress.vm" then
                guards = "require(r0 != r1); "
                if op[1]=="vrgather.vv" or op[1]=="vrgatherei16.vv" or op[1]=="vcompress.vm" then
                    guards = guards.."require(r0 != r2); "
                end
            end
            if op[1]:find("vadc.",1,true)==1 or op[1]:find("vsbc.",1,true)==1 then guards = nz("r0") end
            vector(op[1],op[2],ops,base_fields,mask,guards)
        end
    end
end
