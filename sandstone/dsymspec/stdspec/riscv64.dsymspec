-- Shared RISC-V instruction bank: RV32GC / RV64GC, plus the RV64IM profile.
-- Data: domainlet/bekern/arch/_arch_specs.py; encodings: RISC-V ISA manual
-- (unpriv + priv + vector), cross-checked via arch_oracle / tablegen_inquiry
-- (RISCVFeatures.td: FeatureStdExtM/A/F/D/C/V, Zba/Zbb/Zbs/Zbkb, Zk*, Zfh,
-- Zfa, Zicond, Zihintpause, Zicsr, Zifencei) and isa_reference RV64 quick spec
-- (x0-x31 ABI roles, R/I/S/B/U/J formats).
-- Operand names used by encoders: rd, rs1, rs2, imm, sym, id.
-- Opcode inventory: riscv/riscv-opcodes cdd4192b1e0215a305f2f610a820fa43e6694290.
-- Strata: base I | M | A | F/D | C | Zb*/Zk* | V | Zicsr/Zifencei/priv.
local profile = ...
local rv32, im = profile == "rv32gc", profile == "rv64im"
local xlen = rv32 and 32 or 64
local arch = rv32 and "riscv32" or "riscv64"
local symas = require("backend").new(arch)
local form = symas.form
symas.form = function(record)
    local required = {"i"}
    for _, feature in ipairs(record.required or {}) do required[#required+1]=feature end
    record.required = required
    return form(record)
end

symas.target{
    arch = arch, subarch = rv32 and "rv32gc" or im and "rv64im" or "rv64gc",
    addr_size = xlen, op_size = 32, addr_def = xlen, align = im and 4 or 2,
    byte_order = "little", obj_format = rv32 and "ELF32" or "ELF64",
    abi = rv32 and "ILP32D" or im and "LP64" or "LP64D",
    calling_conv = rv32 and "ilp32d" or im and "lp64" or "lp64d",
    features = im and { "i", "m" } or { "i", "m", "a", "f", "d", "c", "zicsr", "zifencei" },
}

-- Base + M/A/F/D/C (as before) plus stratified extensions.
symas.feature{ name = "i", desc = "Base integer, XLEN=" .. xlen }
symas.feature{ name = "m", desc = "integer multiply/divide" }
symas.feature{ name = "a", desc = "atomic (lr/sc/amo)" }
symas.feature{ name = "f", desc = "single-precision floating point" }
symas.feature{ name = "d", desc = "double-precision floating point" }
symas.feature{ name = "c", desc = "compressed (16-bit) instructions" }
symas.feature{ name = "zicsr", desc = "control and status registers" }
symas.feature{ name = "zifencei", desc = "instruction-fetch fence" }
symas.feature{ name = "v", desc = "vector extension (RVV 1.0; requires F and D)" }
symas.feature{ name = "zba", desc = "address-generation (sh*add)" }
symas.feature{ name = "zbb", desc = "basic bit-manipulation" }
symas.feature{ name = "zbs", desc = "single-bit instructions" }
symas.feature{ name = "zbkb", desc = "bitmanip for cryptography" }
symas.feature{ name = "zknd", desc = "NIST AES decryption" }
symas.feature{ name = "zkne", desc = "NIST AES encryption" }
symas.feature{ name = "zknh", desc = "NIST hash (SHA2-256/512)" }
symas.feature{ name = "zfh", desc = "half-precision floating point" }
symas.feature{ name = "zfa", desc = "additional floating-point instructions" }
symas.feature{ name = "zicond", desc = "integer conditional ops (czero)" }
symas.feature{ name = "zihintpause", desc = "pause hint" }
symas.feature{ name = "priv", desc = "privileged (mret/sret/wfi/sfence)" }

-- General-purpose registers x0..x31.
for i = 0, 31 do
    symas.register{ name = "x" .. i, class = "gpr", width = xlen, enc = i,
                    flags = i == 0 and { "readable" } or { "readable", "writable" } }
end
-- Floating-point registers f0..f31.
for i = 0, 31 do
    symas.register{ name = "f" .. i, class = "fp", width = 64, enc = i,
                    flags = { "readable", "writable" } }
end
-- ABI aliases (isa_reference RV64 quick spec roles).
local function alias(name, class, width, enc, base)
    symas.register{ name = name, class = class, width = width, enc = enc,
                    parent = base .. enc, sub_lo = 0, sub_hi = width,
                    flags = name == "zero" and { "readable" } or { "readable", "writable" } }
end
local abi_gprs = {
    "zero","ra","sp","gp","tp","t0","t1","t2","s0","s1","a0","a1","a2","a3","a4","a5",
    "a6","a7","s2","s3","s4","s5","s6","s7","s8","s9","s10","s11","t3","t4","t5","t6",
}
local abi_fprs = {
    "ft0","ft1","ft2","ft3","ft4","ft5","ft6","ft7","fs0","fs1","fa0","fa1","fa2","fa3","fa4","fa5",
    "fa6","fa7","fs2","fs3","fs4","fs5","fs6","fs7","fs8","fs9","fs10","fs11","ft8","ft9","ft10","ft11",
}
for i, name in ipairs(abi_gprs) do alias(name, "gpr", xlen, i-1, "x") end
for i, name in ipairs(abi_fprs) do alias(name, "fp", 64, i-1, "f") end
alias("fp", "gpr", xlen, 8, "x")
-- Vector registers v0..v31 (RVV; VLEN-agnostic, modelled as 128-bit).
for i = 0, 31 do
    symas.register{ name = "v" .. i, class = "vec", width = 128, enc = i,
                    flags = { "readable", "writable" } }
end
-- CSRs as control-class registers (readable/writable subset).
local function csr(name, address, mode)
    local flags = { "readable" }
    if address < 0xc00 then table.insert(flags, "writable") end
    if mode then table.insert(flags, "modedep") end
    symas.register{ name = name, class = "ctrl", width = xlen, enc = address, flags = flags }
end
for _, c in ipairs({
    {"fflags",0x001},{"frm",0x002},{"fcsr",0x003},{"cycle",0xc00},{"time",0xc01},{"instret",0xc02},
    {"vstart",0x008},{"vxsat",0x009},{"vxrm",0x00a},{"vcsr",0x00f},{"vl",0xc20},{"vtype",0xc21},{"vlenb",0xc22},
    {"sstatus",0x100},{"sie",0x104},{"stvec",0x105},{"sscratch",0x140},{"sepc",0x141},
    {"scounteren",0x106},{"senvcfg",0x10a},{"scause",0x142},{"stval",0x143},{"sip",0x144},{"satp",0x180},
    {"mstatus",0x300},{"misa",0x301},{"medeleg",0x302},{"mideleg",0x303},{"mie",0x304},
    {"mtvec",0x305},{"mscratch",0x340},{"mepc",0x341},{"mcause",0x342},{"mtval",0x343},{"mip",0x344},
    {"mcounteren",0x306},{"menvcfg",0x30a},{"mcountinhibit",0x320},{"mcycle",0xb00},{"minstret",0xb02},
    {"mvendorid",0xf11},{"marchid",0xf12},{"mimpid",0xf13},{"mhartid",0xf14},{"mconfigptr",0xf15},
}) do csr(c[1],c[2],c[2]>=0x100 and c[2]<0xc00 or c[2]>=0xf00) end
for i = 3, 31 do
    csr("hpmcounter"..i,0xc00+i); csr("mhpmcounter"..i,0xb00+i,true); csr("mhpmevent"..i,0x320+i,true)
    if rv32 then csr("hpmcounter"..i.."h",0xc80+i); csr("mhpmcounter"..i.."h",0xb80+i,true) end
end
for i = 0, 63 do csr("pmpaddr"..i,0x3b0+i,true) end
for i = 0, 15, rv32 and 1 or 2 do csr("pmpcfg"..i,0x3a0+i,true) end
if rv32 then
    csr("cycleh",0xc80); csr("timeh",0xc81); csr("instreth",0xc82); csr("mstatush",0x310,true)
    csr("mcycleh",0xb80,true); csr("minstreth",0xb82,true); csr("menvcfgh",0x31a,true)
end
symas.register{ name = "pc", class = "special", width = xlen, enc = 0 }

-- Encoder inputs r0..r4 follow textual operand order, except the documented
-- GAS normalization of effective addresses to register + signed displacement.
-- The original recipes retain their published rd/rs1/rs2/imm bindings.
local function check_reg(name)
    return "require("..name.." >= 0 && "..name.." <= 31); "
end
local named_rr = check_reg("rd")..check_reg("rs1")
local named_rrr = named_rr..check_reg("rs2")
local positional_rr = check_reg("r0")..check_reg("r1")
local positional_rrr = positional_rr..check_reg("r2")
local function named_r(m, base)
    symas.encoder{name=m, source=named_rrr..
        "emit32le("..base.." + rd*128 + rs1*32768 + rs2*1048576);", max_bytes=4}
end
-- Base R-type ALU.
symas.encoder{ name = "nop", source = "emit32le(0x00000013);", max_bytes = 4 }
for _,op in ipairs({{"add",0x33},{"sub",0x40000033},{"sll",0x1033},{"slt",0x2033},{"sltu",0x3033},
                    {"xor",0x4033},{"srl",0x5033},{"sra",0x40005033},{"or",0x6033},{"and",0x7033}}) do
    named_r(op[1],op[2])
end
-- Base I-type.
symas.encoder{ name = "addi", source = positional_rr.."require(r2 >= -2048 && r2 <= 2047); emit32le(0x00000013 + r0*128 + r1*32768 + ((r2 + 4096) % 4096)*1048576);", max_bytes = 4 }
symas.encoder{ name = "li",   source = check_reg("r0").."require(r1 >= -2048 && r1 <= 2047); emit32le(0x00000013 + r0*128 + ((r1 + 4096) % 4096)*1048576);", max_bytes = 4 }
symas.encoder{ name = "lui",  source = check_reg("r0").."require(r1 >= 0 && r1 <= 1048575); emit32le(0x00000037 + r0*128 + r1*4096);", max_bytes = 4 }
symas.encoder{ name = "auipc", source = check_reg("r0").."require(r1 >= 0 && r1 <= 1048575); emit32le(0x00000017 + r0*128 + r1*4096);", max_bytes = 4 }
-- Loads / stores (word, double, byte, half).
local function memory_form(m, base, store)
    local offset = "((imm + 4096) % 4096)"
    local fields = store and ("r0*1048576 + ("..offset.." % 32)*128 + ("..offset.." / 32)*33554432")
                         or ("rd*128 + "..offset.."*1048576")
    symas.encoder{ name = m, max_bytes = 4, source = check_reg(store and "r0" or "rd")..check_reg("rs1")..
        "require(imm >= -2048 && imm <= 2047); emit32le("..
        base.." + rs1*32768 + "..fields..");" }
end
for i,m in ipairs({"lb","lh","lw","ld","lbu","lhu","lwu"}) do
    if not rv32 or (m ~= "ld" and m ~= "lwu") then memory_form(m, 3+(i-1)*4096, false) end
end
for i,m in ipairs({"sb","sh","sw","sd"}) do
    if not rv32 or m ~= "sd" then memory_form(m, 35+(i-1)*4096, true) end
end
-- Control transfer.
symas.encoder{ name = "jalr", source = positional_rr.."require(r2 >= -2048 && r2 <= 2047); emit32le(0x00000067 + r0*128 + r1*32768 + ((r2 + 4096) % 4096)*1048576);", max_bytes = 4 }
symas.encoder{ name = "jal", source = check_reg("rd").."emit_relocation(sym, R_RISCV_JAL); emit32le(0x0000006F + rd*128);", max_bytes = 4, max_relocs = 1 }
for _,op in ipairs({{"beq",0x0063},{"bne",0x1063},{"blt",0x4063},{"bge",0x5063}}) do
    symas.encoder{name=op[1],source=positional_rr.."emit_relocation(sym, R_RISCV_BRANCH); emit32le("..
        op[2].." + r0*32768 + r1*1048576);",max_bytes=4,max_relocs=1}
end
symas.encoder{ name = "ret",  source = "emit32le(0x00008067);", max_bytes = 4 }
-- M extension.
named_r("mul",0x02000033); named_r("div",0x02004033); named_r("rem",0x02006033)
-- Zicsr / fences / priv.
symas.encoder{ name = "fence", source = "emit32le(0x0FF0000F);", max_bytes = 4 }
symas.encoder{ name = "fencei", source = "emit32le(0x0000100F);", max_bytes = 4 }
symas.encoder{ name = "ecall", source = "emit32le(0x00000073);", max_bytes = 4 }
symas.encoder{ name = "ebreak", source = "emit32le(0x00100073);", max_bytes = 4 }
symas.encoder{ name = "mret", source = "emit32le(0x30200073);", max_bytes = 4 }
symas.encoder{ name = "wfi",  source = "emit32le(0x10500073);", max_bytes = 4 }
-- Zb* / Zicond / pause.
named_r("andn",0x40007033); named_r("sh1add",0x20002033); named_r("czeroeqz",0x0e005033)
symas.encoder{ name = "bseti", source = positional_rr.."require(r2 >= 0 && r2 < "..xlen.."); emit32le(0x28001013 + r0*128 + r1*32768 + r2*1048576);", max_bytes = 4 }
symas.encoder{ name = "pause", source = "emit32le(0x0100000F);", max_bytes = 4 }
-- Original encoders kept under their public names; the full banks follow.
symas.encoder{ name = "vaddvv", source = positional_rrr.."emit32le(0x02000057 + r0*128 + r2*32768 + r1*1048576);", max_bytes = 4 }
symas.encoder{ name = "vle32v", source = positional_rr.."emit32le(0x02006007 + r0*128 + r1*32768);", max_bytes = 4 }
symas.encoder{ name = "vse32v", source = positional_rr.."emit32le(0x02006027 + r0*128 + r1*32768);", max_bytes = 4 }
symas.encoder{ name = "vsetvli", source = positional_rr.."require(r2 >= 0 && r2 <= 255 && r2%8 != 4 && (r2/8)%8 <= 3); emit32le(0x00007057 + r0*128 + r1*32768 + r2*1048576);", max_bytes = 4 }
-- Original compressed encoders.
symas.encoder{ name = "caddi", source = check_reg("r0").."require(r0 != 0 && r1 >= -32 && r1 <= 31 && r1 != 0); emit16le(0x0001 + r0*128 + ((r1 + 64) % 32)*4 + (r1 < 0)*4096);", max_bytes = 2 }
symas.encoder{ name = "cnop",  source = "emit16le(0x0001);", max_bytes = 2 }

local function reg()
    return { kind = "reg", class = "gpr", width = xlen, access = "read" }
end
local function rreg(pos)
    return { kind = "reg", class = "gpr", width = xlen, access = pos == 0 and "write" or "read" }
end
local function freg(pos)
    local a = "read"
    if pos == 0 then a = "write" end
    return { kind = "reg", class = "fp", width = 64, access = a }
end
local function vreg(pos)
    local a = "read"
    if pos == 0 then a = "write" end
    return { kind = "reg", class = "vec", width = 128, access = a }
end

for _, m in ipairs({ "nop", "add", "sub", "and", "or", "xor", "sll", "srl", "sra",
    "slt", "sltu", "addi", "li", "lui", "auipc", "jalr", "jal", "beq", "bne", "blt", "bge", "ret",
    "mul", "div", "rem", "fence", "fence.i", "ecall", "ebreak", "mret", "wfi",
    "andn", "sh1add", "bseti", "czero.eqz", "pause", "vadd.vv", "vle32.v",
    "vse32.v", "vsetvli", "c.addi", "c.nop" }) do
    symas.mnemonic{ name = m }
end

symas.form{ mnemonic = "nop", encoder = "nop" }
symas.form{ mnemonic = "add", encoder = "add", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "sub", encoder = "sub", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "and", encoder = "and", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "or",  encoder = "or",  operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "xor", encoder = "xor", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "sll", encoder = "sll", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "srl", encoder = "srl", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "sra", encoder = "sra", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "slt", encoder = "slt", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "sltu", encoder = "sltu", operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "addi", encoder = "addi", operands = { rreg(0,64), reg(64),
    { kind = "imm", width = 12, signed = true, imm_min = -2048, imm_max = 2047 } } }
symas.form{ mnemonic = "li", encoder = "li", operands = { rreg(0,64),
    { kind = "imm", width = 12, signed = true, imm_min = -2048, imm_max = 2047 } } }
symas.form{ mnemonic = "lui", encoder = "lui", operands = { rreg(0), { kind = "imm", width = 20, imm_min = 0, imm_max = 1048575 } } }
symas.form{ mnemonic = "auipc", encoder = "auipc", operands = { rreg(0), { kind = "imm", width = 20, imm_min = 0, imm_max = 1048575 } } }
local signed12 = {kind="imm", width=12, signed=true, imm_min=-2048, imm_max=2047}
local loads_stores = {"lb","lh","lw","lbu","lhu","sb","sh","sw"}
if not rv32 then for _, m in ipairs({"ld","lwu","sd"}) do table.insert(loads_stores, m) end end
for _,m in ipairs(loads_stores) do
    symas.mnemonic{name=m}
    local store = string.sub(m,1,1) == "s"
    symas.form{mnemonic=m, encoder=m, operands={store and reg(64) or rreg(0,64),reg(64),signed12},
        flags={store and "writes_mem" or "reads_mem"}}
end
symas.form{ mnemonic = "jalr", encoder = "jalr", flags = { "branch" }, operands = { rreg(0,64), reg(64),
    { kind = "imm", width = 12, signed = true, imm_min = -2048, imm_max = 2047 } } }
symas.form{ mnemonic = "jal", encoder = "jal", flags = { "branch", "reloc" }, operands = { rreg(0), { kind = "sym", width = xlen } } }
symas.form{ mnemonic = "beq", encoder = "beq", flags = { "cond_branch", "reloc" }, operands = { reg(64), reg(64),
    { kind = "sym", width = xlen } } }
symas.form{ mnemonic = "bne", encoder = "bne", flags = { "cond_branch", "reloc" }, operands = { reg(64), reg(64),
    { kind = "sym", width = xlen } } }
symas.form{ mnemonic = "blt", encoder = "blt", flags = { "cond_branch", "reloc" }, operands = { reg(64), reg(64),
    { kind = "sym", width = xlen } } }
symas.form{ mnemonic = "bge", encoder = "bge", flags = { "cond_branch", "reloc" }, operands = { reg(64), reg(64),
    { kind = "sym", width = xlen } } }
symas.form{ mnemonic = "ret", encoder = "ret", flags = { "return", "terminator" } }
symas.form{ mnemonic = "mul", encoder = "mul", required = { "m" }, operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "div", encoder = "div", required = { "m" }, operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "rem", encoder = "rem", required = { "m" }, operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "fence", encoder = "fence" }
symas.form{ mnemonic = "fence.i", encoder = "fencei", required = { "zifencei" } }
symas.form{ mnemonic = "ecall", encoder = "ecall", flags = { "may_trap" } }
symas.form{ mnemonic = "ebreak", encoder = "ebreak", flags = { "may_trap" } }
symas.form{ mnemonic = "mret", encoder = "mret", required = { "priv" }, flags = { "privileged", "return", "terminator" } }
symas.form{ mnemonic = "wfi", encoder = "wfi", required = { "priv" }, flags = { "privileged" } }
symas.form{ mnemonic = "andn", encoder = "andn", required = { "zbb" },
    operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "sh1add", encoder = "sh1add", required = { "zba" },
    operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "bseti", encoder = "bseti", required = { "zbs" },
    operands = { rreg(0,64), reg(64),
        { kind = "imm", width = rv32 and 5 or 6, imm_min = 0, imm_max = xlen-1 } } }
symas.form{ mnemonic = "czero.eqz", encoder = "czeroeqz", required = { "zicond" },
    operands = { rreg(0,64), reg(64), reg(64) } }
symas.form{ mnemonic = "pause", encoder = "pause", required = { "zihintpause" } }
symas.form{ mnemonic = "vadd.vv", encoder = "vaddvv", required = { "v", "f", "d" },
    operands = { vreg(0), vreg(1), vreg(1) } }
symas.form{ mnemonic = "vle32.v", encoder = "vle32v", required = { "v", "f", "d" }, flags = { "reads_mem" },
    operands = { vreg(0), reg() } }
symas.form{ mnemonic = "vse32.v", encoder = "vse32v", required = { "v", "f", "d" }, flags = { "writes_mem" },
    operands = { vreg(1), reg() } }
symas.form{ mnemonic = "vsetvli", encoder = "vsetvli", required = { "v", "f", "d" },
    operands = { rreg(0,64), reg(64),
        { kind = "imm", width = 8, imm_min = 0, imm_max = 255 } } }
symas.form{ mnemonic = "c.addi", encoder = "caddi", required = { "c" }, operands = {
    {kind="reg",class="gpr",width=xlen,access="readwrite"},
    { kind = "imm", width = 6, signed = true, imm_min = -32, imm_max = 31 } } }
symas.form{ mnemonic = "c.nop", encoder = "cnop", required = { "c" } }

-- Gas normalization supplies ordinary register/immediate operands. All
-- instruction words and relocation kinds are chosen by the compiled bank.
local dst, src, symbol = rreg(0), reg(), {kind="sym",width=xlen}
local added = {fence=true,li=true}
local function extra(m, operands, body, required, flags, size, suffix)
    if not added[m] then symas.mnemonic{name=m}; added[m]=true end
    local name=m..(suffix or "")
    local guards = ""
    for i, operand in ipairs(operands) do
        local r = "r"..(i-1)
        if operand.kind == "reg" then
            local max = operand.class == "ctrl" and 4095 or 31
            guards = guards.."require("..r.." >= 0 && "..r.." <= "..max.."); "
        elseif operand.kind == "imm" and operand.imm_min ~= nil then
            guards = guards.."require("..r.." >= "..operand.imm_min.." && "..r.." <= "..operand.imm_max.."); "
        end
    end
    symas.encoder{name=name, source=guards..body, max_bytes=size or 4,
        max_relocs=body:find("emit_relocation",1,true) and 1 or 0}
    symas.form{mnemonic=m, encoder=name, operands=operands, required=required,flags=flags}
end
local function word(base, fields)
    return ("emit32le(0x%08x%s);"):format(base, fields and " + "..fields or "")
end
local function unsigned(bits)
    return {kind="imm",width=bits,imm_min=0,imm_max=(1<<bits)-1}
end
local function signed(bits)
    local half = 1<<(bits-1)
    return {kind="imm",width=bits,signed=true,imm_min=-half,imm_max=half-1}
end
-- A slice is {source low bit, bit count, destination low bit}; arithmetic
-- spelling works in the standalone recipe interpreter as well as in the DSL.
local function scatter(value, slices)
    local fields = "0"
    for _, s in ipairs(slices) do
        fields = fields.." + (("..value..")/"..(1<<s[1]).." % "..(1<<s[2])..")*"..(1<<s[3])
    end
    return fields
end
local function relative(value, bits, slices)
    return scatter(value.."+"..(1<<bits),slices)
end
local function aligned(value, alignment)
    return "require("..value.." % "..alignment.." == 0); "
end
local rr = "r0*128 + r1*32768"
local rrr = rr.." + r2*1048576"
local i12 = rr.." + ((r2+4096)%4096)*1048576"
for _,op in ipairs({{"mulh",0x02001033},{"mulhsu",0x02002033},{"mulhu",0x02003033},
                    {"divu",0x02005033},{"remu",0x02007033}}) do
    extra(op[1],{dst,src,src},word(op[2],rrr),{"m"})
end
for _,op in ipairs({{"slti",0x2013},{"sltiu",0x3013},{"xori",0x4013},{"ori",0x6013},{"andi",0x7013}}) do
    extra(op[1],{dst,src,signed12},"require(r2 >= -2048 && r2 <= 2047); "..word(op[2],i12))
end
local function shift(m, opcode, bits, required)
    extra(m,{dst,src,unsigned(bits)},("require(r2 >= 0 && r2 < %d); "):format(1<<bits)..word(opcode,rrr),required)
end
for _,op in ipairs({{"slli",0x1013},{"srli",0x5013},{"srai",0x40005013}}) do
    shift(op[1],op[2],rv32 and 5 or 6)
end
if not rv32 then
    for _,op in ipairs({{"addw",0x3b},{"subw",0x4000003b},{"sllw",0x103b},{"srlw",0x503b},{"sraw",0x4000503b}}) do
        extra(op[1],{dst,src,src},word(op[2],rrr))
    end
    for _,op in ipairs({{"mulw",0x0200003b},{"divw",0x0200403b},{"divuw",0x0200503b},
                       {"remw",0x0200603b},{"remuw",0x0200703b}}) do
        extra(op[1],{dst,src,src},word(op[2],rrr),{"m"})
    end
    extra("addiw",{dst,src,signed12},"require(r2 >= -2048 && r2 <= 2047); "..word(0x1b,i12))
    shift("slliw",0x101b,5); shift("srliw",0x501b,5); shift("sraiw",0x4000501b,5)
else
    -- The RV32 source path has no GAS li expansion. Materialize the full
    -- 32-bit bit pattern with rounded LUI and an optional signed low ADDI.
    local low = "((r1+4294967296)%4096)"
    local high = "(((r1+4294967296+2048)/4096)%1048576)"
    extra("li",{dst,{kind="imm",width=32,signed=true,imm_min=-2147483648,imm_max=4294967295}},
        "require(r1 >= -2147483648 && r1 <= 4294967295 && (r1 < -2048 || r1 > 2047)); "..
        "if (r1 >= 4294965248) {"..word(0x13,"r0*128 + "..low.."*1048576").."} else {"..
        word(0x37,"r0*128 + "..high.."*4096")..
        "if ("..low.." != 0) {"..word(0x13,"r0*32896 + "..low.."*1048576").."}}",
        nil,{"aliases"},8,"_wide")
end
extra("fence",{unsigned(4),unsigned(4)},"require(r0 >= 0 && r0 <= 15 && r1 >= 0 && r1 <= 15); "..
    word(0xf,"r0*16777216 + r1*1048576"),nil,nil,nil,"_pred_succ")
-- Four-bit FENCE sets are I=8, O=4, R=2, W=1. Do not expose reserved
-- fm/rd/rs1 fields as operands; FENCE.TSO is the defined fm=8 case.
extra("fence.tso",{},word(0x8330000f))
extra("sret",{},word(0x10200073),{"priv"},{"privileged","return","terminator"})
extra("sfence.vma",{src,src},word(0x12000073,"r0*32768 + r1*1048576"),{"priv"},{"privileged"})
extra("sfence.vma",{src},word(0x12000073,"r0*32768"),{"priv"},{"privileged"},nil,"_rs1")
extra("sfence.vma",{},word(0x12000073),{"priv"},{"privileged"},nil,"_all")

local b_scatter = {{12,1,31},{5,6,25},{1,4,8},{11,1,7}}
local j_scatter = {{20,1,31},{1,10,21},{11,1,20},{12,8,12}}
local b_regs = "r0*32768 + r1*1048576"
local function branch(m, opcode, textual, registers, alias)
    local numeric, symbolic = {}, {}
    for _, operand in ipairs(textual) do
        numeric[#numeric+1] = operand; symbolic[#symbolic+1] = operand
    end
    local field = "r"..#numeric
    numeric[#numeric+1] = signed(13); symbolic[#symbolic+1] = symbol
    extra(m,numeric,aligned(field,2)..word(opcode,registers.." + "..relative(field,13,b_scatter)),
          nil,alias and {"cond_branch","aliases"} or {"cond_branch"},nil,"_offset")
    if alias or m == "bgeu" or m == "bltu" then
        extra(m,symbolic,"emit_relocation(sym, R_RISCV_BRANCH); "..word(opcode,registers),
              nil,alias and {"cond_branch","aliases","reloc"} or {"cond_branch","reloc"})
    end
end
for _,op in ipairs({{"beq",0x0063},{"bne",0x1063},{"blt",0x4063},{"bge",0x5063},
                    {"bltu",0x6063},{"bgeu",0x7063}}) do
    added[op[1]] = op[1] ~= "bgeu" and op[1] ~= "bltu"
    branch(op[1],op[2],{src,src},b_regs,false)
end
for _,op in ipairs({{"bgt",0x4063},{"ble",0x5063},{"bgtu",0x6063},{"bleu",0x7063}}) do
    branch(op[1],op[2],{src,src},"r1*32768 + r0*1048576",true)
end
added.jal = true
extra("jal",{dst,signed(21)},aligned("r1",2)..word(0x6f,"r0*128 + "..relative("r1",21,j_scatter)),
      nil,{"branch"},nil,"_offset")
extra("jal",{symbol},"emit_relocation(sym, R_RISCV_JAL); "..word(0xef),nil,{"branch","reloc","aliases"},nil,"_ra")
extra("jal",{signed(21)},aligned("r0",2)..word(0xef,relative("r0",21,j_scatter)),
      nil,{"branch","aliases"},nil,"_ra_offset")
extra("mv",{dst,src},word(0x13,rr),nil,{"aliases"})
extra("not",{dst,src},word(0xfff04013,rr),nil,{"aliases"})
extra("neg",{dst,src},word(0x40000033,"r0*128 + r1*1048576"),nil,{"aliases"})
extra("seqz",{dst,src},word(0x00103013,rr),nil,{"aliases"})
extra("snez",{dst,src},word(0x00003033,"r0*128 + r1*1048576"),nil,{"aliases"})
extra("sltz",{dst,src},word(0x2033,rr),nil,{"aliases"})
extra("sgtz",{dst,src},word(0x2033,"r0*128 + r1*1048576"),nil,{"aliases"})
if not rv32 then
    extra("negw",{dst,src},word(0x4000003b,"r0*128 + r1*1048576"),nil,{"aliases"})
    extra("sext.w",{dst,src},word(0x1b,rr),nil,{"aliases"})
end
added.jalr = true
extra("jalr",{src},word(0xe7,"r0*32768"),nil,{"aliases","branch"},nil,"_ra")
extra("jalr",{dst,src},word(0x67,rr),nil,{"aliases","branch"},nil,"_no_offset")
extra("jr",{src},word(0x67,"r0*32768"),nil,{"aliases","branch","terminator"})
extra("jr",{src,signed12},word(0x67,"r0*32768 + ((r1+4096)%4096)*1048576"),
      nil,{"aliases","branch","terminator"},nil,"_offset")
extra("j",{symbol},"emit_relocation(sym, R_RISCV_JAL); "..word(0x6f),nil,{"aliases","branch","terminator","reloc"})
extra("j",{signed(21)},aligned("r0",2)..word(0x6f,relative("r0",21,j_scatter)),
      nil,{"aliases","branch","terminator"},nil,"_offset")
for _,op in ipairs({{"beqz",0x0063},{"bnez",0x1063},{"bltz",0x4063},{"bgez",0x5063}}) do
    branch(op[1],op[2],{src},"r0*32768",true)
end
branch("bgtz",0x4063,{src},"r0*1048576",true)
branch("blez",0x5063,{src},"r0*1048576",true)
extra("call", {symbol}, "emit_relocation(sym, R_RISCV_CALL_PLT); emit32le(0x97); emit32le(0x80e7);",
      nil, {"branch","reloc","aliases"}, 8)
for _,op in ipairs({{"rv_pcrel_hi", "R_RISCV_PCREL_HI20"},{"rv_got_hi","R_RISCV_GOT_HI20"}}) do
    extra(op[1], {dst,symbol}, "emit_relocation(sym, "..op[2].."); "..word(0x17,"r0*128"), nil, {"reloc"})
end
for _,op in ipairs({{"rv_pcrel_jalr",0x67},{"rv_pcrel_addi",0x13},
                     {rv32 and "rv_pcrel_lw" or "rv_pcrel_ld",rv32 and 0x2003 or 0x3003}}) do
    extra(op[1], {dst,src,symbol}, "emit_relocation(sym, R_RISCV_PCREL_LO12_I); "..word(op[2],rr),
          nil,{"reloc"})
end

-- A extension. The address operand is a base register (no displacement
-- bits); clients normalize the architectural `(rs1)` notation.
for _,width in ipairs(rv32 and {32} or {32,64}) do
    for _,order in ipairs({{"",0},{".rl",1},{".aq",2},{".aqrl",3}}) do
        for _,op in ipairs({{"amoadd",0},{"amoswap",1},{"lr",2},{"sc",3},{"amoxor",4},
                            {"amoor",8},{"amoand",12},{"amomin",16},{"amomax",20},
                            {"amominu",24},{"amomaxu",28}}) do
            local load, store = op[1]=="lr", op[1]=="sc"
            local name = op[1]..(width==32 and ".w" or ".d")..order[1]
            local base = 0x2f + (width==32 and 2 or 3)*4096 + (op[2]*4+order[2])*33554432
            extra(name,load and {dst,src} or {dst,src,src},
                word(base,load and rr or "r0*128 + r2*32768 + r1*1048576"),
                {"a"},load and {"reads_mem"} or store and {"writes_mem"} or {"reads_mem","writes_mem"})
        end
    end
end

-- Zicsr numeric and named CSR forms. Zero source in CSRRS/CSRRC is permitted
-- for read-only CSRs; read-only CSR writes otherwise trap at execution time.
local ctl = {kind="reg",class="ctrl",width=xlen}
for _,kind in ipairs({{ctl,"_named"},{unsigned(12),"_numeric"}}) do
    for _,op in ipairs({{"csrrw","csrw",1},{"csrrs","csrs",2},{"csrrc","csrc",3},
                        {"csrrwi","csrwi",5},{"csrrsi","csrsi",6},{"csrrci","csrci",7}}) do
        local base, input = 0x73 + op[3]*4096, op[3] < 5 and src or unsigned(5)
        extra(op[1],{dst,kind[1],input},word(base,"r0*128 + r1*1048576 + r2*32768"),
              {"zicsr"},{"may_trap"},nil,kind[2])
        extra(op[2],{kind[1],input},word(base,"r0*1048576 + r1*32768"),
              {"zicsr"},{"aliases","may_trap"},nil,kind[2])
    end
    extra("csrr",{dst,kind[1]},word(0x2073,"r0*128 + r1*1048576"),
          {"zicsr"},{"aliases","may_trap"},nil,kind[2])
end

-- F/D/Zfh/Zfa. The normalized rm operand is the architectural three-bit
-- rounding field (rne/rtz/rdn/rup/rmm = 0..4, dyn = 7; 5 and 6 reserved).
-- Omitted rm is dyn except for exact widening conversions, where it is rne.
local fw,fr = freg(0),freg(1)
local fs = {{ "s",0,{"f"},"flw","fsw",0x2000 },
            { "d",1,{"f","d"},"fld","fsd",0x3000 },
            { "h",2,{"f","zfh"},"flh","fsh",0x1000 }}
local function rounded(m, base, fields, operands, ext, exact)
    extra(m,operands,word(base+(exact and 0 or 0x7000),fields),ext)
    local with_rm = {}
    for _, operand in ipairs(operands) do with_rm[#with_rm+1] = operand end
    local rm = "r"..#with_rm
    with_rm[#with_rm+1] = unsigned(3)
    extra(m,with_rm,"require("..rm.." <= 4 || "..rm.." == 7); "..
          word(base,fields.." + "..rm.."*4096"),ext,nil,nil,"_rm")
end
for _,fp in ipairs(fs) do
    local fmt, fmt_bits, ext, suffix = fp[1],fp[2]*33554432,fp[3],"."..fp[1]
    local off = "((r2+4096)%4096)"
    extra(fp[4],{fw,src,signed12},word(fp[6]+7,i12),ext,{"reads_mem"})
    extra(fp[5],{fr,src,signed12},word(fp[6]+0x27,
        "r0*1048576 + r1*32768 + ("..off.." % 32)*128 + ("..off.."/32)*33554432"),ext,{"writes_mem"})
    for _,op in ipairs({{"fadd",0},{"fsub",1},{"fmul",2},{"fdiv",3}}) do
        rounded(op[1]..suffix,0x53+op[2]*134217728+fmt_bits,rrr,{fw,fr,fr},ext)
    end
    rounded("fsqrt"..suffix,0x58000053+fmt_bits,rr,{fw,fr},ext)
    for i,m in ipairs({"fmadd","fmsub","fnmsub","fnmadd"}) do
        rounded(m..suffix,0x3f+i*4+fmt_bits,rrr.." + r3*134217728",{fw,fr,fr,fr},ext)
    end
    for _,op in ipairs({{"fsgnj",0x20000053},{"fsgnjn",0x20001053},{"fsgnjx",0x20002053},
                        {"fmin",0x28000053},{"fmax",0x28001053},{"feq",0xa0002053,dst},
                        {"flt",0xa0001053,dst},{"fle",0xa0000053,dst}}) do
        extra(op[1]..suffix,{op[3] or fw,fr,fr},word(op[2]+fmt_bits,rrr),ext)
    end
    for i,m in ipairs({"fmv","fneg","fabs"}) do
        extra(m..suffix,{fw,fr},word(0x20000053+fmt_bits+(i-1)*4096,"r0*128 + r1*1081344"),ext,{"aliases"})
    end
    extra("fclass"..suffix,{dst,fr},word(0xe0001053+fmt_bits,rr),ext)
    if fmt ~= "d" or not rv32 then
        local move = fmt == "s" and "w" or fmt
        extra("fmv.x."..move,{dst,fr},word(0xe0000053+fmt_bits,rr),ext)
        extra("fmv."..move..".x",{fw,src},word(0xf0000053+fmt_bits,rr),ext)
    end
    for i,m in ipairs(rv32 and {"w","wu"} or {"w","wu","l","lu"}) do
        local int_bits = (i-1)*1048576
        rounded("fcvt."..m..suffix,0xc0000053+fmt_bits+int_bits,rr,{dst,fr},ext)
        rounded("fcvt"..suffix.."."..m,0xd0000053+fmt_bits+int_bits,rr,{fw,src},ext,fmt=="d" and i<=2)
    end
    local zfa = {"zfa"}
    for _,f in ipairs(ext) do zfa[#zfa+1] = f end
    -- The caller maps the textual floating constant to its fli table index.
    extra("fli"..suffix,{fw,unsigned(5)},word(0xf0100053+fmt_bits,rr),zfa)
    for _,op in ipairs({{"fminm",0x28002053},{"fmaxm",0x28003053},
                        {"fleq",0xa0004053,dst},{"fltq",0xa0005053,dst}}) do
        extra(op[1]..suffix,{op[3] or fw,fr,fr},word(op[2]+fmt_bits,rrr),zfa)
    end
    rounded("fround"..suffix,0x40400053+fmt_bits,rr,{fw,fr},zfa)
    rounded("froundnx"..suffix,0x40500053+fmt_bits,rr,{fw,fr},zfa)
end
for _,op in ipairs({{"s","d",0,1,{"f","d"}},{"d","s",1,0,{"f","d"},true},
                    {"s","h",0,2,{"f","zfh"},true},{"h","s",2,0,{"f","zfh"}},
                    {"d","h",1,2,{"f","d","zfh"},true},{"h","d",2,1,{"f","d","zfh"}}}) do
    rounded("fcvt."..op[1].."."..op[2],0x40000053+op[3]*33554432+op[4]*1048576,rr,{fw,fr},op[5],op[6])
end
extra("fcvtmod.w.d",{dst,fr,{kind="imm",width=3,imm_min=1,imm_max=1}},
      word(0xc2801053,rr),{"zfa","f","d"})
if rv32 then
    extra("fmvh.x.d",{dst,fr},word(0xe2100053,rr),{"zfa","f","d"})
    extra("fmvp.d.x",{fw,src,src},word(0xb2000053,rrr),{"zfa","f","d"})
end

-- C / C+D / RV32 C+F. Textual memory operands are normalized to
-- (value, base, byte displacement). The compact register banks take
-- architectural register numbers 8..15, not pre-subtracted indices.
local c, cd, cf = {"c"}, {"c","f","d"}, {"c","f"}
local rw = {kind="reg",class="gpr",width=xlen,access="readwrite"}
local function half(base, fields)
    return ("emit16le(0x%04x%s);"):format(base,fields and " + "..fields or "")
end
local function compact(r)
    return "require("..r.." >= 8 && "..r.." <= 15); "
end
local function nz(r)
    return "require("..r.." != 0); "
end
local function sp(r)
    return "require("..r.." == 2); "
end
local ci = {{0,5,2},{5,1,12}}
added["c.nop"] = true
extra("c.nop",{signed(6)},half(1,relative("r0",6,ci)),c,{"aliases"},2,"_hint")
extra("c.li",{dst,signed(6)},nz("r0")..half(0x4001,"r0*128 + "..relative("r1",6,ci)),c,nil,2)
extra("c.addi4spn",{dst,src,unsigned(10)},compact("r0")..sp("r1")..nz("r2")..aligned("r2",4)..
      half(0,"(r0-8)*4 + "..scatter("r2",{{2,1,6},{3,1,5},{4,2,11},{6,4,7}})),c,nil,2)
extra("c.addi16sp",{rw,signed(10)},sp("r0")..nz("r1")..aligned("r1",16)..
      half(0x6101,relative("r1",10,{{4,1,6},{5,1,2},{6,1,5},{7,2,3},{9,1,12}})),c,nil,2)
-- LLVM/GNU spelling uses the sign-extended 20-bit LUI immediate.
extra("c.lui",{dst,unsigned(20)},nz("r0").."require(r0 != 2 && ((r1 >= 1 && r1 <= 31) || r1 >= 1048544)); "..
      half(0x6001,"r0*128 + "..scatter("r1",ci)),c,nil,2)
extra("c.andi",{rw,signed(6)},compact("r0")..half(0x8801,"(r0-8)*128 + "..relative("r1",6,ci)),c,nil,2)
local c_shift = unsigned(rv32 and 5 or 6)
for _,op in ipairs({{"c.srli",0x8001},{"c.srai",0x8401}}) do
    extra(op[1],{rw,c_shift},compact("r0")..nz("r1")..half(op[2],"(r0-8)*128 + "..scatter("r1",ci)),c,nil,2)
end
extra("c.slli",{rw,c_shift},nz("r0")..nz("r1")..half(0x0002,"r0*128 + "..scatter("r1",ci)),c,nil,2)
for _,op in ipairs({{"c.sub",0x8c01},{"c.xor",0x8c21},{"c.or",0x8c41},{"c.and",0x8c61},
                    {"c.subw",0x9c01,true},{"c.addw",0x9c21,true}}) do
    if not op[3] or not rv32 then
        extra(op[1],{rw,src},compact("r0")..compact("r1")..half(op[2],"(r0-8)*128 + (r1-8)*4"),c,nil,2)
    end
end
if not rv32 then
    extra("c.addiw",{rw,signed(6)},nz("r0")..half(0x2001,"r0*128 + "..relative("r1",6,ci)),c,nil,2)
end
extra("c.mv",{dst,src},nz("r0")..nz("r1")..half(0x8002,"r0*128 + r1*4"),c,nil,2)
extra("c.add",{rw,src},nz("r0")..nz("r1")..half(0x9002,"r0*128 + r1*4"),c,nil,2)
extra("c.jr",{src},nz("r0")..half(0x8002,"r0*128"),c,{"branch","terminator"},2)
extra("c.jalr",{src},nz("r0")..half(0x9002,"r0*128"),c,{"branch"},2)
extra("c.ebreak",{},half(0x9002),c,{"may_trap"},2)

local cj = {{11,1,12},{4,1,11},{8,2,9},{10,1,8},{6,1,7},{7,1,6},{1,3,3},{5,1,2}}
local cb = {{8,1,12},{3,2,10},{6,2,5},{1,2,3},{5,1,2}}
for _,op in ipairs({{"c.j",0xa001},{"c.jal",0x2001,true}}) do
    if not op[3] or rv32 then
        local flags = op[3] and {"branch"} or {"branch","terminator"}
        extra(op[1],{signed(12)},aligned("r0",2)..half(op[2],relative("r0",12,cj)),c,flags,2,"_offset")
        extra(op[1],{symbol},"emit_relocation(sym, R_RISCV_RVC_JUMP); "..half(op[2]),c,
              op[3] and {"branch","reloc"} or {"branch","terminator","reloc"},2)
    end
end
for _,op in ipairs({{"c.beqz",0xc001},{"c.bnez",0xe001}}) do
    extra(op[1],{src,signed(9)},compact("r0")..aligned("r1",2)..
          half(op[2],"(r0-8)*128 + "..relative("r1",9,cb)),c,{"cond_branch"},2,"_offset")
    extra(op[1],{src,symbol},compact("r0").."emit_relocation(sym, R_RISCV_RVC_BRANCH); "..
          half(op[2],"(r0-8)*128"),c,{"cond_branch","reloc"},2)
end

for _,op in ipairs({{"lw","sw",2,6,4,c,dst,src},
                    {"fld","fsd",1,5,8,cd,fw,fr},
                    {rv32 and "flw" or "ld",rv32 and "fsw" or "sd",3,7,rv32 and 4 or 8,
                     rv32 and cf or c,rv32 and fw or dst,rv32 and fr or src}}) do
    local load, store, lfun, sfun, scale, ext, ldreg, streg = op[1],op[2],op[3],op[4],op[5],op[6],op[7],op[8]
    local off = scale == 4 and {{2,1,6},{3,3,10},{6,1,5}} or {{3,3,10},{6,2,5}}
    local limit = unsigned(scale == 4 and 7 or 8)
    local common = compact("r0")..compact("r1")..aligned("r2",scale)
    local compact_addr = "(r0-8)*4 + (r1-8)*128 + "..scatter("r2",off)
    extra("c."..load,{ldreg,src,limit},common..half(lfun*8192,compact_addr),ext,{"reads_mem"},2)
    extra("c."..store,{streg,src,limit},common..half(sfun*8192,compact_addr),ext,{"writes_mem"},2)
    local sp_load = scale == 4 and {{2,3,4},{5,1,12},{6,2,2}} or {{3,2,5},{5,1,12},{6,3,2}}
    local sp_store = scale == 4 and {{2,4,9},{6,2,7}} or {{3,3,10},{6,3,7}}
    local splimit = unsigned(scale == 4 and 8 or 9)
    local sp_common = sp("r1")..aligned("r2",scale)
    extra("c."..load.."sp",{ldreg,src,splimit},sp_common..(ldreg.class=="gpr" and nz("r0") or "")..
          half(lfun*8192+2,"r0*128 + "..scatter("r2",sp_load)),ext,{"reads_mem"},2)
    extra("c."..store.."sp",{streg,src,splimit},sp_common..
          half(sfun*8192+2,"r0*4 + "..scatter("r2",sp_store)),ext,{"writes_mem"},2)
end

-- Scalar bit manipulation and crypto. Shared encodings have independent
-- forms for their alternative required-feature sets; enabling just one
-- of the features suffices (required lists themselves are conjunctions).
local zb = {"zbb"}
local kb = {"zbkb"}
local function r3(m, opcode, ext, suffix)
    extra(m,{dst,src,src},word(opcode,rrr),ext,nil,nil,suffix)
end
