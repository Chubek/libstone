-- Lanai 32-bit big-endian target. C ABI normally passes arguments on stack;
-- inreg/fastcc use r6/r7/r18/r19. See emitted CC_Lanai32 and CC_Lanai32_Fast.
-- Encodings checked with llvm-mc -triple=lanai -show-encoding. Memory
-- addressing is normalized to a base register and separate signed offset;
-- native Lanai uses offset[%base]. No register-index/update modes here.
local symas = require("backend").new("lanai")
symas.target{ arch = "lanai", subarch = "lanai", addr_size = 32, op_size = 32,
    addr_def = 32, align = 4, byte_order = "big", obj_format = "ELF32",
    abi = "Lanai32", calling_conv = "lanai32", features = { "base" } }
symas.feature{ name = "base", desc = "Lanai 32-bit integer ISA" }
for i = 0, 31 do
    local flags = { "readable", "writable" }
    if i < 2 then flags = { "readable" } end
    symas.register{ name = "r" .. i, class = "gpr", width = 32, enc = i, flags = flags }
end
for _, a in ipairs({ { "pc", 2 }, { "sp", 4 }, { "fp", 5 }, { "rv", 8 },
    { "rr1", 10 }, { "rr2", 11 }, { "rca", 15 } }) do
    symas.register{ name = a[1], class = "gpr", width = 32, enc = a[2],
        parent = "r" .. a[2], sub_lo = 0, sub_hi = 32 }
end
symas.register{ name = "sw", class = "status", width = 32, enc = 0 }
local r = { kind = "reg", class = "gpr", width = 32 }
local wr = { kind = "reg", class = "gpr", width = 32, access = "write" }
local function imm(width,lo,hi,constraint)
    return {kind="imm",width=width,imm_min=lo,imm_max=hi,signed=lo<0,constraint=constraint}
end
local function fit(n,lo,hi) return ("require(%s >= %s && %s <= %s); "):format(n,lo,n,hi) end
local function gr(n) return fit(n,0,31) end
local function emit(op,fields) return ("emit32be(0x%08x%s); "):format(op,fields or "") end
local declared = {}
local function form(name,tag,ops,code,flags,relo)
    if not declared[name] then symas.mnemonic{ name = name }; declared[name] = true end
    local enc = tag and (name .. "_" .. tag) or name
    symas.encoder{ name = enc, source = code, max_bytes = 4, max_relocs = relo or 0 }
    symas.form{ mnemonic = name, encoder = enc, operands = ops, flags = flags }
end
for _, op in ipairs({ {"add",0,0x00000000},{"addc",0x100},{"sub",0x200,0x20000000},
    {"subb",0x300},{"and",0x400,0x40000000},{"or",0x500,0x50000000},
    {"xor",0x600,0x60000000},{"sh",0x780} }) do
    form(op[1],"rrr",{r,r,wr},gr("a") .. gr("b") .. gr("c") ..
        emit(0xc0000000+op[2]," + a*262144 + b*2048 + c*8388608"),
        (op[1] == "addc" or op[1] == "subb") and {"implicit_ops"} or nil)
    if op[3] then
        local and_op = op[1] == "and"
        local lo, hi = and_op and 4294901760 or 0, and_op and 4294967295 or 65535
        local low = imm(32,lo,hi,"low sixteen-bit immediate; upper half is implicit")
        local high = imm(32,65536,4294967295,"high sixteen-bit immediate; lower half is implicit")
        local check = gr("a") .. gr("c")
        form(op[1],"ilo",{r,low,wr},check .. fit("b",lo,hi) ..
            emit(op[3]," + a*262144 + c*8388608 + b%65536"))
        form(op[1],"ihi",{r,high,wr},check .. fit("b",65536,4294967295) ..
            ("require(b%%65536 == %d); "):format(and_op and 65535 or 0) ..
            emit(op[3]+65536," + a*262144 + c*8388608 + b/65536"))
    end
end
form("mov","rr",{r,wr},gr("a") .. gr("b") .. emit(0xc0000000," + a*262144 + b*8388608"))
form("mov","ilo",{imm(16,0,65535),wr},fit("a",0,65535) .. gr("b") ..
    emit(0," + b*8388608 + a"))
form("mov","ihi",{imm(32,65536,4294967295),wr},fit("a",65536,4294967295) ..
    "require(a % 65536 == 0); " .. gr("b") .. emit(0x00010000," + b*8388608 + a/65536"))
form("nop",nil,nil,emit(1))
-- The architectural return is LD -4[FP], PC; RET here is its normalized alias.
form("ret","alias",nil,emit(0x8116fffc),{"return","terminator","reads_mem","implicit_ops","delayed"})
local boff = imm(16,-32768,32767,"signed byte displacement; native offset[%base] syntax")
local function dc(n) return fit(n,-32768,32767) end
form("ld","baseoff",{boff,r,wr},gr("b") .. gr("c") .. dc("a") ..
    emit(0x80020000," + c*8388608 + b*262144 + (a+65536)%65536"),{"reads_mem"})
form("st","baseoff",{r,boff,r},gr("a") .. gr("c") .. dc("b") ..
    emit(0x90020000," + a*8388608 + c*262144 + (b+65536)%65536"),{"writes_mem"})
local abs = imm(25,0,33554428,"word-aligned absolute byte address; low bits retain condition flags")
for _, op in ipairs({ {"bt",0xe0000000},{"bf",0xe0000001},{"beq",0xe6000001},
    {"bne",0xe6000000},{"bgt",0xee000000},{"blt",0xec000001} }) do
    local flags = op[1] == "bt" and {"branch","terminator","delayed"} or {"cond_branch","delayed","implicit_ops"}
    form(op[1],"abs",{abs},fit("a",0,33554428) .. "require(a % 4 == 0); " .. emit(op[2]," + a"),flags)
    local simb = {table.unpack(flags)}; simb[#simb+1] = "reloc"
    form(op[1],"sym",{{kind="sym",width=32}},
        "emit_relocation(sym, R_LANAI_25); " .. emit(op[2]),simb,1)
end
symas.syntax{ name = "default", reg_prefix = "%", comment = "!", separator = ", " }
symas.section{ name = ".text", flags = { "exec", "alloc", "code" }, align = 4, content = "code" }
symas.section{ name = ".data", flags = { "write", "alloc", "data" }, align = 4, content = "data" }
symas.section{ name = ".bss", flags = { "write", "alloc", "zerofill", "data" }, align = 4, content = "data" }
-- R_LANAI_25 is absolute, not PC-relative (LLVM LanaiAsmBackend; ELF RELA).
symas.reloc{ name = "R_LANAI_25", width = 25, expr = "(S + A) & 0x1fffffc" }
symas.reloc{ name = "R_LANAI_32", width = 32, expr = "S + A" }
symas.reloc{ name = "R_LANAI_HI16", width = 16, expr = "(S + A) >> 16" }
symas.reloc{ name = "R_LANAI_LO16", width = 16, expr = "(S + A) & 0xffff" }
print(symas.emit())
