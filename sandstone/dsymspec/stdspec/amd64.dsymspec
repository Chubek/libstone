end

-- Floating-point SSE/SSE2 and their AVX equivalents. The scalar memory
-- width is not the width of the containing XMM register.
local ps={"ps","",0,"sse",128}
local pd={"pd","66",1,"sse2",128}
local ss={"ss","f3",2,"sse",32}
local sd={"sd","f2",3,"sse2",64}
local function vec2(name,opcode,prefix,feature,memw,imm,access)
    local fs=type(feature)=="table" and feature or {feature}
    for _,k in ipairs{"v128","m"..memw} do
        local args={"v128",k}
        if imm then args[3]="i8" end
        legacy(name,args,1,0,opcode,prefix,false,
            {features=fs,imm=imm and 1 or nil,imm_policy="unsigned",access=access or "readwrite"})
    end
end
for _,a in ipairs{
    {"add","58"},{"mul","59"},{"sub","5c"},{"min","5d"},{"div","5e"},{"max","5f"},
    {"sqrt","51",true},{"cmp","c2",false,true},
    {"rsqrt","52",true,false,"single"},{"rcp","53",true,false,"single"},
    {"and","54",false,false,"packed"},{"andn","55",false,false,"packed"},
    {"or","56",false,false,"packed"},{"xor","57",false,false,"packed"},
    {"unpckl","14",false,false,"packed"},{"unpckh","15",false,false,"packed"},
    {"shuf","c6",false,true,"packed"},
} do
    local flavors=a[5]=="packed" and {ps,pd} or a[5]=="single" and {ps,ss} or {ps,pd,ss,sd}
    for _,f in ipairs(flavors) do
        local name=a[1]..f[1]
        local scalar=f[5]<128
        vec2(name,"0f"..a[2],f[2],f[4],f[5],a[4],a[3] and not scalar and "write" or "readwrite")
        for _,w in ipairs(scalar and {128} or {128,256}) do
            local r="v"..w
            for _,src in ipairs{r,"m"..(scalar and f[5] or w)} do
                local unary=a[3] and not scalar
                local args=unary and {r,src} or {r,r,src}
                if a[4] then args[#args+1]="i8" end
                vex("v"..name,args,unary and 1 or 2,0,unary and -1 or 1,1,f[3],false,w==256 and 1 or 0,
                    a[2],{features={"avx"},imm=a[4] and 1 or nil,imm_policy="unsigned",access="write"})
            end
        end
    end
end
for _,a in ipairs{{"movaps","28","29",ps},{"movapd","28","29",pd},{"movups","10","11",ps},
    {"movupd","10","11",pd},{"movdqa","6f","7f",pd},{"movdqu","6f","7f",ss},
    {"movss","10","11",ss},{"movsd","10","11",sd}} do
    local name,load,store,f=table.unpack(a)
    local scalar=f[5]<128 and name~="movdqu"
    local m="m"..(scalar and f[5] or 128)
    local feature=name=="movdqu" and "sse2" or f[4]
    legacy(name,{"v128","v128"},1,0,"0f"..load,f[2],false,{features={feature},access=scalar and "readwrite" or "write"})
    legacy(name,{"v128",m},1,0,"0f"..load,f[2],false,{features={feature},access="write"})
    legacy(name,{m,"v128"},0,1,"0f"..store,f[2],false,{features={feature},access="write"})
    for _,w in ipairs(scalar and {128} or {128,256}) do
        local r,mem,l="v"..w,"m"..(scalar and f[5] or w),w==256 and 1 or 0
        if scalar then
            vex("v"..name,{r,r,r},2,0,1,1,f[3],false,l,load,{features={"avx"},access="write"})
        else
            vex("v"..name,{r,r},1,0,-1,1,f[3],false,l,load,{features={"avx"},access="write"})
        end
        vex("v"..name,{r,mem},1,0,-1,1,f[3],false,l,load,{features={"avx"},access="write"})
        vex("v"..name,{mem,r},0,1,-1,1,f[3],false,l,store,{features={"avx"},access="write"})
    end
end
for _,a in ipairs{{"comis","2f"},{"ucomis","2e"}} do
    for _,w in ipairs{32,64} do
        local d=w==64
        local name=a[1]..(d and "d" or "s")
        vec2(name,"0f"..a[2],d and "66" or "",d and "sse2" or "sse",w,false,"read")
        for _,k in ipairs{"v128","m"..w} do
            vex("v"..name,{"v128",k},1,0,-1,1,d and 1 or 0,false,0,a[2],{features={"avx"},access="read"})
        end
    end
end
for _,f in ipairs{ss,sd} do
    local to=f[1]
    local from=to=="ss" and "sd" or "ss"
    vec2("cvt"..from.."2"..to,"0f5a",from=="ss" and "f3" or "f2","sse2",from=="ss" and 32 or 64)
    for _,w in ipairs{32,64} do
        local r,wide="r"..w,w==64
        local name="cvtsi2"..to
        for _,k in ipairs{r,"m"..w} do
            legacy(name,{"v128",k},1,0,"0f2a",f[2],wide,{features={f[4]},att=wide and name.."q" or name.."l"})
            vex("v"..name,{"v128","v128",k},2,0,1,1,f[3],wide,0,"2a",{features={"avx"},access="write"})
        end
        for _,a in ipairs{{"cvt","2d"},{"cvtt","2c"}} do
            local result=a[1]..to.."2si"
            for _,k in ipairs{"v128","m"..f[5]} do
                legacy(result,{r,k},1,0,"0f"..a[2],f[2],wide,
                    {features={f[4]},access="write",att=wide and result.."q" or result.."l"})
                vex("v"..result,{r,k},1,0,-1,1,f[3],wide,0,a[2],{features={"avx"},access="write"})
            end
        end
    end
end
for _,a in ipairs{
    {"cvtps2pd","5a","",64},{"cvtpd2ps","5a","66",128},{"cvtdq2ps","5b","",128},
    {"cvtps2dq","5b","66",128},{"cvttps2dq","5b","f3",128},{"cvtdq2pd","e6","f3",64},
    {"cvtpd2dq","e6","f2",128},{"cvttpd2dq","e6","66",128},
    {"pshufd","70","66",128,true},{"pshuflw","70","f2",128,true},{"pshufhw","70","f3",128,true},
} do vec2(a[1],"0f"..a[2],a[3],"sse2",a[4],a[5],"write") end
for _,a in ipairs{{"movmskps","50","", "sse"},{"movmskpd","50","66","sse2"},{"pmovmskb","d7","66","sse2"}} do
    legacy(a[1],{"r32","v128"},1,0,"0f"..a[2],a[3],false,{features={a[4]},access="write"})
end
legacy("pmovmskb",{"r32","q64"},1,0,"0fd7","",false,{features={"sse","mmx"},access="write"})
for _,a in ipairs{{"movntps","2b","","sse"},{"movntpd","2b","66","sse2"},{"movntdq","e7","66","sse2"},
    {"movntq","e7","","sse"}} do
    local mm=a[1]=="movntq"
    legacy(a[1],{mm and "m64" or "m128",mm and "q64" or "v128"},0,1,"0f"..a[2],a[3],false,
        {features=mm and {a[4],"mmx"} or {a[4]},access="write"})
end
for _,a in ipairs{{"movlps","12","13",0},{"movhps","16","17",0},{"movlpd","12","13",1},{"movhpd","16","17",1}} do
    local p,fs=a[4]==1 and "66" or "",a[4]==1 and {"sse2"} or {"sse"}
    legacy(a[1],{"v128","m64"},1,0,"0f"..a[2],p,false,{features=fs,access="readwrite"})
    legacy(a[1],{"m64","v128"},0,1,"0f"..a[3],p,false,{features=fs,access="write"})
    vex("v"..a[1],{"v128","v128","m64"},2,0,1,1,a[4],false,0,a[2],{features={"avx"},access="write"})
    vex("v"..a[1],{"m64","v128"},0,1,-1,1,a[4],false,0,a[3],{features={"avx"},access="write"})
end
for _,a in ipairs{{"movhlps","12"},{"movlhps","16"}} do
    legacy(a[1],{"v128","v128"},1,0,"0f"..a[2],"",false,{features={"sse"},access="readwrite"})
    vex("v"..a[1],{"v128","v128","v128"},2,0,1,1,0,false,0,a[2],{features={"avx"},access="write"})
end
for _,a in ipairs{{"movd",32},{"movq",64}} do
    for _,vr in ipairs{"q64","v128"} do
        local mm=vr=="q64"
        local feat=mm and {"mmx"} or {"sse2"}
        local prefix=mm and "" or "66"
        local gpr,w="r"..a[2],a[2]==64
        for _,src in ipairs{gpr,"m"..a[2]} do
            legacy(a[1],{vr,src},1,0,"0f6e",prefix,w,{features=feat,access="write"})
            legacy(a[1],{src,vr},0,1,"0f7e",prefix,w,{features=feat,access="write"})
        end
        if a[2]==64 then
            local regload,regpre=mm and "0f6f" or "0f7e",mm and "" or "f3"
            local store,storepre=mm and "0f7f" or "0fd6",mm and "" or "66"
            legacy("movq",{vr,vr},1,0,regload,regpre,false,{features=feat,access="write"})
            legacy("movq",{vr,"m64"},1,0,regload,regpre,false,{features=feat,access="write",id="_packed"})
            legacy("movq",{"m64",vr},0,1,store,storepre,false,{features=feat,access="write",id="_packed"})
        end
    end
end
legacy("movdq2q",{"q64","v128"},1,0,"0fd6","f2",false,{features={"sse2","mmx"},access="write"})
legacy("movq2dq",{"v128","q64"},1,0,"0fd6","f3",false,{features={"sse2","mmx"},access="write"})
fixed("emms","0f77",{"mmx"})

-- Packed integer MMX/SSE2 and AVX; absent MMX feature marks XMM-only ops.
for _,a in ipairs{
    {"packsswb","63","mmx"},{"packssdw","6b","mmx"},{"packuswb","67","mmx"},
    {"punpcklbw","60","mmx"},{"punpcklwd","61","mmx"},{"punpckldq","62","mmx"},{"punpcklqdq","6c"},
    {"punpckhbw","68","mmx"},{"punpckhwd","69","mmx"},{"punpckhdq","6a","mmx"},{"punpckhqdq","6d"},
    {"paddb","fc","mmx"},{"paddw","fd","mmx"},{"paddd","fe","mmx"},{"paddq","d4","sse2"},
    {"paddsb","ec","mmx"},{"paddsw","ed","mmx"},{"paddusb","dc","mmx"},{"paddusw","dd","mmx"},
    {"psubb","f8","mmx"},{"psubw","f9","mmx"},{"psubd","fa","mmx"},{"psubq","fb","sse2"},
    {"psubsb","e8","mmx"},{"psubsw","e9","mmx"},{"psubusb","d8","mmx"},{"psubusw","d9","mmx"},
    {"pmullw","d5","mmx"},{"pmulhw","e5","mmx"},{"pmulhuw","e4","sse"},{"pmuludq","f4","sse2"},{"pmaddwd","f5","mmx"},
    {"pand","db","mmx"},{"pandn","df","mmx"},{"por","eb","mmx"},{"pxor","ef","mmx"},
    {"pavgb","e0","sse"},{"pavgw","e3","sse"},{"psadbw","f6","sse"},
    {"pcmpeqb","74","mmx"},{"pcmpeqw","75","mmx"},{"pcmpeqd","76","mmx"},
    {"pcmpgtb","64","mmx"},{"pcmpgtw","65","mmx"},{"pcmpgtd","66","mmx"},
    {"pminub","da","sse"},{"pminsw","ea","sse"},{"pmaxub","de","sse"},{"pmaxsw","ee","sse"},
    {"psllw","f1","mmx",true},{"pslld","f2","mmx",true},{"psllq","f3","mmx",true},
    {"psrlw","d1","mmx",true},{"psrld","d2","mmx",true},{"psrlq","d3","mmx",true},
    {"psraw","e1","mmx",true},{"psrad","e2","mmx",true},
} do
    vec2(a[1],"0f"..a[2],"66","sse2",128)
    if a[3] then
        local mf=a[3]=="mmx" and {"mmx"} or {"mmx",a[3]}
        local mem=a[1]:sub(1,7)=="punpckl" and "m32" or "m64"
        for _,k in ipairs{"q64",mem} do
            legacy(a[1],{"q64",k},1,0,"0f"..a[2],"",false,{features=mf,access="readwrite"})
        end
    end
    for _,w in ipairs{128,256} do
        local r="v"..w
        for _,k in ipairs{a[4] and "v128" or r,"m"..(a[4] and 128 or w)} do
            vex("v"..a[1],{r,r,k},2,0,1,1,1,false,w==256 and 1 or 0,a[2],
                {features=w==256 and {"avx","avx2"} or {"avx"},access="write"})
        end
    end
end
for _,a in ipairs{{"psrlw","71",2},{"psraw","71",4},{"psllw","71",6},
