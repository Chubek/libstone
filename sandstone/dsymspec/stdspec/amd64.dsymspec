end
for _,a in ipairs{{"rdsspd",1,32},{"rdsspq",1,64},{"incsspd",5,32},{"incsspq",5,64}} do
    legacy(a[1],{"r"..a[3]},0,-a[2]-1,a[2]==1 and "0f1e" or "0fae","f3",a[3]==64,{features={"cet"}})
end
for _,a in ipairs{{"wrssd",32,"f6",""},{"wrssq",64,"f6",""},{"wrussd",32,"f5","66"},{"wrussq",64,"f5","66"}} do
    local ispriv=a[3]=="f5"
    legacy(a[1],{"m"..a[2],"r"..a[2]},0,1,"0f38"..a[3],a[4],a[2]==64,
        {features=ispriv and {"cet","priv"} or {"cet"},flags=ispriv and {"privileged"} or {},access="write"})
end
legacy("rstorssp",{"m64"},0,-6,"0f01","f3",false,{features={"cet"}})
legacy("clrssbsy",{"m64"},0,-7,"0fae","f3",false,{features={"cet","priv"},flags={"privileged"}})
legacy("senduipi",{"r64"},0,-7,"0fc7","f3",false,{features={"uintr"}})
form("xabort",{"i8"},immediate(8,"unsigned")..bytes("c6f8").."emit8(imm);",
    {imm_policy="unsigned",features={"rtm"}})
for _,w in ipairs{16,32} do
    local p=op66(w).."c7f8"
    form("xbegin",{"i"..w},immediate(w,"signed")..bytes(p).."emit_imm("..(w//8)..",imm);",
        {features={"rtm"},imm_policy="signed",flags={"cond_branch"}})
    form("xbegin",{"a64"},range("addend",-2147483648,2147483647)..bytes(p)..
        "emit_relocation(sym,R_X86_64_PC"..w..",addend-"..(w//8)..");emit_imm("..(w//8)..",0);",
        {id="_rel"..w,features={"rtm"},flags={"cond_branch","reloc"}})
end

-- Descriptor and machine-state forms. The priv feature is a catalog
-- selection policy, not an attempt to model runtime CPL or CR4 checks.
for _,a in ipairs{{"mov","0f20","0f22","c64"},{"mov","0f21","0f23","d64"}} do
    local o={features={"priv"},flags={"privileged"},access="write"}
    legacy(a[1],{"r64",a[4]},0,1,a[2],"",false,o)
    legacy(a[1],{a[4],"r64"},1,0,a[3],"",false,o)
end
for _,a in ipairs{
    {"sgdt",0,"0f01","m80",false},{"sidt",1,"0f01","m80",false},
    {"lgdt",2,"0f01","m80",true},{"lidt",3,"0f01","m80",true},
    {"invlpg",7,"0f01","m8",true},
    {"invlpga",nil,"0f01df",nil,true,"svm"},
    {"sldt",0,"0f00","m16",false},{"str",1,"0f00","m16",false},
    {"lldt",2,"0f00","m16",true},{"ltr",3,"0f00","m16",true},
    {"verr",4,"0f00","m16",false},{"verw",5,"0f00","m16",false},
    {"smsw",4,"0f01","m16",false},{"lmsw",6,"0f01","m16",true},
} do
    local fs=a[6] and {a[6],"priv"} or a[5] and {"priv"} or {}
    local flags=a[5] and {"privileged"} or {}
    if a[2] then
        legacy(a[1],{a[4]},0,-a[2]-1,a[3],"",false,{features=fs,flags=flags})
        if a[4]=="m16" then
            local p=(a[1]=="smsw" or a[1]=="sldt" or a[1]=="str") and "66" or ""
            legacy(a[1],{"r16"},0,-a[2]-1,a[3],p,false,{features=fs,flags=flags})
            if a[1]=="smsw" or a[1]=="sldt" or a[1]=="str" then
                for _,w in ipairs{32,64} do
                    legacy(a[1],{"r"..w},0,-a[2]-1,a[3],"",w==64,{features=fs,flags=flags})
                end
            end
        end
    else fixed(a[1],a[3],fs,flags) end
end
for _,a in ipairs{{"lar","0f02"},{"lsl","0f03"}} do
    for _,w in ipairs{16,32,64} do
        for _,k in ipairs{"m16","r16"} do
            legacy(a[1],{"r"..w,k},1,0,a[2],op66(w),w==64,{access="write",att=sized(a[1],w)})
