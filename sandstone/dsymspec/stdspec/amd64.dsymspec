        legacy(a[1],{r,"i8"},0,-a[3]-1,"0f"..a[2],r=="v128" and "66" or "",false,
            {imm=1,imm_policy="unsigned",access="readwrite",features={r=="v128" and "sse2" or "mmx"}})
    end end
    for _,w in ipairs{128,256} do
        local r="v"..w
        vex("v"..a[1],{r,r,"i8"},1,-a[3]-1,0,1,1,false,w==256 and 1 or 0,a[2],
            {imm=1,imm_policy="unsigned",features=w==256 and {"avx","avx2"} or {"avx"},access="write"})
