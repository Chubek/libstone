for _,a in ipairs{{"sha1nexte","c8"},{"sha1msg1","c9"},{"sha1msg2","ca"},
    {"sha256rnds2","cb"},{"sha256msg1","cc"},{"sha256msg2","cd"}} do
    vec2(a[1],"0f38"..a[2],"","sha",128)
