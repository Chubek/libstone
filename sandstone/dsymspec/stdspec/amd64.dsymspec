for _,a in ipairs{{"vinsertf128","18",false},{"vinserti128","38",true},
    {"vblendps","0c",false},{"vblendpd","0d",false},{"vpblendw","0e",true}} do
    for _,w in ipairs((a[2]=="18" or a[2]=="38") and {256} or {128,256}) do
        local r="v"..w
        local inw=(a[2]=="18" or a[2]=="38") and 128 or w
        for _,k in ipairs{"v"..inw,"m"..inw} do
            vex(a[1],{r,r,k,"i8"},2,0,1,3,1,false,w==256 and 1 or 0,a[2],
