        for _,k in ipairs{r,"m"..w} do
            vex(a[1],{r,r,k},2,0,1,2,1,a[4],w==256 and 1 or 0,a[2],{features=fs,access="write"})
            if a[3] then vex(a[1],{r,k,"i8"},1,0,-1,3,1,a[4],w==256 and 1 or 0,a[3],
                {features=fs,imm=1,imm_policy="unsigned",access="write"}) end
        end
    end
end
for _,a in ipairs{{"vperm2f128","06",false},{"vperm2i128","46",true},{"vpermq","00",true,true},{"vpermpd","01",true,true}} do
    for _,k in ipairs{"v256","m256"} do
