for _,a in ipairs{{"aesenc","dc"},{"aesenclast","dd"},{"aesdec","de"},{"aesdeclast","df"},{"aesimc","db",true}} do
    vec2(a[1],"0f38"..a[2],"66","aes",128,false,a[3] and "write" or "readwrite")
    for _,w in ipairs(a[3] and {128} or {128,256}) do
