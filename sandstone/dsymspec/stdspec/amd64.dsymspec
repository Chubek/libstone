for _,a in ipairs{{"addsubps","d0","f2",3},{"addsubpd","d0","66",1},{"haddps","7c","f2",3},
    {"haddpd","7c","66",1},{"hsubps","7d","f2",3},{"hsubpd","7d","66",1}} do
    vec2(a[1],"0f"..a[2],a[3],"sse3",128)
    for _,w in ipairs{128,256} do
        for _,k in ipairs{"v"..w,"m"..w} do
            vex("v"..a[1],{"v"..w,"v"..w,k},2,0,1,1,a[4],false,w==256 and 1 or 0,a[2],{features={"avx"},access="write"})
        end
    end
end
