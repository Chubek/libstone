    legacy("sha256rnds2",{"v128",k,"v128"},1,0,"0f38cb","",false,
        {features={"sha"},constraints={[3]="xmm0"},check="require(r2 == 0);",access="readwrite"})
end
vec2("sha1rnds4","0f3acc","","sha",128,true)
local gf={{"gf2p8mulb",2,"cf",false},{"gf2p8affineqb",3,"ce",true},{"gf2p8affineinvqb",3,"cf",true}}
for _,a in ipairs(gf) do
    vec2(a[1],(a[2]==2 and "0f38" or "0f3a")..a[3],"66","gfni",128,a[4])
    for _,w in ipairs{128,256} do
        local r="v"..w
        for _,k in ipairs{r,"m"..w} do
            local args={r,r,k}
            if a[4] then args[4]="i8" end
            vex("v"..a[1],args,2,0,1,a[2],1,a[4],w==256 and 1 or 0,a[3],
                {features={"avx","gfni"},imm=a[4] and 1 or nil,imm_policy="unsigned",access="write"})
        end
    end
end

-- EVEX full-vector, scalar, and broadcast tuple sizes. In a normalized
-- memory operand the caller chooses MOD=01 (scaled disp8) or MOD=10
-- (unscaled disp32); the recipe checks divisibility before compressing.
local function evex(name,ops,rm,reg,v,map,pp,w,l,opcode,opt)
    local mem=is_mem(ops,rm)
    local R=extension(ops,reg)
    local R2=operand(reg).."/16"
    local B=extension(ops,rm)
    local X=mem and "x"..rm or operand(rm).."/16"
    local V=v<0 and "0" or operand(v)
    local mask=opt.masking and "mask%8" or "0"
    local zero=opt.masking=="merge-zero" and "+128*(mask/8)" or ""
    local code=registers(ops,31)
    if mem then code=code..address(rm)..addr_prefix(rm) end
    if opt.masking then
        code=code..range("mask",0,opt.masking=="merge-zero" and 15 or 7)
        if opt.masking=="merge-zero" then code=code.."require(mask != 8);" end
    end
    if opt.imm then code=code..immediate(8,"unsigned") end
    code=code..("emit8(0x62);emit8(%d-128*(%s)-64*(%s)-32*(%s)-16*(%s));"..
        "emit8(%d-8*(%s%%16));emit8(%d-8*(%s/16)+%s%s);"):format(
        240+map,R,X,B,R2,124+(w and 128 or 0)+pp,V,
        8+32*l+(opt.broadcast and 16 or 0),V,mask,zero)
    code=code..bytes(opcode)..modrm(ops,rm,field(ops,reg),opt.imm or 0,opt.scale)
    if opt.imm then code=code.."emit8(imm);" end
    form(name,ops,code,opt)
end
local function evfamily(name,ops,rm,reg,v,map,pp,w,vl,opcode,scale,features,broadcast,imm,store)
    if imm then ops[#ops+1]="i8" end
    evex(name,ops,rm,reg,v,map,pp,w,vl,opcode,{scale=scale,features=features,
        id="_evex"..(broadcast and "_bcst" or ""),broadcast=broadcast,imm=imm and 1 or nil,imm_policy="unsigned",
        access=store and "write" or "readwrite",masking=store and "merge" or "merge-zero"})
end
for _,a in ipairs{{"add","58"},{"mul","59"},{"sub","5c"},{"min","5d"},{"div","5e"},{"max","5f"},{"sqrt","51",true}} do
    for _,f in ipairs{ps,pd,ss,sd} do
        local scalar,d=f[5]<128,f[3]%2==1
        local elt=d and 64 or 32
        local unary=a[3] and not scalar
        for _,width in ipairs(scalar and {128} or {128,256,512}) do
            local r="v"..width
            local vl=width==512 and 2 or width==256 and 1 or 0
            local fs=scalar or vl==2
            for _,src in ipairs(scalar and {r,"m"..elt} or {r,"m"..width,"m"..elt}) do
                local bc=not scalar and src=="m"..elt
                local args=unary and {r,src} or {r,r,src}
                evfamily("v"..a[1]..f[1],args,unary and 1 or 2,0,unary and -1 or 1,
                    1,f[3],d,vl,a[2],(bc or scalar) and elt//8 or width//8,
                    fs and {"avx512"} or {"avx512","avx512vl"},bc and width//elt or nil)
            end
        end
    end
end
for _,a in ipairs{{"vmovaps","28","29",0,false},{"vmovapd","28","29",1,true},
    {"vmovups","10","11",0,false},{"vmovupd","10","11",1,true},
    {"vmovdqa32","6f","7f",1,false},{"vmovdqa64","6f","7f",1,true},
    {"vmovdqu32","6f","7f",2,false},{"vmovdqu64","6f","7f",2,true},
    {"vmovdqu8","6f","7f",3,false,"avx512bw"},{"vmovdqu16","6f","7f",3,true,"avx512bw"}} do
    for _,width in ipairs{128,256,512} do
        local r,m="v"..width,"m"..width
        local vl=width==512 and 2 or width==256 and 1 or 0
        local fs=vl==2 and {"avx512"} or {"avx512","avx512vl"}
        if a[6] then fs[#fs+1]=a[6] end
        for _,k in ipairs{r,m} do
            evfamily(a[1],{r,k},1,0,-1,1,a[4],a[5],vl,a[2],width//8,fs)
        end
        evfamily(a[1],{m,r},0,1,-1,1,a[4],a[5],vl,a[3],width//8,fs,nil,nil,true)
    end
end
for _,a in ipairs{
    {"vpaddd","fe",1,1,false},{"vpaddq","d4",1,1,true},{"vpsubd","fa",1,1,false},{"vpsubq","fb",1,1,true},
    {"vpandd","db",1,1,false},{"vpandq","db",1,1,true},{"vpandnd","df",1,1,false},{"vpandnq","df",1,1,true},
    {"vpord","eb",1,1,false},{"vporq","eb",1,1,true},{"vpxord","ef",1,1,false},{"vpxorq","ef",1,1,true},
    {"vpmulld","40",2,1,false},{"vpmullq","40",2,1,true,"avx512dq"},
    {"vaesenc","dc",2,1,false,"vaes",true},{"vaesenclast","dd",2,1,false,"vaes",true},
    {"vaesdec","de",2,1,false,"vaes",true},{"vaesdeclast","df",2,1,false,"vaes",true},
    {"vpclmulqdq","44",3,1,false,"vpclmulqdq",true,true},
    {"vgf2p8mulb","cf",2,1,false,"gfni",false,false,true},
    {"vgf2p8affineqb","ce",3,1,true,"gfni",false,true,true},
    {"vgf2p8affineinvqb","cf",3,1,true,"gfni",false,true,true},
} do
    for _,width in ipairs{128,256,512} do
        local r,m="v"..width,"m"..width
        local elt=a[5] and 64 or 32
        local vl=width==512 and 2 or width==256 and 1 or 0
        local fs=vl==2 and {"avx512"} or {"avx512","avx512vl"}
        if a[6] then fs[#fs+1]=a[6] end
        if a[9] then fs[#fs+1]="avx512bw" end
        for _,k in ipairs(a[6] and {r,m} or {r,m,"m"..elt}) do
            local broadcast=k=="m"..elt and width//elt or nil
            if a[7] then
                local ops={r,r,k}
                if a[8] then ops[4]="i8" end
                evex(a[1],ops,2,0,1,a[3],a[4],a[5],vl,a[2],
                    {scale=width//8,features=fs,id="_evex",imm=a[8] and 1 or nil,imm_policy="unsigned",access="write"})
            else evfamily(a[1],{r,r,k},2,0,1,a[3],a[4],a[5],vl,a[2],broadcast and elt//8 or width//8,fs,broadcast,a[8]) end
        end
    end
end

-- AVX-512 opmask registers use VEX encodings. The physical register class
-- is 64 bits, but b/w/d/q choose how many mask bits each operation uses.
for _,a in ipairs{{"b",8,1,false,"avx512dq"},{"w",16,0,false},
    {"d",32,1,true,"avx512bw"},{"q",64,0,true,"avx512bw"}} do
    local s,w,pp,wide,k=a[1],a[2],a[3],a[4],"k64"
    local fs=a[5] and {"avx512",a[5]} or {"avx512"}
    local mov="kmov"..s
    for _,src in ipairs{k,"m"..w} do
        vex(mov,{k,src},1,0,-1,1,pp,wide,0,"90",{features=fs,access="write"})
    end
    vex(mov,{"m"..w,k},0,1,-1,1,pp,wide,0,"91",{features=fs,access="write"})
    local g,gpp=w==64 and "r64" or "r32",w>=32 and 3 or pp
    vex(mov,{k,g},1,0,-1,1,gpp,w==64,0,"92",{features=fs,access="write"})
    vex(mov,{g,k},1,0,-1,1,gpp,w==64,0,"93",{features=fs,access="write"})
    for _,v in ipairs{{"kand","41"},{"kandn","42"},{"kor","45"},{"kxnor","46"},{"kxor","47"},{"kadd","4a"}} do
        local active=v[1]=="kadd" and w==16 and {"avx512","avx512dq"} or fs
        vex(v[1]..s,{k,k,k},2,0,1,1,pp,wide,1,v[2],{features=active,access="write"})
    end
    for _,v in ipairs{{"knot","44"},{"kortest","98"},{"ktest","99"}} do
        local active=v[1]=="ktest" and w==16 and {"avx512","avx512dq"} or fs
        vex(v[1]..s,{k,k},1,0,-1,1,pp,wide,0,v[2],{features=active,access=v[1]=="knot" and "write" or "read"})
    end
    for _,v in ipairs{{"kshiftl",0x32},{"kshiftr",0x30}} do
        vex(v[1]..s,{k,k,"i8"},1,0,-1,3,1,w==16 or w==64,0,hex(v[2]+(wide and 1 or 0)),
            {features=fs,access="write",imm=1,imm_policy="unsigned"})
    end
end
for _,a in ipairs{{"kunpckbw",1,false},{"kunpckwd",0,false,"avx512bw"},{"kunpckdq",0,true,"avx512bw"}} do
    vex(a[1],{"k64","k64","k64"},2,0,1,1,a[2],a[3],1,"4b",
        {features=a[4] and {"avx512",a[4]} or {"avx512"},access="write"})
end

-- x87 register stack, arithmetic and typed memory forms.
local x87={"x87"}
for _,a in ipairs{
    {"fnop","d9d0"},{"fchs","d9e0"},{"fabs","d9e1"},{"ftst","d9e4"},{"fxam","d9e5"},
    {"fld1","d9e8"},{"fldl2t","d9e9"},{"fldl2e","d9ea"},{"fldpi","d9eb"},
    {"fldlg2","d9ec"},{"fldln2","d9ed"},{"fldz","d9ee"},
    {"f2xm1","d9f0"},{"fyl2x","d9f1"},{"fptan","d9f2"},{"fpatan","d9f3"},{"fxtract","d9f4"},
    {"fprem1","d9f5"},{"fdecstp","d9f6"},{"fincstp","d9f7"},{"fprem","d9f8"},{"fyl2xp1","d9f9"},
    {"fsqrt","d9fa"},{"fsincos","d9fb"},{"frndint","d9fc"},{"fscale","d9fd"},{"fsin","d9fe"},{"fcos","d9ff"},
    {"fcompp","ded9"},{"fucompp","dae9"},{"fnclex","dbe2"},{"fclex","9bdbe2"},{"fninit","dbe3"},
    {"finit","9bdbe3"},{"fwait","9b"},
} do fixed(a[1],a[2],x87) end
for _,a in ipairs{{"fld","d9",0xc0},{"fxch","d9",0xc8},{"ffree","dd",0xc0},{"fst","dd",0xd0},
    {"fstp","dd",0xd8},{"fucom","dd",0xe0},{"fucomp","dd",0xe8},{"fcom","d8",0xd0},{"fcomp","d8",0xd8}} do
    form(a[1],{"t80"},range("r0",0,7)..bytes(a[2]).."emit8("..a[3].."+r0);",{features=x87})
end
for _,a in ipairs{{"fadd",0xc0,0xc0},{"fmul",0xc8,0xc8},{"fsub",0xe0,0xe8},
    {"fsubr",0xe8,0xe0},{"fdiv",0xf0,0xf8},{"fdivr",0xf8,0xf0}} do
    local args={"t80","t80"}
    form(a[1],args,"require(r0 == 0);"..range("r1",0,7)..bytes("d8").."emit8("..a[2].."+r1);",
        {features=x87,constraints={[1]="st0"}})
    form(a[1],args,"require(r1 == 0);"..range("r0",0,7)..bytes("dc").."emit8("..a[3].."+r0);",
        {id="_reverse",features=x87,constraints={[2]="st0"},syntaxes=(a[2]~=a[3] and {"intel"} or nil)})
    form(a[1].."p",args,"require(r1 == 0);"..range("r0",0,7)..bytes("de").."emit8("..a[3].."+r0);",
        {features=x87,constraints={[2]="st0"},syntaxes=(a[2]~=a[3] and {"intel"} or nil)})
    form(a[1].."p",{},bytes("de"..hex(a[3]+1)),{features=x87,syntaxes=a[2]~=a[3] and {"intel"} or nil})
end
for _,a in ipairs{{"fcomi","db",0xf0},{"fucomi","db",0xe8},{"fcomip","df",0xf0},{"fucomip","df",0xe8},
    {"fcmovb","da",0xc0},{"fcmove","da",0xc8},{"fcmovbe","da",0xd0},{"fcmovu","da",0xd8},
    {"fcmovnb","db",0xc0},{"fcmovne","db",0xc8},{"fcmovnbe","db",0xd0},{"fcmovnu","db",0xd8}} do
    form(a[1],{"t80","t80"},"require(r0 == 0);"..range("r1",0,7)..bytes(a[2]).."emit8("..a[3].."+r1);",
        {features=x87,constraints={[1]="st0"}})
end
for i,name in ipairs{"fadd","fmul","fcom","fcomp","fsub","fsubr","fdiv","fdivr"} do
    for _,a in ipairs{{32,"d8","s"},{64,"dc","l"}} do
        legacy(name,{"m"..a[1]},0,-i,a[2],"",false,{features=x87,att=name..a[3]})
    end
    local int="fi"..name:sub(2)
    for _,a in ipairs{{16,"de","s"},{32,"da","l"}} do
        legacy(int,{"m"..a[1]},0,-i,a[2],"",false,{features=x87,att=int..a[3]})
    end
end
for _,a in ipairs{
    {"fld",32,"d9",0,"flds"},{"fld",64,"dd",0,"fldl"},{"fld",80,"db",5,"fldt"},
    {"fst",32,"d9",2,"fsts"},{"fst",64,"dd",2,"fstl"},
    {"fstp",32,"d9",3,"fstps"},{"fstp",64,"dd",3,"fstpl"},{"fstp",80,"db",7,"fstpt"},
    {"fild",16,"df",0,"filds"},{"fild",32,"db",0,"fildl"},{"fild",64,"df",5,"fildq"},
    {"fist",16,"df",2,"fists"},{"fist",32,"db",2,"fistl"},
    {"fistp",16,"df",3,"fistps"},{"fistp",32,"db",3,"fistpl"},{"fistp",64,"df",7,"fistpq"},
    {"fisttp",16,"df",1,"fisttps","sse3"},{"fisttp",32,"db",1,"fisttpl","sse3"},{"fisttp",64,"dd",1,"fisttpq","sse3"},
    {"fbld",80,"df",4},{"fbstp",80,"df",6},
    {"fldcw",16,"d9",5},{"fnstcw",16,"d9",7},{"fstcw",16,"d9",7,nil,nil,"9b"},
    {"fnstsw",16,"dd",7},{"fstsw",16,"dd",7,nil,nil,"9b"},
    {"fldenv",224,"d9",4},{"fnstenv",224,"d9",6},{"fstenv",224,"d9",6,nil,nil,"9b"},
    {"frstor",864,"dd",4},{"fnsave",864,"dd",6},{"fsave",864,"dd",6,nil,nil,"9b"},
    {"fldenv",112,"d9",4,nil,nil,nil,"66"},{"fnstenv",112,"d9",6,nil,nil,nil,"66"},
    {"fstenv",112,"d9",6,nil,nil,"9b","66"},{"frstor",752,"dd",4,nil,nil,nil,"66"},
    {"fnsave",752,"dd",6,nil,nil,nil,"66"},{"fsave",752,"dd",6,nil,nil,"9b","66"},
} do
    legacy(a[1],{"m"..a[2]},0,-a[4]-1,a[3],a[8] or "",false,
        {features=a[6] and {"x87",a[6]} or x87,att=a[5],group1=a[7]})
end
for _,a in ipairs{{"fnstsw","dfe0"},{"fstsw","9bdfe0"}} do
    form(a[1],{"r16"},"require(r0 == 0);"..bytes(a[2]),{features=x87,constraints={[1]="ax"},access="write"})
end
end

symas.section{ name = ".text", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".rodata", flags = { "alloc", "readonly", "data" }, align = 8, content = "data" }
symas.section{ name = ".data", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".data.rel.ro", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".bss", flags = { "write", "alloc", "zerofill", "data" }, align = 8, content = "data" }
symas.section{ name = ".tdata", flags = { "write", "alloc", "tls", "data" }, align = 8, content = "data" }
symas.section{ name = ".tbss", flags = { "write", "alloc", "zerofill", "tls", "data" }, align = 8, content = "data" }
symas.section{ name = ".init", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".fini", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".plt", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".got", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".eh_frame", flags = { "alloc", "readonly", "data" }, align = 8, content = "data" }
symas.section{ name = ".comment", flags = { "merge", "readonly", "meta" }, align = 1, content = "meta" }

symas.linkage{ name = "func_global", binding = "global", visibility = "default", symtype = "func" }
symas.linkage{ name = "func_weak", binding = "weak", visibility = "default", symtype = "func" }
symas.linkage{ name = "object_global", binding = "global", visibility = "default", symtype = "object" }
symas.linkage{ name = "tls_var", binding = "tls", visibility = "default", symtype = "object" }
symas.linkage{ name = "local_sym", binding = "local", visibility = "default", symtype = "none" }
symas.linkage{ name = "hidden_func", binding = "global", visibility = "hidden", symtype = "func" }

-- ELF psABI Table 4.9 plus the large-model GOT/PLT relocations 27–31.
-- G is the symbol's GOT entry offset, GOT the base, L the PLT entry
-- address, and Z the symbol size. Only instruction recipes emit records;
-- this catalog also describes dynamic, data and relaxation relocations.
for _,a in ipairs{
    {0,"NONE",0,"none"},{1,"64",64,"S + A"},{2,"PC32",32,"S + A - P",true,true},
    {3,"GOT32",32,"G + A"},{4,"PLT32",32,"L + A - P",true,true},{5,"COPY",0,"none"},
    {6,"GLOB_DAT",64,"S"},{7,"JUMP_SLOT",64,"S"},{8,"RELATIVE",64,"B + A"},
    {9,"GOTPCREL",32,"G + GOT + A - P",true,true},{10,"32",32,"S + A"},
    {11,"32S",32,"S + A",true},{12,"16",16,"S + A"},
    {13,"PC16",16,"S + A - P",true,true},{14,"8",8,"S + A"},
    {15,"PC8",8,"S + A - P",true,true},{16,"DTPMOD64",64,"MODULE(S)"},
    {17,"DTPOFF64",64,"DTPOFF(S) + A"},{18,"TPOFF64",64,"TPOFF(S) + A"},
    {19,"TLSGD",32,"TLSGD(S) + A - P",true,true},{20,"TLSLD",32,"TLSLD(S) + A - P",true,true},
    {21,"DTPOFF32",32,"DTPOFF(S) + A",true},{22,"GOTTPOFF",32,"GOTTPOFF(S) + A - P",true,true},
    {23,"TPOFF32",32,"TPOFF(S) + A",true},{24,"PC64",64,"S + A - P",true,true},
    {25,"GOTOFF64",64,"S + A - GOT"},{26,"GOTPC32",32,"GOT + A - P",true,true},
    {27,"GOT64",64,"G + A"},{28,"GOTPCREL64",64,"G + GOT + A - P",true,true},
    {29,"GOTPC64",64,"GOT + A - P",true,true},{30,"GOTPLT64",64,"G + A"},
    {31,"PLTOFF64",64,"L + A - GOT"},{32,"SIZE32",32,"Z + A"},{33,"SIZE64",64,"Z + A"},
    {34,"GOTPC32_TLSDESC",32,"TLSDESC(S) + A - P",true,true},{35,"TLSDESC_CALL",0,"none"},
    {36,"TLSDESC",128,"TLSDESC(S)"},{37,"IRELATIVE",64,"INDIRECT(B + A)"},
    {38,"RELATIVE64",64,"B + A"},
    {41,"GOTPCRELX",32,"G + GOT + A - P",true,true},
    {42,"REX_GOTPCRELX",32,"G + GOT + A - P",true,true},
} do
    symas.reloc{name="R_X86_64_"..a[2],id=a[1],width=a[3],expr=a[4],signed=a[5],pcrel=a[6]}
end
for n=4,6 do
    for i,a in ipairs{{"GOTPCRELX","G + GOT + A - P"},{"GOTTPOFF","GOTTPOFF(S) + A - P"},
        {"GOTPC32_TLSDESC","TLSDESC(S) + A - P"}} do
        symas.reloc{name="R_X86_64_CODE_"..n.."_"..a[1],id=43+3*(n-4)+i-1,
            width=32,expr=a[2],signed=true,pcrel=true}
    end
end

symas.debug{ msg = "x86-64 base + bmi + sse/avx/fma + aes + x87 + priv", kind = "target", ref = "" }
symas.debug{ msg = "vector forms require sse/avx/fma", kind = "form", ref = "vaddps" }
symas.debug{ msg = "privileged forms require priv", kind = "form", ref = "cli" }

print(symas.emit())
