        for _,k in ipairs{r,"m"..w} do
            vex("v"..a[1],a[3] and {r,k} or {r,r,k},a[3] and 1 or 2,0,a[3] and -1 or 1,
                2,1,false,w==256 and 1 or 0,a[2],{features=w==128 and {"avx","aes"} or {"avx","vaes"},access="write"})
        end
