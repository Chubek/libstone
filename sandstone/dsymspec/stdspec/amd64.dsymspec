-- FMA3 has three operand orders. W selects element precision, the opcode
-- selects the order/operation, and scalar forms never have a YMM encoding.
for _,a in ipairs{{"fmaddsub",0x96},{"fmsubadd",0x97},{"fmadd",0x98,0x99},
    {"fmsub",0x9a,0x9b},{"fnmadd",0x9c,0x9d},{"fnmsub",0x9e,0x9f}} do
    for i,order in ipairs{132,213,231} do
        for _,f in ipairs(a[3] and {ps,pd,ss,sd} or {ps,pd}) do
            local scalar=f[5]<128
            local d=f[3]%2==1
            for _,w in ipairs(scalar and {128} or {128,256}) do
                local r="v"..w
                for _,k in ipairs{r,"m"..(scalar and f[5] or w)} do
                    vex("v"..a[1]..order..f[1],{r,r,k},2,0,1,2,1,d,w==256 and 1 or 0,
                        hex((scalar and a[3] or a[2])+16*(i-1)),{features={"avx","fma"},access="readwrite"})
                end
            end
        end
    end
end
for _,a in ipairs{
    {"vpbroadcastb","78",8,"v128"},{"vpbroadcastw","79",16,"v128"},
    {"vpbroadcastd","58",32,"v128"},{"vpbroadcastq","59",64,"v128"},
    {"vbroadcastss","18",32,"v128"},{"vbroadcastsd","19",64,"v128","wide"},
    {"vbroadcastf128","1a",128,nil,"wide"},{"vbroadcasti128","5a",128,nil,"wide"},
} do
    for _,w in ipairs(a[5] and {256} or {128,256}) do
        local r="v"..w
        local integer=a[1]:sub(1,2)=="vp" or a[1]=="vbroadcasti128"
        vex(a[1],{r,"m"..a[3]},1,0,-1,2,1,false,w==256 and 1 or 0,a[2],
            {features=integer and {"avx","avx2"} or {"avx"},access="write"})
        if a[4] then
            vex(a[1],{r,a[4]},1,0,-1,2,1,false,w==256 and 1 or 0,a[2],{features={"avx","avx2"},access="write"})
        end
    end
end
for _,a in ipairs{{"vpermilps","0c","04",false},{"vpermilpd","0d","05",false},
    {"vpsllvd","47",nil,false},{"vpsllvq","47",nil,true},{"vpsrlvd","45",nil,false},
    {"vpsrlvq","45",nil,true},{"vpsravd","46",nil,false}} do
    local fs=a[3] and {"avx"} or {"avx","avx2"}
    for _,w in ipairs{128,256} do
