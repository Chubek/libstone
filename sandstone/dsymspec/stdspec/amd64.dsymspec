for _,a in ipairs{
    {"pshufb","00"},{"phaddw","01"},{"phaddd","02"},{"phaddsw","03"},{"pmaddubsw","04"},
    {"phsubw","05"},{"phsubd","06"},{"phsubsw","07"},{"psignb","08"},{"psignw","09"},{"psignd","0a"},
    {"pmulhrsw","0b"},{"pabsb","1c",true},{"pabsw","1d",true},{"pabsd","1e",true},{"palignr","0f",false,true},
} do
    local opcode=(a[4] and "0f3a" or "0f38")..a[2]
    vec2(a[1],opcode,"66","ssse3",128,a[4],a[3] and "write" or nil)
    for _,k in ipairs{"q64","m64"} do
        local args={"q64",k}
        if a[4] then args[3]="i8" end
        legacy(a[1],args,1,0,opcode,"",false,
            {features={"ssse3","mmx"},imm=a[4] and 1 or nil,imm_policy="unsigned",access=a[3] and "write" or "readwrite"})
    end
    for _,w in ipairs{128,256} do
        local r="v"..w
        for _,k in ipairs{r,"m"..w} do
            local args=a[3] and {r,k} or {r,r,k}
            if a[4] then args[#args+1]="i8" end
            vex("v"..a[1],args,a[3] and 1 or 2,0,a[3] and -1 or 1,a[4] and 3 or 2,1,false,w==256 and 1 or 0,a[2],
                {features=w==256 and {"avx","avx2"} or {"avx"},imm=a[4] and 1 or nil,imm_policy="unsigned",access="write"})
        end
    end
end
