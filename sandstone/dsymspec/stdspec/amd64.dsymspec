    {"vmrun","0f01d8","svm"},{"vmmcall","0f01d9","svm"},{"vmload","0f01da","svm"},
    {"vmsave","0f01db","svm"},{"stgi","0f01dc","svm"},{"clgi","0f01dd","svm"},{"skinit","0f01de","svm"},
} do
