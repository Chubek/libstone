# Build package-private tools even in a libraries-only superbuild. Reuse
# existing framework targets without changing sibling project options.
function(cephyr_native_tools)
  set(sand "${cephyr_repo}/sandstone")
  include("${sand}/cmake/SandASSources.cmake")
  list(TRANSFORM sandstone_reader_sources PREPEND "${sand}/")
  list(TRANSFORM sandstone_assembler_sources PREPEND "${sand}/assembler/")
  add_library(cephyr_sand_reader STATIC ${sandstone_reader_sources})
  target_compile_features(cephyr_sand_reader PUBLIC cxx_std_20)
  target_compile_definitions(cephyr_sand_reader PRIVATE SANDSTONE_PLAIN_BANKS_ONLY=1)
  target_include_directories(cephyr_sand_reader PUBLIC "${sand}/include" PRIVATE "${sand}/decoder")
  if(NOT TARGET qobjld::qobjld)
    set(YELLOWSTONE_BUILD_TESTS OFF)
    set(YELLOWSTONE_BUILD_TOOLS OFF)
    if(NOT TARGET qbfd::qbfd)
      add_subdirectory("${cephyr_repo}/yellowstone/qbfd" qbfd EXCLUDE_FROM_ALL)
    endif()
    add_subdirectory("${cephyr_repo}/yellowstone/ld" qld EXCLUDE_FROM_ALL)
  endif()
  set(spec "${sand}/compiler/stdspec")
  add_executable(cephyr_bank_compiler cmake/package_bank.cpp "${sand}/compiler/src/spec_document.cpp")
  target_compile_definitions(cephyr_bank_compiler PRIVATE SANDSTONE_RECORDS_ONLY=1)
  target_include_directories(cephyr_bank_compiler PRIVATE "${sand}/compiler/include")
  target_link_libraries(cephyr_bank_compiler PRIVATE cephyr_sand_reader libstone_script_lua)
  foreach(bank IN ITEMS amd64 aarch64 rv64im)
    set(parent ${bank})
    if(bank STREQUAL "rv64im")
      set(parent riscv64)
    endif()
    set(file "${cephyr_packages}/banks/${bank}.symas")
    add_custom_command(OUTPUT "${file}"
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${cephyr_packages}/banks"
      COMMAND cephyr_bank_compiler "${bank}.dsymspec" "${file}"
      WORKING_DIRECTORY "${spec}"
      DEPENDS cephyr_bank_compiler "${spec}/${bank}.dsymspec" "${spec}/${parent}.dsymspec"
        "${spec}/dsl.lua" VERBATIM)
    add_custom_target(cephyr_bank_${bank} DEPENDS "${file}")
    add_dependencies(cephyr_compiler cephyr_bank_${bank})
    install(FILES "${file}" DESTINATION "${cephyr_data_dir}/native-packages/banks")
  endforeach()
  set(tools "${cephyr_packages}/tools")
  add_executable(cephyr_sandas "${sand}/assembler/driver.c" ${sandstone_assembler_sources})
  target_link_libraries(cephyr_sandas PRIVATE cephyr_sand_reader libstone_kaguya)
  set_target_properties(cephyr_sandas PROPERTIES OUTPUT_NAME sandstone-as RUNTIME_OUTPUT_DIRECTORY "${tools}")
  add_executable(cephyr_qobjld "${cephyr_repo}/yellowstone/ld/main.cpp")
  target_link_libraries(cephyr_qobjld PRIVATE qobjld::qobjld)
  set_target_properties(cephyr_qobjld PROPERTIES OUTPUT_NAME qobjld RUNTIME_OUTPUT_DIRECTORY "${tools}")
  add_dependencies(cephyr_compiler cephyr_sandas cephyr_qobjld)
  install(TARGETS cephyr_sandas cephyr_qobjld RUNTIME DESTINATION "${cephyr_data_dir}/native-packages/tools")
endfunction()
cephyr_native_tools()
