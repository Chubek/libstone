# Cephyr QML 1.1 — LLSynth-generated expression runner and rule exporter.
# Source grammar: rewrite PHASE NAME : TREE => TREE;
#                 reject PHASE NAME : TREE;
#                 pass PHASE;
#                 run TREE;
# A final run statement selects the expression tool (qml/bundle.py).
# Directive-only fragments select rule export (qml/compile_rules.py).
# Native legality is checked separately by the host, not the frontend.

.language "QML"
.version "1.1"
.summary "Cephyr QML expression runner and rule exporter, bootstrapped on LLSynth"
.start Program
.option parser = lalr1

.import "LLSynth/stdlib/QMLCore.llsynth"
.import "LLSynth/stdlib/QMLPhases.llsynth"

.skip /[ \t\r\n]+/
.skip /#[^\n]*/
.token INT: Int = /-?[0-9]+/
.token ID: String = /[A-Za-z_][A-Za-z0-9_]*/

.prodtype %RuleSource
    phase: String
    name: String
    pattern: Vec<Any>
    replacement: Vec<Any>
.end

.sumtype %Directive
    Rewrite: %RuleSource
    Pass: String
    Reject: %RuleSource
.end

.prodtype %Rewrite
    phase: String
    name: String
    decision: Vec<Any>
.end

.exception !UnknownMeta(name: String) "Unbound rewrite metavariable: {name}"
.exception !InvalidRule(message: String) "Invalid rewrite: {message}"
.exception !RewriteFuel(phase: String) "Rewrite fuel exhausted in {phase}"
.exception !BadIR(message: String) "Malformed mid-level IR: {message}"
.exception !TypeMismatch(expected: String, actual: String) "Expected {expected}, got {actual}"
.exception !Unbound(name: String) "Unbound mid-level symbol: {name}"
.exception !DivisionByZero "Division by zero in constant IR"
.exception !Rejected(name: String) "Rejected IR shape: {name}"

# Trees and expression decision nodes are tagged vectors of Any. Directive
# metadata stays nominal until exported or lowered to expression decisions.

# A pattern may bind a metavariable multiple times; later uses must match.
# This collector is also used to reject unbound variables in replacements.
.function collect_metas(pattern: Vec<Any>, names: Vec<String>) -> Vec<String>
let kind: String = pattern[0];
if kind == "meta" {
    let name: String = pattern[1];
    if name in names { } else { push(names, name); }
}
if kind == "node" {
    let children: Vec<Any> = pattern[2];
    for item in children { names = collect_metas(item, names); }
}
return names;
.end

.function validate_replacement(term: Vec<Any>, names: Vec<String>) -> Void
let kind: String = term[0];
if kind == "wild" { Throw(!InvalidRule, "wildcard in replacement"); }
if kind == "meta" {
    let name: String = term[1];
    if name in names { } else { Throw(!UnknownMeta, name); }
}
if kind == "node" {
    let children: Vec<Any> = term[2];
    for child in children { validate_replacement(child, names); }
}
return;
.end

.function path_arg(path: Vec<Int>, index: Int) -> Vec<Int>
let p: Vec<Int> = [];
for step in path { push(p, step); }
push(p, 2);
push(p, index);
return p;
.end

# Decision instructions:
#   ["test", path, discriminator, yes, no]
#   ["bind", path, name, yes, no]
#   ["leaf", replacement-template]
#   ["fail"]
# Paths are indices through tagged ASTs. A child of a call is at [2, i].
.function discriminator(p: Vec<Any>) -> Vec<Any>
if p[0] == "node" {
    let args: Vec<Any> = p[2];
    return [box("node"), p[1], box(len(args))];
}
return p;
.end

.function compile_pattern(pattern: Vec<Any>, path: Vec<Int>, yes: Vec<Any>, no: Vec<Any>) -> Vec<Any>
let kind: String = pattern[0];
if kind == "wild" { return yes; }
if kind == "meta" {
    return [box("bind"), box(path), pattern[1], box(yes), box(no)];
}
if kind == "node" {
    let children: Vec<Any> = pattern[2];
    let i: Int = len(children) - 1;
    let body: Vec<Any> = yes;
    while i >= 0 {
        body = compile_pattern(children[i], path_arg(path, i), body, no);
        i = i - 1;
    }
    return [box("test"), box(path), box(discriminator(pattern)), box(body), box(no)];
}
return [box("test"), box(path), box(discriminator(pattern)), box(yes), box(no)];
.end

.function rewrite_source(phase: String, name: String, pattern: Vec<Any>, replacement: Vec<Any>) -> %RuleSource
let names: Vec<String> = collect_metas(pattern, []);
validate_replacement(replacement, names);
return %RuleSource(phase, name, pattern, replacement);
.end

.function make_rule(phase: String, name: String, pattern: Vec<Any>, replacement: Vec<Any>) -> %Rewrite
let yes: Vec<Any> = [box("leaf"), box(replacement)];
let no: Vec<Any> = [box("fail")];
let empty_path: Vec<Int> = [];
return %Rewrite(phase, name, compile_pattern(pattern, empty_path, yes, no));
.end

.function project(term: Vec<Any>, path: Vec<Int>) -> Vec<Any>
let value: Any = term;
for step in path { value = value[step]; }
return value;
.end

.function test_key(subject: Vec<Any>, key: Vec<Any>) -> Bool
if subject[0] != key[0] { return false; }
if key[0] == "node" {
    let args: Vec<Any> = subject[2];
    return subject[1] == key[1] && len(args) == key[2];
}
if key[0] == "int" || key[0] == "bool" || key[0] == "sym" {
    return subject[1] == key[1];
}
return false;
.end

# A match returns ["hit", replacement-IR] or ["miss"]. Every rule is
# started with fresh bindings, ensuring no capture can leak between rules.
.function instantiate(template: Vec<Any>, bindings: Vec<Any>) -> Vec<Any>
let kind: String = template[0];
if kind == "meta" {
    let i: Int = 0;
    while i < len(bindings) {
        if bindings[i] == template[1] { return bindings[i + 1]; }
        i = i + 2;
    }
    Throw(!UnknownMeta, template[1]);
}
if kind == "node" {
    let children: Vec<Any> = template[2];
    let out: Vec<Any> = [];
    for child in children { push(out, box(instantiate(child, bindings))); }
    return node_term(template[1], out);
}
return template;
.end

.function execute_decision(decision: Vec<Any>, term: Vec<Any>, bindings: Vec<Any>) -> Vec<Any>
let kind: String = decision[0];
if kind == "fail" { return [box("miss")]; }
if kind == "leaf" {
    return [box("hit"), box(instantiate(decision[1], bindings))];
}
if kind == "test" {
    let target: Vec<Any> = project(term, decision[1]);
    if test_key(target, decision[2]) {
        return execute_decision(decision[3], term, bindings);
    }
    return execute_decision(decision[4], term, bindings);
}
if kind == "bind" {
    let target: Vec<Any> = project(term, decision[1]);
    let name: String = decision[2];
    let i: Int = 0;
    while i < len(bindings) {
        if bindings[i] == name {
            if bindings[i + 1] == target {
                return execute_decision(decision[3], term, bindings);
            }
            return execute_decision(decision[4], term, bindings);
        }
        i = i + 2;
    }
    let extended: Vec<Any> = [];
    for item in bindings { push(extended, item); }
    push(extended, box(name));
    push(extended, box(target));
    return execute_decision(decision[3], term, extended);
}
Throw(!BadIR, "unknown decision instruction");
.end

# Built-in desugaring is expressed by the SAME compiled rule mechanism as
# source rewrites. It does not interpret left-hand pattern ASTs at runtime.
.function builtin_rules() -> Vec<%Rewrite>
let rules: Vec<%Rewrite> = [];
let x: Vec<Any> = meta_term("x");
let y: Vec<Any> = meta_term("y");
push(rules, make_rule("desugar", "sub", binary("sub", x, y), binary("add", x, unary("neg", y))));
push(rules, make_rule("desugar", "and", binary("and", x, y), ternary("if", x, y, bool_term(false))));
push(rules, make_rule("desugar", "or", binary("or", x, y), ternary("if", x, bool_term(true), y)));
push(rules, make_rule("desugar", "not", unary("not", x), ternary("if", x, bool_term(false), bool_term(true))));
push(rules, make_rule("canonicalize", "add_zero_right", binary("add", x, int_term(0)), x));
push(rules, make_rule("canonicalize", "add_zero_left", binary("add", int_term(0), x), x));
push(rules, make_rule("canonicalize", "mul_one_right", binary("mul", x, int_term(1)), x));
push(rules, make_rule("canonicalize", "mul_one_left", binary("mul", int_term(1), x), x));
push(rules, make_rule("canonicalize", "double_neg", unary("neg", unary("neg", x)), x));
push(rules, make_rule("canonicalize", "if_true", ternary("if", bool_term(true), x, y), x));
push(rules, make_rule("canonicalize", "if_false", ternary("if", bool_term(false), x, y), y));
return rules;
.end

# Constant folding is separated from canonicalization so users can select
# the mid-level phase ordering. LLSynth's Int semantics check overflow.
.function fold_intrinsics(t: Vec<Any>, phase: String) -> Vec<Any>
if phase != "optimize" || t[0] != "node" { return t; }
let op: String = t[1];
let args: Vec<Any> = t[2];
if op == "neg" && len(args) == 1 {
    let a: Vec<Any> = args[0];
    if a[0] == "int" { return int_term(-a[1]); }
}
if len(args) == 2 {
    let a: Vec<Any> = args[0];
    let b: Vec<Any> = args[1];
    if a[0] == "int" && b[0] == "int" {
        let left: Int = a[1];
        let right: Int = b[1];
        if op == "add" { return int_term(left + right); }
        if op == "sub" { return int_term(left - right); }
        if op == "mul" { return int_term(left * right); }
        if op == "div" {
            if right == 0 { Throw(!DivisionByZero); }
            return t;  # No implicit rounding: retain integer division in MIR.
        }
        if op == "eq" { return bool_term(left == right); }
        if op == "lt" { return bool_term(left < right); }
        if op == "gt" { return bool_term(left > right); }
    }
    if a[0] == "bool" && b[0] == "bool" && op == "eq" {
        return bool_term(a[1] == b[1]);
    }
}
return t;
.end

.function rewrite_visit(t: Vec<Any>, rules: Vec<%Rewrite>, phase: String) -> Vec<Any>
let here: Vec<Any> = t;
if t[0] == "node" {
    let args: Vec<Any> = t[2];
    let updated: Vec<Any> = [];
    for child in args { push(updated, box(rewrite_visit(child, rules, phase))); }
    here = node_term(t[1], updated);
}
for rule in rules {
    if %Rewrite.phase(rule) == phase {
        let outcome: Vec<Any> = execute_decision(%Rewrite.decision(rule), here, []);
        if outcome[0] == "hit" { return outcome[1]; }
    }
}
return fold_intrinsics(here, phase);
.end

.function rewrite_fixpoint(t: Vec<Any>, rules: Vec<%Rewrite>, phase: String) -> Vec<Any>
let current: Vec<Any> = t;
let fuel: Int = 0;
while fuel < 128 {
    let next: Vec<Any> = rewrite_visit(current, rules, phase);
    if next == current { return current; }
    current = next;
    fuel = fuel + 1;
}
Throw(!RewriteFuel, phase);
.end

.function need_arity(op: String, args: Vec<Any>, count: Int) -> Void
if len(args) != count { Throw(!BadIR, op); }
return;
.end

.function need_type(actual: String, expected: String) -> Void
if actual != expected { Throw(!TypeMismatch, expected, actual); }
return;
.end

.function env_bind(env: Vec<Any>, name: String, type_name: String) -> Vec<Any>
let next: Vec<Any> = [];
for element in env { push(next, element); }
push(next, box(name));
push(next, box(type_name));
return next;
.end

.function env_type(env: Vec<Any>, name: String) -> String
let pos: Int = len(env) - 2;
while pos >= 0 {
    if env[pos] == name { return env[pos + 1]; }
    pos = pos - 2;
}
Throw(!Unbound, name);
.end

.function expect_symbol(t: Vec<Any>) -> String
if t[0] != "sym" { Throw(!BadIR, "expected a symbol operand"); }
return t[1];
.end

# Sema performs a lightweight MIR type inference over lexical bindings.
# Symbols are NOT expressions: they are names supplied to var/let.
.function infer(t: Vec<Any>, env: Vec<Any>) -> String
let kind: String = t[0];
if kind == "int" { return "Int"; }
if kind == "bool" { return "Bool"; }
if kind != "node" { Throw(!BadIR, "bare symbol, metavariable, or wildcard"); }
let op: String = t[1];
let args: Vec<Any> = t[2];
if op == "var" {
    need_arity(op, args, 1);
    return env_type(env, expect_symbol(args[0]));
}
if op == "let" {
    need_arity(op, args, 3);
    let name: String = expect_symbol(args[0]);
    let value_type: String = infer(args[1], env);
    return infer(args[2], env_bind(env, name, value_type));
}
if op == "seq" {
    need_arity(op, args, 2);
    discard infer(args[0], env);
    return infer(args[1], env);
}
if op == "if" {
    need_arity(op, args, 3);
    need_type(infer(args[0], env), "Bool");
    let yes_type: String = infer(args[1], env);
    let no_type: String = infer(args[2], env);
    need_type(no_type, yes_type);
    return yes_type;
}
if op == "neg" || op == "not" {
    need_arity(op, args, 1);
    if op == "neg" {
        need_type(infer(args[0], env), "Int");
        return "Int";
    }
    need_type(infer(args[0], env), "Bool");
    return "Bool";
}
if op == "add" || op == "sub" || op == "mul" || op == "div" || op == "lt" || op == "gt" {
    need_arity(op, args, 2);
    need_type(infer(args[0], env), "Int");
    need_type(infer(args[1], env), "Int");
    if op == "div" {
        let rhs: Vec<Any> = args[1];
        if rhs[0] == "int" && rhs[1] == 0 { Throw(!DivisionByZero); }
    }
    if op == "lt" || op == "gt" { return "Bool"; }
    return "Int";
}
if op == "eq" {
    need_arity(op, args, 2);
    let lt: String = infer(args[0], env);
    need_type(infer(args[1], env), lt);
    return "Bool";
}
if op == "and" || op == "or" {
    need_arity(op, args, 2);
    need_type(infer(args[0], env), "Bool");
    need_type(infer(args[1], env), "Bool");
    return "Bool";
}
Throw(!BadIR, op);
.end

# User-defined semantic checks are negative patterns, compiled to the same
# decision representation as rewrites; they cannot mutate IR.
.function check_rejections(t: Vec<Any>, checks: Vec<%Rewrite>, phase: String) -> Void
for rule in checks {
    if %Rewrite.phase(rule) == phase {
        let hit: Vec<Any> = execute_decision(%Rewrite.decision(rule), t, []);
        if hit[0] == "hit" { Throw(!Rejected, %Rewrite.name(rule)); }
    }
}
if t[0] == "node" {
    let children: Vec<Any> = t[2];
    for child in children { check_rejections(child, checks, phase); }
}
return;
.end

.function run_program(decls: Vec<%Directive>, input: Vec<Any>) -> Vec<Any>
let rules: Vec<%Rewrite> = [];
let checks: Vec<%Rewrite> = [];
let passes: Vec<String> = [];
# User-defined rewrites precede intrinsic ones inside a phase.
for d in decls {
    if %Directive.is_Rewrite(d) {
        let r: %RuleSource = %Directive.get_Rewrite(d);
        push(rules, make_rule(%RuleSource.phase(r), %RuleSource.name(r), %RuleSource.pattern(r), %RuleSource.replacement(r)));
    } else {
        if %Directive.is_Reject(d) {
            let r: %RuleSource = %Directive.get_Reject(d);
            push(checks, make_rule(%RuleSource.phase(r), %RuleSource.name(r), %RuleSource.pattern(r), bool_term(true)));
        } else {
            let phase: String = %Directive.get_Pass(d);
            push(passes, phase);
        }
    }
}
let builtin: Vec<%Rewrite> = builtin_rules();
for rule in builtin { push(rules, rule); }
if len(passes) == 0 {
    passes = default_phases();
}
let tree: Vec<Any> = input;
for p in passes {
    if is_sema_phase(p) {
        check_rejections(tree, checks, p);
        discard infer(tree, []);
    } else {
        tree = rewrite_fixpoint(tree, rules, p);
        check_rejections(tree, checks, p);
    }
}
# A final check is mandatory even when the user reorders or omits sema.
check_rejections(tree, checks, "sema");
discard infer(tree, []);
return tree;
.end

# The native host consumes source patterns, not the expression runner's
# decisions. Preserve directive order without adding any expression builtins.
.function export_rules(decls: Vec<%Directive>) -> Vec<Any>
let out: Vec<Any> = [];
for d in decls {
    if %Directive.is_Rewrite(d) {
        let r: %RuleSource = %Directive.get_Rewrite(d);
        push(out, box([box("R"), box(%RuleSource.phase(r)), box(%RuleSource.name(r)), box(%RuleSource.pattern(r)), box(%RuleSource.replacement(r))]));
    } else {
        if %Directive.is_Reject(d) {
            let r: %RuleSource = %Directive.get_Reject(d);
            push(out, box([box("X"), box(%RuleSource.phase(r)), box(%RuleSource.name(r)), box(%RuleSource.pattern(r))]));
        } else {
            push(out, box([box("P"), box(%Directive.get_Pass(d))]));
        }
    }
}
return out;
.end

# --- QML surface grammar ---------------------------------------------------
# The `?name` form is a pattern variable in LHS and template reference in RHS.
# The same generic Tree grammar allows operations supplied by host compilers:
# unknown constructors are accepted by parsing; hosts check their own IR.
.rule Program
'syntax: decls:Directive* term:ProgramEnd EOF
'semantics:
if len($term) == 0 { return export_rules($decls); }
return run_program($decls, $term);
.end

.rule ProgramEnd
'syntax: "run" term:Tree ";" |
'semantics:
on term -> return $term; -> end
return [];
.end

.rule Directive
'syntax: "rewrite" phase:ID name:ID ":" lhs:Tree "=>" rhs:Tree ";" | "pass" selected:ID ";" | "reject" reject_phase:ID checkname:ID ":" bad:Tree ";"
'semantics:
on name -> return %Directive.Rewrite(rewrite_source($phase, $name, $lhs, $rhs)); -> end
on selected -> return %Directive.Pass($selected); -> end
on checkname -> return %Directive.Reject(%RuleSource($reject_phase, $checkname, $bad, [])); -> end
.end

.rule Tree
'syntax: number:INT | yes:"true" | no:"false" | wildcard:"_" | "?" metavar:ID | ctor:ID "(" args:ArgList ")" | empty_ctor:ID "(" ")" | symbol:ID
'semantics:
on number -> return int_term($number); -> end
on yes -> return bool_term(true); -> end
on no -> return bool_term(false); -> end
on wildcard -> return wild_term(); -> end
on metavar -> return meta_term($metavar); -> end
on ctor -> return node_term($ctor, $args); -> end
on empty_ctor -> return node_term($empty_ctor, []); -> end
on symbol -> return sym_term($symbol); -> end
.end

.rule ArgList
'syntax: first:Tree rest:ArgRest*
'semantics: return prepend($first, $rest);
.end

.rule ArgRest
'syntax: "," item:Tree
'semantics: return $item;
.end
