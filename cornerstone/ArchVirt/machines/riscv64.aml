; Flat DomIOS single-hart RV64IM + Zifencei. No SBI, MMU, IRQs, C/A/F/D/V.
(machine archvirt-pc
  (isa riscv64)
  (kind personal-computer)
  (boot domios-v1)
  (execution-isa rv64im_zifencei)
  (halt ebreak)
  (elf-machine 243)
  (ram-base 0)
  (kernel-base 0x200000)
  (stack-top 0x700000)
  (boot-info 0x10000)
  (initrd-base 0x800000)
  (firmware-base 0x2000000)
  (console-base 0xb8000)
  (console-columns 80)
  (console-rows 25)
  (serial-kind mmio)
  (serial-base 0x10000000)
  (interrupt-controller polled))
