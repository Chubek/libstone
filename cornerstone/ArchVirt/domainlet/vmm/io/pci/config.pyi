from dataclasses import dataclass

@dataclass
class PciConfigSpace:
    vendor_id: int
    device_id: int
    class_code: int = ...
    subclass: int = ...
    prog_if: int = ...
    revision_id: int = ...
    header_type: int = ...
    _data: bytearray
    def read(self, addr: int, size: int) -> bytes: ...
    def write(self, addr: int, data: bytes | bytearray | memoryview) -> int: ...
