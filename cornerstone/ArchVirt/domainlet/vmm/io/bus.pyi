from dataclasses import dataclass

from domainlet.vmm.seams import BusDevice

@dataclass(frozen=True, slots=True)
class BusMapping:
    base: int
    size: int
    device: BusDevice
    def contains(self, addr: int, size: int = ...) -> bool: ...

@dataclass
class Bus:
    mappings: list[BusMapping]
    def register(self, base: int, size: int, device: BusDevice) -> None: ...
    def resolve(self, addr: int, size: int = ...) -> BusMapping: ...
    def read(self, addr: int, size: int) -> bytes: ...
    def write(self, addr: int, data: bytes | bytearray | memoryview) -> int: ...
    def dispatch(self, addr: int, data: bytes | bytearray | memoryview | None = ..., *, write: bool = ..., size: int | None = ...) -> bytes | int: ...

class MmioBus(Bus): ...
class PioBus(Bus): ...
