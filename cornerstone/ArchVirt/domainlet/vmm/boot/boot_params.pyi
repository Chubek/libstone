from dataclasses import dataclass

BOOT_PARAMS_ADDRESS: int
CMDLINE_ADDRESS: int
INITRD_ADDRESS: int
KERNEL_LOAD_ADDRESS: int
BOOT_FLAG: int
SETUP_HEADER_MAGIC: int
LOADFLAG_LOADED_HIGH: int
LOADFLAG_CAN_USE_HEAP: int
XLF_KERNEL_64: int
XLF_CAN_BE_LOADED_ABOVE_4G: int

class SetupHeader: ...
class BootE820Entry: ...

@dataclass(frozen=True, slots=True)
class E820Entry:
    addr: int
    size: int
    type: int = ...
    def to_struct(self) -> BootE820Entry: ...

@dataclass
class BootParams:
    cmdline_ptr: int = ...
    ramdisk_image: int = ...
    ramdisk_size: int = ...
    e820_entries: list[E820Entry] = ...
    setup_header: SetupHeader = ...
    def to_bytes(self) -> bytes: ...
    def set_cmdline(self, ptr: int, size: int) -> None: ...
