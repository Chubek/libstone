from dataclasses import dataclass

from domainlet.vmm.boot.legacy.console_sink import ConsoleSink

@dataclass
class SerialPort:
    base: int = ...
    size: int = ...
    sink: ConsoleSink = ...
    buffer: bytearray = ...
    def read(self, addr: int, size: int) -> bytes: ...
    def write(self, addr: int, data: bytes | bytearray | memoryview) -> int: ...
