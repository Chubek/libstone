from dataclasses import dataclass
from pathlib import Path

from domainlet.vmm.seams import GuestMemoryLike

@dataclass(frozen=True, slots=True)
class BootArtifacts:
    entry_point: int
    stack_pointer: int
    kernel_address: int
    kernel_size: int
    boot_params_address: int = ...
    initrd_address: int | None = ...
    initrd_size: int = ...
    cmdline_address: int = ...
    cmdline: str = ...

class LinuxKernelLoader:
    def __init__(self, kernel_path: Path | str, initrd_path: Path | str | None = ..., *cmdline: str) -> None: ...
    def load(self, memory: GuestMemoryLike) -> BootArtifacts: ...
