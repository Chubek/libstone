from dataclasses import dataclass
from domainlet.vmm.core.kvm.capabilities import KvmCapabilities

from domainlet.vmm.core.kvm.bindings import kvm_userspace_memory_region
from domainlet.vmm.core.kvm.capabilities import KvmCapabilities

@dataclass
class Hypervisor:
    path: str = ...
    fd: int
    capabilities: KvmCapabilities
    def close(self) -> None: ...
    def __enter__(self) -> Hypervisor: ...
    def __exit__(self, exc_type, exc, tb) -> None: ...
    def create_vm(self, vm_type: int = ...) -> VirtualMachine: ...
    def vcpu_mmap_size(self) -> int: ...

@dataclass
class VirtualMachine:
    fd: int
    hypervisor: Hypervisor
    def close(self) -> None: ...
    def create_vcpu(self, vcpu_id: int) -> int: ...
    def create_irqchip(self) -> None: ...
    def set_user_memory_region(self, region: kvm_userspace_memory_region) -> None: ...
    def __enter__(self) -> VirtualMachine: ...
    def __exit__(self, exc_type, exc, tb) -> None: ...
