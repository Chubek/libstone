from dataclasses import dataclass

from domainlet.vmm.seams import ResourceAllocatorLike

@dataclass(frozen=True, slots=True)
class AddressRange:
    start: int
    end: int

@dataclass
class AddressAllocator(ResourceAllocatorLike):
    gpa_base: int = ...
    mmio_base: int = ...
    pio_base: int = ...
    _ranges: list[AddressRange]
    def reserve(self, start: int, size: int) -> None: ...
    def allocate_gpa(self, size: int, align: int = ...) -> int: ...
    def allocate_mmio(self, size: int, align: int = ...) -> int: ...
    def allocate_pio(self, size: int, align: int = ...) -> int: ...
