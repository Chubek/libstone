from dataclasses import dataclass

from domainlet.vmm.core.exits import ExitDispatcher

@dataclass
class Vcpu:
    fd: int
    mmap_size: int
    bus: object
    dispatcher: ExitDispatcher = ...
    def close(self) -> None: ...
    def stop(self) -> None: ...
    def start(self) -> None: ...
    def join(self, timeout: float | None = ...) -> None: ...
    def run(self) -> None: ...
