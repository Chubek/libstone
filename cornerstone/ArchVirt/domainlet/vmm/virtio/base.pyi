from dataclasses import dataclass
from enum import Enum, IntFlag
from typing import Any, Iterable

class VirtioAccess(str, Enum):
    READ_ONLY = ...
    READ_WRITE = ...
    WRITE_ONLY = ...

class VirtioQueueDirection(str, Enum):
    DRIVER_TO_DEVICE = ...
    DEVICE_TO_DRIVER = ...
    BIDIRECTIONAL = ...

class VirtioTransport(str, Enum):
    PCI = ...
    MMIO = ...
    CCW = ...

class VirtioDeviceStatus(IntFlag):
    ACKNOWLEDGE = ...
    DRIVER = ...
    DRIVER_OK = ...
    FEATURES_OK = ...
    SUSPEND = ...
    DEVICE_NEEDS_RESET = ...
    FAILED = ...

@dataclass(frozen=True, slots=True)
class VirtioFeature:
    bit: int
    name: str
    description: str = ...
    requires: tuple[str, ...] = ...

@dataclass(frozen=True, slots=True)
class VirtioQueue:
    name: str
    direction: VirtioQueueDirection | str = ...
    purpose: str = ...
    minimum: int = ...
    maximum: int | None = ...
    index: int | None = ...
    optional_feature: str | None = ...

@dataclass(frozen=True, slots=True)
class VirtioRegister:
    name: str
    offset: int | None = ...
    width: int = ...
    access: VirtioAccess | str = ...
    description: str = ...
    condition: str | None = ...
    region: str = ...

@dataclass(frozen=True, slots=True)
class VirtioDeviceDescriptor:
    device_id: int
    name: str
    spec_ref: str
    summary: str = ...
    queues: tuple[VirtioQueue, ...] = ...
    features: tuple[VirtioFeature, ...] = ...
    config_registers: tuple[VirtioRegister, ...] = ...
    aliases: tuple[str, ...] = ...
    notes: tuple[str, ...] = ...
    transports: tuple[VirtioTransport, ...] = ...

    @property
    def canonical_name(self) -> str: ...
    @property
    def identifiers(self) -> frozenset[str]: ...
    def feature(self, key: int | str) -> VirtioFeature | None: ...
    def queue(self, name: str) -> VirtioQueue | None: ...
    def config_field(self, name: str) -> VirtioRegister | None: ...
    def validation_errors(self) -> tuple[str, ...]: ...
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True, slots=True)
class VirtioKernelDescriptor:
    device_id: int
    device_name: str
    module: str
    spec_ref: str
    description: str = ...
    registers: tuple[VirtioRegister, ...] = ...
    notes: tuple[str, ...] = ...
    def to_dict(self) -> dict[str, Any]: ...

class VirtioRegistry:
    def __init__(self, devices: Iterable[VirtioDeviceDescriptor] = ...) -> None: ...
    @property
    def devices(self) -> tuple[VirtioDeviceDescriptor, ...]: ...
    def get(self, key: int | str) -> VirtioDeviceDescriptor | None: ...
    def require(self, key: int | str) -> VirtioDeviceDescriptor: ...
    def to_dict(self) -> dict[str, Any]: ...

COMMON_FEATURES: tuple[VirtioFeature, ...]
COMMON_REGISTERS: tuple[VirtioRegister, ...]

def common_registers() -> tuple[VirtioRegister, ...]: ...
def common_queues() -> tuple[VirtioQueue, ...]: ...
def make_device(
    device_id: int,
    name: str,
    *,
    spec_ref: str,
    summary: str,
    queues: tuple[VirtioQueue, ...] = ...,
    features: tuple[VirtioFeature, ...] = ...,
    config_registers: tuple[VirtioRegister, ...] = ...,
    aliases: tuple[str, ...] = ...,
    notes: tuple[str, ...] = ...,
    transports: tuple[VirtioTransport, ...] = ...,
) -> VirtioDeviceDescriptor: ...
def make_kernel(
    device_id: int,
    name: str,
    *,
    module: str,
    spec_ref: str,
    description: str,
    registers: tuple[VirtioRegister, ...] = ...,
    notes: tuple[str, ...] = ...,
) -> VirtioKernelDescriptor: ...
def feature(
    bit: int,
    name: str,
    description: str = ...,
    *,
    requires: tuple[str, ...] = ...,
) -> VirtioFeature: ...
def field(
    name: str,
    width: int,
    description: str = ...,
    *,
    access: VirtioAccess | str = ...,
    offset: int | None = ...,
    condition: str | None = ...,
) -> VirtioRegister: ...
def queue(
    name: str,
    direction: VirtioQueueDirection | str,
    purpose: str,
    *,
    index: int | None = ...,
    minimum: int = ...,
    maximum: int | None = ...,
    optional_feature: str | None = ...,
) -> VirtioQueue: ...

__all__: list[str]
