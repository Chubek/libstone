module MiniCalc {
    program = (identifier name, function* functions)
    function = (identifier name, parameter* params, identifier result, stmt* body)
    parameter = (identifier name, identifier type)
    stmt = Let(identifier binding, expr value)
         | Annotated(identifier binding, identifier type, expr value)
         | Return(expr value)
    expr = Integer(int value)
         | Variable(identifier name)
         | Add(expr lhs, expr rhs)
         | Subtract(expr lhs, expr rhs)
         | Multiply(expr lhs, expr rhs)
         | Equal(expr lhs, expr rhs)
         | True
         | False
}
