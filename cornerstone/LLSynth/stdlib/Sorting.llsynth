.library "std.Sorting"
.summary "Stable integer insertion sort and linear merge of sorted vectors"
.export sorted, merge

.function sorted(items: Vec<Int>) -> Vec<Int>
let result: Vec<Int> = [];
for value in items {
    let i = len(result);
    push(result, value);
    while i > 0 && result[i - 1] > value {
        result[i] = result[i - 1];
        i = i - 1;
    }
    result[i] = value;
}
return result;
.end

.function merge(left: Vec<Int>, right: Vec<Int>) -> Vec<Int>
let result: Vec<Int> = [];
let i = 0;
let j = 0;
while i < len(left) || j < len(right) {
    if j == len(right) || (i < len(left) && left[i] <= right[j]) {
        push(result, left[i]);
        i = i + 1;
    } else {
        push(result, right[j]);
        j = j + 1;
    }
}
return result;
.end
