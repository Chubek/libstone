.library "std.RunLength"
.summary "Run-length encoding and checked decoding of integer sequences"
.export encode, decode

.exception !Malformed "expected value/count pairs with positive counts"

.function encode(items: Vec<Int>) -> Vec<Int>
let result: Vec<Int> = [];
for value in items {
    let n = len(result);
    if n > 0 && result[n - 2] == value {
        result[n - 1] = result[n - 1] + 1;
    } else {
        push(result, value);
        push(result, 1);
    }
}
return result;
.end

.function decode(pairs: Vec<Int>) -> Vec<Int>
let result: Vec<Int> = [];
let i = 0;
while i < len(pairs) {
    require i + 1 < len(pairs) && pairs[i + 1] > 0 else Throw(!Malformed);
    let count = pairs[i + 1];
    while count > 0 {
        push(result, pairs[i]);
        count = count - 1;
    }
    i = i + 2;
}
return result;
.end
