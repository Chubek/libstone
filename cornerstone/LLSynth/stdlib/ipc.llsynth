.library "std.ipc"
.summary "Native byte streams, POSIX message queues, shared memory and named semaphores"

.extern ipc available(mechanism: String) -> Bool symbol "available"
.extern ipc pipe() -> Vec<Int> symbol "pipe"
.extern ipc socketPair() -> Vec<Int> symbol "socketPair"
.extern ipc close(fd: Int) -> Void symbol "close"
.extern ipc read(fd: Int, count: Int) -> Vec<Int> symbol "read"
.extern ipc write(fd: Int, data: Vec<Int>) -> Int symbol "write"
.extern ipc setNonblocking(fd: Int, enabled: Bool) -> Void symbol "setNonblocking"
.extern ipc waitReadable(fd: Int, milliseconds: Int) -> Bool symbol "waitReadable"
.extern ipc waitWritable(fd: Int, milliseconds: Int) -> Bool symbol "waitWritable"

.extern ipc fifoCreate(path: String) -> Void symbol "fifoCreate"
.extern ipc fifoOpen(path: String, writable: Bool) -> Int symbol "fifoOpen"
.extern ipc fifoUnlink(path: String) -> Void symbol "fifoUnlink"

.extern ipc mqCreate(name: String, depth: Int, messageSize: Int, nonblocking: Bool) -> Int symbol "mqCreate"
.extern ipc mqOpen(name: String, nonblocking: Bool) -> Int symbol "mqOpen"
.extern ipc mqSend(queue: Int, data: Vec<Int>, priority: Int) -> Void symbol "mqSend"
.extern ipc mqReceive(queue: Int) -> Vec<Int> symbol "mqReceive"
.extern ipc mqClose(queue: Int) -> Void symbol "mqClose"
.extern ipc mqUnlink(name: String) -> Void symbol "mqUnlink"

.extern ipc shmCreate(name: String, size: Int) -> Int symbol "shmCreate"
.extern ipc shmOpen(name: String, writable: Bool) -> Int symbol "shmOpen"
.extern ipc shmSize(fd: Int) -> Int symbol "shmSize"
.extern ipc shmRead(fd: Int, offset: Int, count: Int) -> Vec<Int> symbol "shmRead"
.extern ipc shmWrite(fd: Int, offset: Int, data: Vec<Int>) -> Int symbol "shmWrite"
.extern ipc shmUnlink(name: String) -> Void symbol "shmUnlink"

.extern ipc semCreate(name: String, initialValue: Int) -> Int symbol "semCreate"
.extern ipc semOpen(name: String) -> Int symbol "semOpen"
.extern ipc semTryWait(semaphore: Int) -> Bool symbol "semTryWait"
.extern ipc semPost(semaphore: Int) -> Void symbol "semPost"
.extern ipc semClose(semaphore: Int) -> Void symbol "semClose"
.extern ipc semUnlink(name: String) -> Void symbol "semUnlink"
