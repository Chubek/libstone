; The grammar is (FORM ARG ...). Vocabularies supply names and argument kinds.
(module ArithmeticRuntime
  (include stddef.h)
  (include string.h)
  (c "
enum arithmetic_form_kind {
    ARITHMETIC_INTEGER, ARITHMETIC_VARIABLE, ARITHMETIC_OPERATION
};

typedef struct arithmetic_form {
    const char *name;
    enum arithmetic_form_kind kind;
    size_t arity;
    long long (*apply)(const long long *);
} arithmetic_form;

typedef struct arithmetic_parser {
    const char *next;
    long long x;
    const char *error;
    const arithmetic_form *const *vocabularies;
} arithmetic_parser;

enum { ARITHMETIC_MAX_DEPTH = 32, ARITHMETIC_MAX_BYTES = 1024 };
/* Keep all operands small enough that even multiplication fits in long long. */
#define ARITHMETIC_MAX_VALUE 1000000LL

static inline int arithmetic_in_range(long long value) {
    return -ARITHMETIC_MAX_VALUE <= value && value <= ARITHMETIC_MAX_VALUE;
}

static inline int arithmetic_space(char c) {
    return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r';
}

static inline void arithmetic_skip(arithmetic_parser *parser) {
    while (arithmetic_space(*parser->next)) ++parser->next;
}

static inline size_t arithmetic_token(arithmetic_parser *parser, const char **start) {
    arithmetic_skip(parser);
    *start = parser->next;
    while (*parser->next && !arithmetic_space(*parser->next) &&
           *parser->next != '(' && *parser->next != ')')
        ++parser->next;
    return (size_t)(parser->next - *start);
}

static inline int arithmetic_integer(const char *text, size_t size, long long *out) {
    long long value = 0;
    const int negative = size && *text == '-';
    size_t i = negative ? 1 : 0;
    if (i == size) return 0;
    for (; i < size; ++i) {
        if (text[i] < '0' || text[i] > '9') return 0;
        value = value * 10 + (text[i] - '0');
        if (value > ARITHMETIC_MAX_VALUE) return 0;
    }
    *out = negative ? -value : value;
    return 1;
}

static inline int arithmetic_error(arithmetic_parser *parser, const char *message) {
    parser->error = message;
    return 0;
}

static inline const arithmetic_form *arithmetic_lookup(
    const arithmetic_parser *parser, const char *name, size_t length) {
    const arithmetic_form *const *vocabulary;
    for (vocabulary = parser->vocabularies; *vocabulary; ++vocabulary) {
        const arithmetic_form *form;
        for (form = *vocabulary; form->name; ++form)
            if (strlen(form->name) == length && strncmp(form->name, name, length) == 0)
                return form;
    }
    return NULL;
}

static inline int arithmetic_expression(arithmetic_parser *parser, unsigned depth, long long *out) {
    const char *token;
    if (depth >= ARITHMETIC_MAX_DEPTH)
        return arithmetic_error(parser, \"expression nesting limit exceeded\");
    arithmetic_skip(parser);
    if (*parser->next != '(') return arithmetic_error(parser, \"expected '('\");
    ++parser->next;
    const size_t length = arithmetic_token(parser, &token);
    if (!length) return arithmetic_error(parser, \"expected form name\");
    const arithmetic_form *form = arithmetic_lookup(parser, token, length);
    if (!form) return arithmetic_error(parser, \"unknown form\");

    long long values[2] = {0, 0};
    long long result;
    if (form->kind == ARITHMETIC_INTEGER) {
        const size_t size = arithmetic_token(parser, &token);
        if (!arithmetic_integer(token, size, &result))
            return arithmetic_error(parser, \"expected an integer between -1000000 and 1000000\");
    } else if (form->kind == ARITHMETIC_VARIABLE) {
        const size_t size = arithmetic_token(parser, &token);
        if (size != 1 || *token != 'x') return arithmetic_error(parser, \"unknown variable\");
        result = parser->x;
    } else {
        if (!form->apply || form->arity > sizeof values / sizeof values[0])
            return arithmetic_error(parser, \"invalid operation descriptor\");
        for (size_t i = 0; i < form->arity; ++i)
            if (!arithmetic_expression(parser, depth + 1, &values[i])) return 0;
        result = form->apply(values);
    }
    arithmetic_skip(parser);
    if (*parser->next != ')') return arithmetic_error(parser, \"expected ')'\");
    ++parser->next;
    if (!arithmetic_in_range(result)) return arithmetic_error(parser, \"arithmetic result out of range\");
    *out = result;
    return 1;
}

static inline size_t arithmetic_bounded_length(const char *text) {
    size_t length = 0;
    while (length <= ARITHMETIC_MAX_BYTES && text[length]) ++length;
    return length;
}

static inline int arithmetic_run(const char *program, long long x, long long *out,
                                 const char **error, const arithmetic_form *const *vocabularies) {
    arithmetic_parser parser = {program, x, NULL, vocabularies};
    long long result;
    if (!program || !out)
        arithmetic_error(&parser, \"program and result pointer are required\");
    else if (arithmetic_bounded_length(program) > ARITHMETIC_MAX_BYTES)
        arithmetic_error(&parser, \"program size limit exceeded\");
    else if (!arithmetic_in_range(x))
        arithmetic_error(&parser, \"x must be between -1000000 and 1000000\");
    else if (arithmetic_expression(&parser, 0, &result)) {
        arithmetic_skip(&parser);
        if (*parser.next) arithmetic_error(&parser, \"unexpected trailing input\");
        else *out = result;
    }
    if (error) *error = parser.error;
    return parser.error != NULL;
}
"))
