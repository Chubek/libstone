cmake_minimum_required(VERSION 3.20)

file(READ "${GENERATED_DIR}/legacy.c" legacy)
file(READ "${GENERATED_DIR}/liblr.c" liblr)
if(legacy MATCHES "static const struct GLRRegexDFAState")
  message(FATAL_ERROR "The default backend unexpectedly generated DFA tables")
endif()
if(NOT liblr MATCHES "glr_rx_skip_dfa_states" OR
   NOT liblr MATCHES "static const struct GLRRegexDFAState glr_rx_[0-9]+_dfa_states")
  message(FATAL_ERROR "The liblr backend did not generate DFA tables for skip and terminals")
endif()
foreach(assertion IN ITEMS BOL EOL WORDB)
  if(NOT liblr MATCHES "\\{ GLR_RX_${assertion},")
    message(FATAL_ERROR "The liblr backend did not retain NFA records for ${assertion}")
  endif()
endforeach()
