# QML: a small expression-oriented, strict, ML-style functional language.
#
# Generate a Python interpreter from the repository root:
#   perl cornerstone/LLSynth/scripts/llsynth.pl --check --mode=interpret -T python3 QML.llsynth
#   perl cornerstone/LLSynth/scripts/llsynth.pl --mode=interpret -T python3 -o qml.py QML.llsynth
#   printf 'let rec fact n = if n = 0 then 1 else n * fact(n - 1) in fact(5)\n' | python3 qml.py
# Expected output: 120
#
# Surface language: integers, booleans, let / let rec, fn, if/then/else,
# first-class lexical closures, f(x) application, arithmetic, comparisons,
# and short-circuit andalso/orelse. One expression forms a program.
# Values are tagged internally because LLSynth's semantic-action types are
# not a Hindley-Milner type system. QML currently checks types at runtime.

.language "QML"
.version "0.1"
.summary "A tiny, strict ML-style functional language"
.start Program

.skip /[ \t\r\n]+/
.skip /#[^\n]*/
.token INT: Int = /[0-9]+/
.token ID: String = /[A-Za-z_][A-Za-z0-9_]*/

.exception !Unbound(name: String) "Unbound variable {name}"
.exception !TypeError "Type error in QML expression"
.exception !DivisionByZero "Division by zero"

# Every source AST and runtime value is Vec<Any>, tagged at element 0.
# AST tags: int, bool, var, let, letrec, fn, if, app, and, or,
#           eq, lt, gt, add, sub, mul, div, neg, not.
# Value tags: int, bool, closure. A closure is
#             ["closure", parameter-name, body-AST, captured-environment].
# Environments are immutable, flat [name, value, name, value, ...] arrays.

.function box(x: Any) -> Any
return x;
.end

.function ast1(tag: String, x: Any) -> Vec<Any>
return [box(tag), x];
.end

.function ast2(tag: String, x: Any, y: Any) -> Vec<Any>
return [box(tag), x, y];
.end

.function ast3(tag: String, x: Any, y: Any, z: Any) -> Vec<Any>
return [box(tag), x, y, z];
.end

.function ast4(tag: String, a: Any, b: Any, c: Any, d: Any) -> Vec<Any>
return [box(tag), a, b, c, d];
.end

.function extend(env: Vec<Any>, name: String, value: Vec<Any>) -> Vec<Any>
let out: Vec<Any> = [];
for item in env {
    push(out, item);
}
push(out, box(name));
push(out, box(value));
return out;
.end

.function lookup(env: Vec<Any>, name: String) -> Vec<Any>
let index: Int = len(env) - 2;
while index >= 0 {
    if env[index] == name {
        return env[index + 1];
    }
    index = index - 2;
}
Throw(!Unbound, name);
.end

# Eager evaluation, with special cases for lazy conditional branches,
# short-circuit Boolean operators, and lexical closures.
.function evaluate(tree: Vec<Any>, env: Vec<Any>) -> Vec<Any>
let kind: String = tree[0];

if kind == "int" {
    return ast1("int", tree[1]);
}
if kind == "bool" {
    return ast1("bool", tree[1]);
}
if kind == "var" {
    return lookup(env, tree[1]);
}
if kind == "let" {
    let value: Vec<Any> = evaluate(tree[2], env);
    return evaluate(tree[3], extend(env, tree[1], value));
}
if kind == "fn" {
    return ast3("closure", tree[1], tree[2], env);
}
if kind == "letrec" {
    # Tie the recursive knot: the closure's captured environment contains
    # its own binding. Only the newly created closure is mutated.
    let closure: Vec<Any> = ast3("closure", tree[2], tree[3], []);
    let recursive_env: Vec<Any> = extend(env, tree[1], closure);
    closure[3] = recursive_env;
    return evaluate(tree[4], recursive_env);
}
if kind == "app" {
    let fn_value: Vec<Any> = evaluate(tree[1], env);
    require fn_value[0] == "closure" else Throw(!TypeError);
    let argument: Vec<Any> = evaluate(tree[2], env);
    return evaluate(fn_value[2], extend(fn_value[3], fn_value[1], argument));
}
if kind == "if" {
    let condition: Vec<Any> = evaluate(tree[1], env);
    require condition[0] == "bool" else Throw(!TypeError);
    if condition[1] {
        return evaluate(tree[2], env);
    } else {
        return evaluate(tree[3], env);
    }
}
if kind == "and" {
    let lhs: Vec<Any> = evaluate(tree[1], env);
    require lhs[0] == "bool" else Throw(!TypeError);
    if lhs[1] {
        let rhs: Vec<Any> = evaluate(tree[2], env);
        require rhs[0] == "bool" else Throw(!TypeError);
        return rhs;
    }
    return ast1("bool", false);
}
if kind == "or" {
    let lhs: Vec<Any> = evaluate(tree[1], env);
    require lhs[0] == "bool" else Throw(!TypeError);
    if lhs[1] {
        return ast1("bool", true);
    }
    let rhs: Vec<Any> = evaluate(tree[2], env);
    require rhs[0] == "bool" else Throw(!TypeError);
    return rhs;
}
if kind == "neg" {
    let value: Vec<Any> = evaluate(tree[1], env);
    require value[0] == "int" else Throw(!TypeError);
    return ast1("int", -value[1]);
}
if kind == "not" {
    let value: Vec<Any> = evaluate(tree[1], env);
    require value[0] == "bool" else Throw(!TypeError);
    return ast1("bool", !value[1]);
}

# Binary operators evaluate left operand before right operand.
let lhs: Vec<Any> = evaluate(tree[1], env);
let rhs: Vec<Any> = evaluate(tree[2], env);
if kind == "eq" {
    require lhs[0] == rhs[0] else Throw(!TypeError);
    require lhs[0] != "closure" else Throw(!TypeError);
    return ast1("bool", lhs[1] == rhs[1]);
}
require lhs[0] == "int" && rhs[0] == "int" else Throw(!TypeError);
if kind == "lt" { return ast1("bool", lhs[1] < rhs[1]); }
if kind == "gt" { return ast1("bool", lhs[1] > rhs[1]); }
if kind == "add" { return ast1("int", lhs[1] + rhs[1]); }
if kind == "sub" { return ast1("int", lhs[1] - rhs[1]); }
if kind == "mul" { return ast1("int", lhs[1] * rhs[1]); }
if kind == "div" {
    require rhs[1] != 0 else Throw(!DivisionByZero);
    return ast1("int", lhs[1] / rhs[1]);
}
Throw(!TypeError);
.end

# Render only the outermost value; nested values stay tagged.
.function display(value: Vec<Any>) -> Any
if value[0] == "int" { return value[1]; }
if value[0] == "bool" { return value[1]; }
return "<fn>";
.end

.rule Program
'syntax: expression:Expr EOF
'semantics: return display(evaluate($expression, []));
..

# ML's let, let rec, fn and if bind more weakly than binary operators.
.rule Expr
'syntax: regularLet:LetExpr | recursiveLet:LetRecExpr | lambda:LambdaExpr | conditional:IfExpr | ordinary:OrExpr
'semantics:
on regularLet -> return $regularLet; -> end
on recursiveLet -> return $recursiveLet; -> end
on lambda -> return $lambda; -> end
on conditional -> return $conditional; -> end
on ordinary -> return $ordinary; -> end
..

.rule LetExpr
'syntax: "let" name:ID "=" definition:Expr "in" body:Expr
'semantics: return ast3("let", $name, $definition, $body);
..

.rule LetRecExpr
'syntax: "let" "rec" name:ID parameter:ID "=" definition:Expr "in" body:Expr
'semantics: return ast4("letrec", $name, $parameter, $definition, $body);
..

.rule LambdaExpr
'syntax: "fn" parameter:ID "=>" body:Expr
'semantics: return ast2("fn", $parameter, $body);
..

.rule IfExpr
'syntax: "if" condition:Expr "then" yes:Expr "else" no:Expr
'semantics: return ast3("if", $condition, $yes, $no);
..

.rule OrExpr
'syntax: lhs:OrExpr "orelse" rhs:AndExpr | alone:AndExpr
'semantics:
on lhs -> return ast2("or", $lhs, $rhs); -> end
on alone -> return $alone; -> end
..

.rule AndExpr
'syntax: lhs:AndExpr "andalso" rhs:CompareExpr | alone:CompareExpr
'semantics:
on lhs -> return ast2("and", $lhs, $rhs); -> end
on alone -> return $alone; -> end
..

.rule CompareExpr
'syntax: eqLeft:AddExpr "=" eqRight:AddExpr | ltLeft:AddExpr "<" ltRight:AddExpr | gtLeft:AddExpr ">" gtRight:AddExpr | alone:AddExpr
'semantics:
on eqLeft -> return ast2("eq", $eqLeft, $eqRight); -> end
on ltLeft -> return ast2("lt", $ltLeft, $ltRight); -> end
on gtLeft -> return ast2("gt", $gtLeft, $gtRight); -> end
on alone -> return $alone; -> end
..

.rule AddExpr
'syntax: addLeft:AddExpr "+" addRight:MulExpr | subLeft:AddExpr "-" subRight:MulExpr | alone:MulExpr
'semantics:
on addLeft -> return ast2("add", $addLeft, $addRight); -> end
on subLeft -> return ast2("sub", $subLeft, $subRight); -> end
on alone -> return $alone; -> end
..

.rule MulExpr
'syntax: mulLeft:MulExpr "*" mulRight:UnaryExpr | divLeft:MulExpr "/" divRight:UnaryExpr | alone:UnaryExpr
'semantics:
on mulLeft -> return ast2("mul", $mulLeft, $mulRight); -> end
on divLeft -> return ast2("div", $divLeft, $divRight); -> end
on alone -> return $alone; -> end
..

.rule UnaryExpr
'syntax: negative:"~" operand:UnaryExpr | inverted:"not" operand:UnaryExpr | alone:ApplyExpr
'semantics:
on negative -> return ast1("neg", $operand); -> end
on inverted -> return ast1("not", $operand); -> end
on alone -> return $alone; -> end
..

.rule ApplyExpr
'syntax: function:ApplyExpr "(" argument:Expr ")" | alone:Atom
'semantics:
on function -> return ast2("app", $function, $argument); -> end
on alone -> return $alone; -> end
..

.rule Atom
'syntax: number:INT | truth:"true" | falsity:"false" | identifier:ID | "(" grouped:Expr ")"
'semantics:
on number -> return ast1("int", $number); -> end
on truth -> return ast1("bool", true); -> end
on falsity -> return ast1("bool", false); -> end
on identifier -> return ast1("var", $identifier); -> end
on grouped -> return $grouped; -> end
..
