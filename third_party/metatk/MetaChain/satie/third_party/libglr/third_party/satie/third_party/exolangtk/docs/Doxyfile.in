PROJECT_NAME           = "@DOXYGEN_PROJECT_NAME@"
PROJECT_NUMBER         = "@DOXYGEN_PROJECT_NUMBER@"
PROJECT_BRIEF          = "@DOXYGEN_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIRECTORY@"
INPUT                  = "@DOXYGEN_INPUT@" "@CMAKE_CURRENT_SOURCE_DIR@/FrontPage.md" "@CMAKE_CURRENT_SOURCE_DIR@/manual"
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
SOURCE_BROWSER         = YES
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/FrontPage.md"
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = ITK_DEF=static FFI_DEF=static DTK_DEF=static ETK_DEF=static
