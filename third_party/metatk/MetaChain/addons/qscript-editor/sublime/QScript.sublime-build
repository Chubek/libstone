{
    "cmd": ["qscript", "run", "$file"],
    "selector": "source.qscript",
    "file_regex": "^(.+?):(\\d+):(\\d+): (.*)$",
    "working_dir": "$file_path",
    "variants": [
        {"name": "Check", "cmd": ["qscript", "check", "$file"]},
        {"name": "JIT", "cmd": ["qscript", "--jit", "run", "$file"]},
        {"name": "MetaIL", "cmd": ["qscript", "ir", "$file"]},
        {"name": "Build executable", "cmd": ["qscript", "build", "$file", "-o", "$file_base_name"]}
    ]
}
