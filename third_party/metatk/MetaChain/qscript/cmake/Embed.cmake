# Generates a C++ source embedding the QScript grammar and standard library.
# Invoked at build time: cmake -DGRAMMAR=... -DSTDLIB="a.qs;b.qs" -DOUTPUT=... -P Embed.cmake
cmake_minimum_required(VERSION 3.20)

function(qscript_literal out_var text)
    # Adjacent raw-string chunks keep every literal piece small for all compilers.
    set(result "")
    string(LENGTH "${text}" remaining)
    set(offset 0)
    if(remaining EQUAL 0)
        set(result "\"\"")
    endif()
    while(remaining GREATER 0)
        if(remaining GREATER 4000)
            set(take 4000)
        else()
            set(take ${remaining})
        endif()
        string(SUBSTRING "${text}" ${offset} ${take} piece)
        string(APPEND result "R\"QSEMBED(${piece})QSEMBED\"\n")
        math(EXPR offset "${offset} + ${take}")
        math(EXPR remaining "${remaining} - ${take}")
    endwhile()
    set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

string(REPLACE "|" ";" STDLIB "${STDLIB}")
file(READ "${GRAMMAR}" grammar_text)
qscript_literal(grammar_literal "${grammar_text}")
set(body "// Generated by qscript/cmake/Embed.cmake. Do not edit.\n#include \"qscript/src/Internal.h\"\nnamespace qscript::detail {\nstatic const char grammar_text[] =\n${grammar_literal};\nconst char* embedded_grammar() { return grammar_text; }\n")
set(table "")
set(count 0)
list(SORT STDLIB)
foreach(path IN LISTS STDLIB)
    get_filename_component(name "${path}" NAME_WE)
    file(READ "${path}" source)
    qscript_literal(literal "${source}")
    string(APPEND body "static const char lib_${count}[] =\n${literal};\n")
    string(APPEND table "    {\"${name}\", lib_${count}},\n")
    math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
    string(APPEND body "static const EmbeddedLibrary libraries[] = {{nullptr, nullptr}};\nconst EmbeddedLibrary* embedded_libraries(std::size_t* n) { if (n) *n = 0; return libraries; }\n")
else()
    string(APPEND body "static const EmbeddedLibrary libraries[] = {\n${table}};\nconst EmbeddedLibrary* embedded_libraries(std::size_t* n) { if (n) *n = ${count}; return libraries; }\n")
endif()
string(APPEND body "} // namespace qscript::detail\n")
# Only touch the output when it changes, to avoid needless rebuilds.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${body}")
