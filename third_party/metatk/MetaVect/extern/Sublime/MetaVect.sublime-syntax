%YAML 1.2
---
name: MetaVect
file_extensions: [mv, mvec, mvct]
scope: source.metavect
# Best-effort mirror of frontend/Lexer.d; the compiler lexer is authoritative.
# Rule order matters: comments, then strings, then invalid numbers, then valid
# numbers, then keywords/booleans/types, then identifiers, then operators.
contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - match: '\b(let|in|fun|fn|type|forall|if|then|else|match|with|module|import|export)\b'
      scope: keyword.control.metavect
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.metavect
    - match: '\b(Int|Float|Bool|String|Unit|Path|Color|Vector|Matrix)\b'
      scope: storage.type.metavect
    - match: '\b[A-Za-z_][A-Za-z0-9_]*\b'
      scope: variable.other.metavect
    - match: '->|=>|::|==|!=|<=|>=|&&|\|\|'
      scope: keyword.operator.metavect
    - match: '[+\-*/=<>!|&:.]'
      scope: keyword.operator.metavect
    - match: '[()\[\]{},;]'
      scope: punctuation.separator.metavect
  comments:
    - match: '--.*$'
      scope: comment.line.double-dash.metavect
    - match: '\{-'
      push: block-comment
  block-comment:
    - meta_scope: comment.block.metavect
    - match: '\{-'
      push: block-comment
    - match: '-\}'
      pop: true
  strings:
    - match: '"'
      push: string-body
  string-body:
    - meta_scope: string.quoted.double.metavect
    - match: '\\[nrt"\\]'
      scope: constant.character.escape.metavect
    - match: '\\.'
      scope: invalid.illegal.escape.metavect
    - match: '"'
      pop: true
    - match: '$'
      pop: true
  numbers:
    # Sublime tries rules in order at each position, so valid forms come
    # first: a valid float/integer must win over the invalid prefix rules.
    # The invalid rules then catch what the lexer rejects (`12abc`, `1e`,
    # `1.0E-`) instead of splitting it into number plus trailing text.
    - match: '\b[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?\b|\b[0-9]+[eE][+-]?[0-9]+\b'
      scope: constant.numeric.float.metavect
    - match: '\b[0-9]+\b'
      scope: constant.numeric.integer.metavect
    - match: '\b[0-9]+[A-Za-z_][A-Za-z0-9_]*\b'
      scope: invalid.illegal.number.metavect
    - match: '\b[0-9]+(\.[0-9]+)?[eE][+-]?\b'
      scope: invalid.illegal.number.metavect
