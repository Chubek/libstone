function(check_cli expected_code expected_output)
  execute_process(COMMAND "${MVECT}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "mvect ${ARGN}: expected exit ${expected_code}, got ${code}: ${output}${error}")
  endif()
  if(NOT "${output}${error}" MATCHES "${expected_output}")
    message(FATAL_ERROR "mvect ${ARGN}: unexpected output: ${output}${error}")
  endif()
endfunction()

check_cli(0 "mvect 0\\.1\\.0" --version)
check_cli(0 "Checks syntax only" --help)
check_cli(0 "^$" --check-syntax "${SOURCE_DIR}/examples/first.mvct")
check_cli(0 "^$" --check-syntax -- "${SOURCE_DIR}/stdlib/prelude/prelude.mvct")
check_cli(1 "invalid.mvct:2:1: error: expected expression, found end of file"
  --check-syntax "${SOURCE_DIR}/tests/fixtures/invalid.mvct")
check_cli(1 "cannot read input:" --check-syntax "${SOURCE_DIR}/tests/fixtures/does-not-exist.mvct")
string(ASCII 255 invalid_byte)
set(invalid_utf8 "${CMAKE_CURRENT_BINARY_DIR}/invalid-utf8.mvct")
file(WRITE "${invalid_utf8}" "x = \"${invalid_byte}\"")
check_cli(1 "invalid-utf8.mvct:1:6: error: invalid UTF-8 encoding" --check-syntax "${invalid_utf8}")
check_cli(2 "missing input file" --check-syntax)
check_cli(2 "missing input file")
check_cli(2 "unknown option" --unknown)
check_cli(2 "expected exactly one input file" --check-syntax one.mvct two.mvct)
check_cli(3 "not yet implemented" "${SOURCE_DIR}/examples/first.mvct")
