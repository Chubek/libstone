-- WebAssembly Core i32 profile. This is lowered symbolic tape, NOT .wasm bytes.
-- Structured blocks are lowered to instruction-index labels by the producer.
-- One fixed 64KiB page, 16 locals, 16 mutable globals, calls of arity 0/1.
-- No validation/type checker, memory.grow, tables, floats, SIMD or imports.
local v = require("vmweave")
local vm = v.vm {
  name = "WASM", execution = "switch", stack = { cell = "int64_t", capacity = 256 },
  frame_capacity = 64,
  components = { "token", "opcode", "insncode", "dispatch", "tape", "compile", "frame" },
  fields = { { name = "memory", type = "u8", count = 65536 },
    { name = "locals", type = "i64", count = 1040 },
    { name = "globals", type = "i64", count = 16 },
    { name = "depth", type = "u64" }, { name = "out", type = "i64" } },
  subsystems = { token = [[
static int64_t WASM_vw_i32(uint32_t x) {
  return x <= INT32_MAX ? (int64_t)x : -1 - (int64_t)(UINT32_MAX - x);
}
]] },
  instructions = {
    { name = "I32_CONST", operands = { "cell" }, stack_effect = "( -- i )",
      semantics = "vm_push(WASM_vw_i32((uint32_t)operand0));" },
    { name = "LOCAL_GET", operands = { "cell" }, stack_effect = "( -- i )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm_push(vm->locals[vm->depth * 16u + (size_t)operand0]);]] },
    { name = "LOCAL_SET", operands = { "cell" }, stack_effect = "( i -- )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm->locals[vm->depth * 16u + (size_t)operand0] = vm_pop();]] },
    { name = "LOCAL_TEE", operands = { "cell" }, stack_effect = "( i -- i )", semantics = [[
cell value;
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
value = vm_pop(); vm->locals[vm->depth * 16u + (size_t)operand0] = value; vm_push(value);]] },
    { name = "GLOBAL_GET", operands = { "cell" }, stack_effect = "( -- i )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm_push(vm->globals[(size_t)operand0]);]] },
    { name = "GLOBAL_SET", operands = { "cell" }, stack_effect = "( i -- )", semantics = [[
if(operand0 < 0 || operand0 >= 16) { vm_fail(-4); return; }
vm->globals[(size_t)operand0] = vm_pop();]] },
    { name = "DROP", stack_effect = "( i -- )", semantics = "(void)vm_pop();" },
    { name = "SELECT", stack_effect = "( a b cond -- i )",
      semantics = "cell cond = vm_pop(), b = vm_pop(), a = vm_pop(); vm_push(cond ? a : b);" },
    { name = "I32_EQZ", stack_effect = "( i -- flag )", semantics = "vm_push(vm_pop() == 0);" },
    { name = "I32_DIV_S", stack_effect = "( a b -- c )", semantics = [[
cell b = WASM_vw_i32((uint32_t)vm_pop()), a = WASM_vw_i32((uint32_t)vm_pop());
if(!b || (a == INT32_MIN && b == -1)) { vm_fail(-10); return; }
vm_push(a / b);]] },
    { name = "I32_REM_S", stack_effect = "( a b -- c )", semantics = [[
cell b = WASM_vw_i32((uint32_t)vm_pop()), a = WASM_vw_i32((uint32_t)vm_pop());
if(!b) { vm_fail(-10); return; }
vm_push(a % b);]] },
    { name = "I32_LOAD", operands = { "cell" }, stack_effect = "( addr -- i )", semantics = [[
uint64_t addr = (uint32_t)vm_pop(); uint32_t value; size_t i;
if(operand0 < 0 || (uint64_t)operand0 > 65532u || addr > 65532u - (uint64_t)operand0) { vm_fail(-4); return; }
addr += (uint64_t)operand0; value = 0;
for(i = 0; i < 4u; ++i) value |= (uint32_t)vm->memory[addr + i] << (8u * i);
vm_push(WASM_vw_i32(value));]] },
    { name = "I32_STORE", operands = { "cell" }, stack_effect = "( addr i -- )", semantics = [[
uint32_t value = (uint32_t)vm_pop(); uint64_t addr = (uint32_t)vm_pop(); size_t i;
if(operand0 < 0 || (uint64_t)operand0 > 65532u || addr > 65532u - (uint64_t)operand0) { vm_fail(-4); return; }
addr += (uint64_t)operand0;
for(i = 0; i < 4u; ++i) vm->memory[addr + i] = (uint8_t)(value >> (8u * i));]] },
    { name = "MEMORY_SIZE", stack_effect = "( -- pages )", semantics = "vm_push(1);" },
    { name = "BR", operands = { "label" }, flow = "jump", semantics = "vm_jump(operand0);" },
    { name = "BR_IF", operands = { "label" }, flow = "branch", stack_effect = "( cond -- )",
      semantics = "if(vm_pop()) vm_jump(operand0);" },
    { name = "CALL0", operands = { "label" }, flow = "call", semantics = [[
if(vm->depth >= 64u) { vm_fail(-3); return; }
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->locals[vm->depth * 16u], 0, 16u * sizeof(int64_t));]] },
    { name = "CALL1", operands = { "label" }, flow = "call", stack_effect = "( a -- )", semantics = [[
cell a = vm_pop();
if(vm->depth >= 64u) { vm_fail(-3); return; }
if(vm_call(operand0)) return;
++vm->depth; memset(&vm->locals[vm->depth * 16u], 0, 16u * sizeof(int64_t));
vm->locals[vm->depth * 16u] = a;]] },
    { name = "RETURN", flow = "return", stack_effect = "( i -- i )", semantics = [[
cell result;
if(!vm->depth || !vm->vw_frame_count) { vm_fail(-2); return; }
result = vm_pop(); --vm->depth; (void)vm_return(); vm_push(result);]] },
    { name = "UNREACHABLE", flow = "halt", semantics = "vm_fail(-10);" },
    { name = "PRINT", stack_effect = "( i -- )", semantics = "vm->out = vm_pop();" },
    { name = "HALT", flow = "halt", semantics = "vm_halt();" },
  },
}
for _, op in ipairs { { "I32_ADD", "+" }, { "I32_SUB", "-" }, { "I32_MUL", "*" },
    { "I32_AND", "&" }, { "I32_OR", "|" }, { "I32_XOR", "^" } } do
  vm:instruction(op[1], { stack_effect = "( a b -- c )", semantics =
    "uint32_t b = (uint32_t)vm_pop(), a = (uint32_t)vm_pop(); vm_push(WASM_vw_i32(a " .. op[2] .. " b));" })
end
for _, op in ipairs { { "I32_EQ", "==" }, { "I32_LT_S", "<" }, { "I32_GT_S", ">" } } do
  vm:instruction(op[1], { stack_effect = "( a b -- flag )", semantics =
    "cell b = vm_pop(), a = vm_pop(); vm_push(a " .. op[2] .. " b ? 1 : 0);" })
end
return vm
