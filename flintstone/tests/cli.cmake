function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}\n")
    message(FATAL_ERROR "CLI failed: ${status}; output=${output}; error=${error}")
  endif()
endfunction()
run(42 --run affine --arg 10 "${SOURCE}/examples/affine.flint")
run(42 --lower machine --run affine --arg 10 "${SOURCE}/examples/affine.flint")
run(45 --run sum --arg 10 "${SOURCE}/examples/sum.flint")
run(36 --scalarize --run dot --arg 6 "${SOURCE}/examples/vector.flint")
run(42 --scalarize --run swap_add --arg 20 --arg 22 "${SOURCE}/examples/tuple.flint")
run(42 --run guarded --arg 0 "${SOURCE}/examples/trap.flint")
run(17 --run compute --arg 42 --arg 56 "${SOURCE}/examples/stdlib_demo.flint")
run(17 -I "${SOURCE}/stdlib" --run compute --arg 42 --arg 56 "${SOURCE}/examples/stdlib_demo.flint")
execute_process(COMMAND "${CLI}" --list-dialects RESULT_VARIABLE status OUTPUT_VARIABLE dialects)
if(NOT status EQUAL 0 OR NOT dialects MATCHES "vector" OR NOT dialects MATCHES "tuple"
    OR NOT dialects MATCHES "ptr" OR NOT dialects MATCHES "atomic")
  message(FATAL_ERROR "CLI dialect listing is incomplete: ${dialects}")
endif()
execute_process(COMMAND "${CLI}" --list-targets RESULT_VARIABLE status OUTPUT_VARIABLE targets)
if(NOT status EQUAL 0 OR NOT targets MATCHES "x86-64-tiny" OR NOT targets MATCHES "aarch64-tiny"
    OR NOT targets MATCHES "riscv64-tiny" OR NOT targets MATCHES "arch:riscv64")
  message(FATAL_ERROR "CLI target listing is incomplete: ${targets}")
endif()
foreach(tiny IN ITEMS x86-64-tiny aarch64-tiny riscv64-tiny)
  execute_process(COMMAND "${CLI}" --target ${tiny} --backend ${tiny} --emit "${BINARY}/${tiny}.bin"
    "${SOURCE}/examples/sum.flint" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status EQUAL 0)
    message(FATAL_ERROR "tiny backend unexpectedly accepted a loop: ${tiny}")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --check "${SOURCE}/examples/sum.flint" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "CLI check failed")
endif()
foreach(backend IN ITEMS vm vm-stack)
  execute_process(COMMAND "${CLI}" --emit "${BINARY}/${backend}.fsvm" --backend ${backend}
    "${SOURCE}/examples/affine.flint" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "CLI emission failed: ${error}")
  endif()
  file(READ "${BINARY}/${backend}.fsvm" magic LIMIT 4 HEX)
  if(NOT magic STREQUAL "4653564d")
    message(FATAL_ERROR "incorrect FSVM magic")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --run sum --arg 1000 --budget 2 "${SOURCE}/examples/sum.flint"
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "budget")
  message(FATAL_ERROR "CLI failed to diagnose execution budget")
endif()
execute_process(COMMAND "${CLI}" --run RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "CLI argument error must return 2")
endif()
