@PACKAGE_INIT@
set(_flintstone_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Firestone 0.1 CONFIG COMPONENTS ir vm isel isched regalloc)
# Sandstone currently installs its archive and headers without a package file.
# Resolve it from this installation, not a hard-coded source-tree pathname.
if(NOT TARGET Flintstone::sandstone)
  find_dependency(ZLIB)
  find_dependency(Threads)
  find_library(_flintstone_sandstone NAMES sandstone
    PATHS "${_flintstone_prefix}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH REQUIRED)
  add_library(Flintstone::sandstone UNKNOWN IMPORTED)
  set_target_properties(Flintstone::sandstone PROPERTIES
    IMPORTED_LOCATION "${_flintstone_sandstone}"
    INTERFACE_INCLUDE_DIRECTORIES "${_flintstone_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES "ZLIB::ZLIB;Threads::Threads"
    INTERFACE_COMPILE_FEATURES cxx_std_20)
  if(@FLINTSTONE_HAS_ZSTD@)
    find_library(_flintstone_zstd NAMES zstd REQUIRED)
    set_property(TARGET Flintstone::sandstone APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${_flintstone_zstd}")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FlintstoneTargets.cmake")
set(Flintstone_core_FOUND TRUE)
set(Flintstone_native_FOUND TRUE)
set(Flintstone_codegen_FOUND TRUE)
set(_flintstone_available "@FLINTSTONE_SDK_COMPONENTS@")
set(_flintstone_selected ${Flintstone_FIND_COMPONENTS})
set(_flintstone_load_sdk FALSE)
if(NOT _flintstone_selected OR "sdk" IN_LIST _flintstone_selected)
  set(_flintstone_load_sdk TRUE)
  set(_flintstone_selected ${_flintstone_available})
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/FlintstoneSDKTargets.cmake")
  if("blackstone" IN_LIST _flintstone_selected AND "blackstone" IN_LIST _flintstone_available)
    find_dependency(Blackstone CONFIG)
  endif()
  if("tourchstone" IN_LIST _flintstone_selected AND "tourchstone" IN_LIST _flintstone_available)
    find_dependency(XBind CONFIG)
    if(@FLINTSTONE_SDK_TOURCHSTONE_NATIVE@)
      find_dependency(Tourchstone CONFIG)
    endif()
  endif()
  if("assembly" IN_LIST _flintstone_selected AND "assembly" IN_LIST _flintstone_available)
    find_dependency(Sandstone CONFIG)
  endif()
  if("limestone" IN_LIST _flintstone_selected AND "limestone" IN_LIST _flintstone_available)
    find_dependency(Limestone CONFIG)
  endif()
  if("yellowstone" IN_LIST _flintstone_selected AND "yellowstone" IN_LIST _flintstone_available)
    find_dependency(Yellowstone CONFIG)
    find_dependency(ArchBFD CONFIG)
  endif()
  if("novostone" IN_LIST _flintstone_selected AND "novostone" IN_LIST _flintstone_available)
    find_dependency(Novostone CONFIG)
  endif()
  if("moonstone" IN_LIST _flintstone_selected AND "moonstone" IN_LIST _flintstone_available)
    find_dependency(Moonstone CONFIG)
  endif()
  if("wetstone" IN_LIST _flintstone_selected AND "wetstone" IN_LIST _flintstone_available)
    include("${CMAKE_CURRENT_LIST_DIR}/../Wetstone/WetstoneTargets.cmake")
  endif()
  if("weighstone" IN_LIST _flintstone_selected AND "weighstone" IN_LIST _flintstone_available)
    find_dependency(Weighstone CONFIG)
  endif()
  foreach(_flintstone_component IN LISTS _flintstone_selected)
    if(_flintstone_component IN_LIST _flintstone_available)
      include("${CMAKE_CURRENT_LIST_DIR}/Flintstone-${_flintstone_component}Targets.cmake")
      set(Flintstone_${_flintstone_component}_FOUND TRUE)
    endif()
  endforeach()
  if(_flintstone_load_sdk)
    include("${CMAKE_CURRENT_LIST_DIR}/FlintstoneSDKTargets.cmake")
    set(Flintstone_sdk_FOUND TRUE)
  endif()
endif()
check_required_components(Flintstone)
