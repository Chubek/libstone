@PACKAGE_INIT@
set(_flintstone_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Firestone 0.1 CONFIG)
# Sandstone currently installs its archive and headers without a package file.
# Resolve it from this installation, not a hard-coded source-tree pathname.
if(NOT TARGET Flintstone::sandstone)
  find_dependency(ZLIB)
  find_dependency(Threads)
  find_library(_flintstone_sandstone NAMES sandstone
    PATHS "${_flintstone_prefix}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH REQUIRED)
  add_library(Flintstone::sandstone UNKNOWN IMPORTED)
  set_target_properties(Flintstone::sandstone PROPERTIES
    IMPORTED_LOCATION "${_flintstone_sandstone}"
    INTERFACE_INCLUDE_DIRECTORIES "${_flintstone_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES "ZLIB::ZLIB;Threads::Threads"
    INTERFACE_COMPILE_FEATURES cxx_std_20)
  if(@FLINTSTONE_HAS_ZSTD@)
    find_library(_flintstone_zstd NAMES zstd REQUIRED)
    set_property(TARGET Flintstone::sandstone APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${_flintstone_zstd}")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FlintstoneTargets.cmake")
set(Flintstone_core_FOUND TRUE)
set(Flintstone_native_FOUND TRUE)
check_required_components(Flintstone)
