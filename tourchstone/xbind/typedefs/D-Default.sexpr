(xbind-typedefs
  (target "D")
  (version "0.1.0")
  (description "Default C-to-D type map loaded before user overrides.")
  (map (c "void") (native "void") (direction "return"))
  (map (c "bool") (native "bool"))
  (map (c "_Bool") (native "bool"))
  (map (c "int") (native "int"))
  (map (c "unsigned int") (native "uint"))
  (map (c "size_t") (native "size_t"))
  (map (c "float") (native "float"))
  (map (c "double") (native "double"))
  (map (c "const char *") (native "string") (ownership "borrowed"))
  (map (c "char *") (native "string") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "ubyte[]") (ownership "borrowed"))
  (map (c "void *") (native "void*") (ownership "opaque"))
)
