(xbind-typedefs
  (target "Ruby")
  (version "0.1.0")
  (description "Default C-to-Ruby type map loaded before user overrides.")
  (map (c "void") (native "nil") (direction "return"))
  (map (c "bool") (native "true_or_false"))
  (map (c "_Bool") (native "true_or_false"))
  (map (c "int") (native "Integer"))
  (map (c "unsigned int") (native "Integer"))
  (map (c "size_t") (native "Integer"))
  (map (c "float") (native "Float"))
  (map (c "double") (native "Float"))
  (map (c "const char *") (native "String") (ownership "borrowed"))
  (map (c "char *") (native "String") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "String") (encoding "binary"))
  (map (c "void *") (native "Data") (ownership "opaque"))
)
