(xbind-typedefs
  (target "Python")
  (version "0.1.0")
  (description "Default C-to-Python type map loaded before user overrides.")
  (map (c "void") (native "None") (direction "return"))
  (map (c "bool") (native "bool"))
  (map (c "_Bool") (native "bool"))
  (map (c "int") (native "int"))
  (map (c "unsigned int") (native "int"))
  (map (c "size_t") (native "int"))
  (map (c "float") (native "float"))
  (map (c "double") (native "float"))
  (map (c "const char *") (native "str") (ownership "borrowed"))
  (map (c "char *") (native "str") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "bytes") (ownership "borrowed"))
  (map (c "void *") (native "capsule") (ownership "opaque"))
)
