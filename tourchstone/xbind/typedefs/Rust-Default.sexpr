(xbind-typedefs
  (target "Rust")
  (version "0.1.0")
  (description "Default C-to-Rust type map loaded before user overrides.")
  (map (c "void") (native "()") (direction "return"))
  (map (c "bool") (native "bool"))
  (map (c "_Bool") (native "bool"))
  (map (c "int") (native "i32"))
  (map (c "unsigned int") (native "u32"))
  (map (c "size_t") (native "usize"))
  (map (c "float") (native "f32"))
  (map (c "double") (native "f64"))
  (map (c "const char *") (native "&str") (ownership "borrowed"))
  (map (c "char *") (native "String") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "&[u8]") (ownership "borrowed"))
  (map (c "void *") (native "*mut core::ffi::c_void") (ownership "opaque"))
)
