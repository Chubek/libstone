(xbind-typedefs
  (target "OCaml")
  (version "0.1.0")
  (description "Default C-to-OCaml type map loaded before user overrides.")
  (map (c "void") (native "unit") (direction "return"))
  (map (c "bool") (native "bool"))
  (map (c "_Bool") (native "bool"))
  (map (c "int") (native "int"))
  (map (c "unsigned int") (native "int64") (range "uint32"))
  (map (c "size_t") (native "nativeint") (range "size_t"))
  (map (c "float") (native "float"))
  (map (c "double") (native "float"))
  (map (c "const char *") (native "string") (ownership "borrowed"))
  (map (c "char *") (native "string") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "bytes") (ownership "borrowed"))
  (map (c "void *") (native "nativeint") (ownership "opaque"))
)
