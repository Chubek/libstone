(xbind-typedefs
  (target "Java")
  (version "0.1.0")
  (description "Default C-to-Java type map loaded before user overrides.")
  (map (c "void") (native "void") (direction "return"))
  (map (c "bool") (native "boolean"))
  (map (c "_Bool") (native "boolean"))
  (map (c "int") (native "int"))
  (map (c "unsigned int") (native "long") (range "uint32"))
  (map (c "size_t") (native "long") (range "size_t"))
  (map (c "float") (native "float"))
  (map (c "double") (native "double"))
  (map (c "const char *") (native "String") (ownership "borrowed"))
  (map (c "char *") (native "String") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "byte[]") (ownership "borrowed"))
  (map (c "void *") (native "long") (ownership "opaque"))
)
