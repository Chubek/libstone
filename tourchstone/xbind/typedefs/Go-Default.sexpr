(xbind-typedefs
  (target "Go")
  (version "0.1.0")
  (description "Default C-to-Go type map loaded before user overrides.")
  (map (c "void") (native "void") (direction "return"))
  (map (c "bool") (native "bool"))
  (map (c "_Bool") (native "bool"))
  (map (c "int") (native "int32"))
  (map (c "unsigned int") (native "uint32"))
  (map (c "size_t") (native "uint"))
  (map (c "float") (native "float32"))
  (map (c "double") (native "float64"))
  (map (c "const char *") (native "string") (ownership "borrowed"))
  (map (c "char *") (native "string") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "[]byte") (ownership "borrowed"))
  (map (c "void *") (native "unsafe.Pointer") (ownership "opaque"))
)
