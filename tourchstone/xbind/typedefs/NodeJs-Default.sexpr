(xbind-typedefs
  (target "NodeJS")
  (version "0.1.0")
  (description "Default C-to-NodeJS type map loaded before user overrides.")
  (map (c "void") (native "undefined") (direction "return"))
  (map (c "bool") (native "boolean"))
  (map (c "_Bool") (native "boolean"))
  (map (c "int") (native "number"))
  (map (c "unsigned int") (native "number"))
  (map (c "size_t") (native "bigint") (range "size_t"))
  (map (c "float") (native "number"))
  (map (c "double") (native "number"))
  (map (c "const char *") (native "string") (ownership "borrowed"))
  (map (c "char *") (native "string") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "Buffer") (ownership "borrowed"))
  (map (c "void *") (native "External") (ownership "opaque"))
)
