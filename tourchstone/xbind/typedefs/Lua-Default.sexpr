(xbind-typedefs
  (target "Lua")
  (version "0.1.0")
  (description "Default C-to-Lua type map loaded before user overrides.")
  (map (c "void") (native "nil") (direction "return"))
  (map (c "bool") (native "boolean"))
  (map (c "_Bool") (native "boolean"))
  (map (c "int") (native "integer"))
  (map (c "unsigned int") (native "integer"))
  (map (c "size_t") (native "integer"))
  (map (c "float") (native "number"))
  (map (c "double") (native "number"))
  (map (c "const char *") (native "string") (ownership "borrowed"))
  (map (c "char *") (native "string") (ownership "borrowed"))
  (map (c "const unsigned char *") (native "string") (encoding "bytes"))
  (map (c "void *") (native "lightuserdata") (ownership "opaque"))
)
