set(prefix "${FIRESTONE_BINARY}/install-test/prefix")
set(config_args)
set(ctest_config_args)
if(FIRESTONE_CONFIG)
  list(APPEND config_args --config "${FIRESTONE_CONFIG}")
  list(APPEND ctest_config_args -C "${FIRESTONE_CONFIG}")
endif()
set(consumer "${FIRESTONE_BINARY}/install-test/consumer")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${FIRESTONE_BINARY}" --prefix "${prefix}"
  ${config_args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installation failed")
endif()
# Move the prefix to exercise relocation of imported target include paths.
set(relocated "${FIRESTONE_BINARY}/install-test/relocated")
file(REMOVE_RECURSE "${relocated}")
file(RENAME "${prefix}" "${relocated}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIRESTONE_SOURCE}/tests/consumer"
  -B "${consumer}" "-DCMAKE_PREFIX_PATH=${relocated}" "-DCMAKE_CXX_COMPILER=${FIRESTONE_CXX_COMPILER}"
  "-DCMAKE_BUILD_TYPE=${FIRESTONE_CONFIG}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone consumer configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}" ${config_args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone consumer build failed")
endif()
execute_process(COMMAND "${FIRESTONE_CTEST_COMMAND}" --test-dir "${consumer}" ${ctest_config_args}
  --no-tests=error --output-on-failure RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installed consumer tests failed")
endif()
